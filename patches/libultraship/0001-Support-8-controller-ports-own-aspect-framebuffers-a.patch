+std::vector<Ship::WindowRect> GfxWindowBackendSDL2::GetMonitorRects() {
+    std::vector<Ship::WindowRect> rects;
+    int count = SDL_GetNumVideoDisplays();
+    for (int i = 0; i < count; i++) {
+        SDL_Rect r;
+        if (SDL_GetDisplayBounds(i, &r) == 0) {
+            rects.push_back({ r.x, r.y, r.x + r.w, r.y + r.h });
+        }
+    }
+    if (rects.empty()) {
+        rects.push_back(GetPrimaryMonitorRect());
+    }
+    return rects;
+}
+
+void GfxWindowBackendSDL2::SetBorderless(bool borderless) {
+    if (mWnd) {
+        SDL_SetWindowBordered(mWnd, borderless ? SDL_FALSE : SDL_TRUE);
+    }
+}
