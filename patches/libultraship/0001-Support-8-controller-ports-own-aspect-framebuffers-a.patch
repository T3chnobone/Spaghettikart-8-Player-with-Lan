+void Interpreter::SetFrameBufferPixelSize(int fb, uint32_t width, uint32_t height) {
+    auto it = mFrameBuffers.find(fb);
+    if (it == mFrameBuffers.end()) {
+        return;
+    }
+    width = width == 0 ? 1 : width;
+    height = height == 0 ? 1 : height;
+    it->second.resize = false;
+    it->second.ownAspect = true;
+    if (width != it->second.applied_width || height != it->second.applied_height) {
+        mRapi->UpdateFramebufferParameters(fb, width, height, 1, true, true, true, true);
+        it->second.applied_width = width;
+        it->second.applied_height = height;
+    }
+}
+
 void Interpreter::SetFrameBuffer(int fb, float noiseScale) {
     mRapi->StartDrawToFramebuffer(fb, noiseScale);
     mRapi->ClearFramebuffer(false, true);
