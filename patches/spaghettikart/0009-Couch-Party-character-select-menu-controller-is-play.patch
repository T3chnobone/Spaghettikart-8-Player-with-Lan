 extern "C" void couch_filter_pads(OSContPad* pads) {
+    // Remember which controller is driving the menus (raw ports, before any remap).
+    if (gGamestate < RACING && !couch_select_active()) {
+        for (int port = 0; port < MAXCONTROLLERS; port++) {
+            uint16_t held = (uint16_t) pads[port].button;
+            if ((held & ~sMenuPrev[port]) & (A_BUTTON | START_BUTTON)) {
+                sMenuPort = port;
+            }
+            sMenuPrev[port] = held;
+        }
+    }
     if (!gCouchParty) {
         return;
     }
