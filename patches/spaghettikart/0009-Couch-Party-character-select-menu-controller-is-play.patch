 void render_couch_cursor(MenuItem* arg0, s32 playerId) {
-    static const u8 sColors[4][3] = { { 255, 140, 30 }, { 180, 90, 255 }, { 40, 220, 200 }, { 255, 90, 160 } };
-    static char* const sTags[4] = { "5P", "6P", "7P", "8P" };
-    const u8* c = sColors[(playerId - 4) & 3];
+    static const u8 sColors[8][3] = {
+        { 230, 50, 50 },  { 50, 110, 240 }, { 245, 205, 30 }, { 50, 200, 80 },
+        { 255, 140, 30 }, { 170, 80, 240 }, { 30, 210, 210 }, { 255, 90, 170 },
+    };
+    static char* const sNumbers[8] = { "1", "2", "3", "4", "5", "6", "7", "8" };
+    const u8* c;
     s32 x0 = arg0->column;
     s32 y0 = arg0->row;
     s32 x1 = x0 + 0x40;
     s32 y1 = y0 + 0x4C;
     s32 alpha = 255;
+    s32 tagX;
+    s32 tagY;
 
