 void update_couch_cursor(MenuItem* arg0) {
     s32 playerId = 4 + (arg0->type - COUCH_SELECT_MENU_5P_CURSOR);
     s8 characterSelectionIndex = gCharacterGridSelections[playerId];
 
-    // Above the portraits, between the stock cursors.
-    arg0->priority = 0xD - ((playerId - 4) * 2);
-    if (arg0->priority < 9) {
-        arg0->priority = 9;
-    }
+    arg0->priority = MENU_ITEM_PRIORITY_F; // over every portrait
     hover_cursor_over_character_portrait(arg0, characterSelectionIndex - 1);
 }
 
@@ -10768,6 +10789,9 @@ void update_cursor(MenuItem* arg0) {
     playerId = arg0->type - CHARACTER_SELECT_MENU_1P_CURSOR;
     characterSelectionIndex = gCharacterGridSelections[playerId];
     arg0->priority = 0xE - (playerId * 2);
+    if (gCouchParty) {
+        arg0->priority = MENU_ITEM_PRIORITY_F; // Couch Party cursors go over every portrait
+    }
     hover_cursor_over_character_portrait(arg0, characterSelectionIndex - 1);
 }
 
