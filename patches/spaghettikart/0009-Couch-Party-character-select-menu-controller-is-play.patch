+    gDisplayListHead = draw_box(gDisplayListHead, x0, y0 + 4, x0 + 4, y1 - 4, c[0], c[1], c[2], alpha);
+    gDisplayListHead = draw_box(gDisplayListHead, x1 - 4, y0 + 4, x1, y1 - 4, c[0], c[1], c[2], alpha);
+    // Number tag in the top-left corner; moved along if players before this
