+#pragma once
+
+// Drawing with the game's own menu font and boxes, from C++ (N64 screen
+// coordinates, 320x240). Text y is the baseline.
+
+#include <cstdio>
+#include <string>
+
+extern "C" {
+#include "main.h"
+#include "menu_items.h"
+#include <defines.h>
+}
+
+namespace GameDraw {
+
+// The game font has no ':', '<', '/', '_' etc., and anything it can't draw
+// stops the whole string, so those become spaces (and letters upper case).
+inline std::string Printable(const std::string& in) {
+    std::string out;
+    for (char c : in) {
+        bool ok = (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == ' ' ||
+                  c == '!' || c == '-' || c == '?' || c == '\'' || c == '.' || c == '"' || c == '*' || c == '+' ||
+                  c == ',';
+        out.push_back(ok ? (char) ((c >= 'a' && c <= 'z') ? c - 32 : c) : ' ');
+    }
+    return out;
+}
+
+// Left-aligned from x.
+inline void Text(int x, int y, const std::string& s, int color, float scale) {
+    std::string p = Printable(s);
+    if (p.empty()) {
+        return;
+    }
+    char buf[128];
+    std::snprintf(buf, sizeof(buf), "%s", p.c_str());
+    set_text_color(color);
+    print_text_mode_1(x, y, buf, 0, scale, scale);
+}
+
+// Centred on x.
+inline void TextCentered(int x, int y, const std::string& s, int color, float scale) {
+    std::string p = Printable(s);
+    if (p.empty()) {
+        return;
+    }
+    char buf[128];
+    std::snprintf(buf, sizeof(buf), "%s", p.c_str());
+    set_text_color(color);
+    print_text1_center_mode_1(x, y, buf, 0, scale, scale);
+}
+
+// Ending at x.
+inline void TextRight(int x, int y, const std::string& s, int color, float scale) {
+    std::string p = Printable(s);
+    if (p.empty()) {
+        return;
+    }
+    char buf[128];
+    std::snprintf(buf, sizeof(buf), "%s", p.c_str());
+    set_text_color(color);
+    print_text1_left(x, y, buf, 0, scale, scale); // the game's "left" mode right-aligns
+}
+
+// Translucent box (alpha 0-255).
+inline void Box(int x0, int y0, int x1, int y1, int r, int g, int b, int a) {
+    gDisplayListHead = draw_box(gDisplayListHead, x0, y0, x1, y1, r, g, b, a);
+}
+
+// Box with a border.
+inline void Panel(int x0, int y0, int x1, int y1, int alpha = 215) {
+    Box(x0, y0, x1, y1, 255, 216, 0, 255);
+    Box(x0 + 2, y0 + 2, x1 - 2, y1 - 2, 8, 12, 40, alpha);
+}
+
+} // namespace GameDraw
