+// ------------------------------------------------------------------ LAN discovery
+
+void Session::PumpDiscovery() {
+    if (mDiscoverySock == -1) {
+        return;
+    }
+    uint8_t buf[512];
+    for (;;) {
+        sockaddr_in from{};
+        SockLen len = sizeof(from);
+        int n = (int) recvfrom(NS(mDiscoverySock), (char*) buf, sizeof(buf), 0, (sockaddr*) &from, &len);
+        if (n <= 0) {
+            return;
+        }
+        Reader r(buf, (size_t) n);
+        if (r.U32() != kProbeMagic || r.U16() != kProtocolVersion || !r.ok) {
+            continue;
+        }
+        Writer w;
+        w.U32(kReplyMagic);
+        w.U16(kProtocolVersion);
+        w.U16(mPort);
+        w.Str(mLocalName);
+        w.Str(mAdvert);
+        w.U8((uint8_t) PlayerCount());
+        w.U8(mPhase == Phase::Lobby ? 1 : 0);
+        sendto(NS(mDiscoverySock), (const char*) w.buf.data(), (int) w.buf.size(), 0, (sockaddr*) &from, len);
+    }
+}
+
+Discovery::~Discovery() {
+    Stop();
+}
+
+bool Discovery::Start(uint16_t port) {
+    Stop();
+    if (!EnsureSockets()) {
+        return false;
+    }
+    intptr_t s = (intptr_t) socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (s == -1) {
+        return false;
+    }
+    int one = 1;
+    setsockopt(NS(s), SOL_SOCKET, SO_BROADCAST, (const char*) &one, sizeof(one));
+    sockaddr_in addr{};
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = htonl(INADDR_ANY);
+    addr.sin_port = 0;
+    if (bind(NS(s), (sockaddr*) &addr, sizeof(addr)) != 0 || !SetNonBlocking(s)) {
+        CloseSock(s);
+        return false;
+    }
+    mSock = s;
+    mPort = port;
+    mLastProbe = 0.0;
+    mGames.clear();
+    return true;
+}
+
+void Discovery::Stop() {
+    CloseSock(mSock);
+    mGames.clear();
+}
+
+void Discovery::Poll() {
+    if (mSock == -1) {
+        return;
+    }
+    double now = NowSeconds();
+    if (now - mLastProbe >= 1.0) {
+        mLastProbe = now;
+        Writer w;
+        w.U32(kProbeMagic);
+        w.U16(kProtocolVersion);
+        sockaddr_in to{};
+        to.sin_family = AF_INET;
+        to.sin_port = htons(mPort);
+        to.sin_addr.s_addr = htonl(INADDR_BROADCAST);
+        sendto(NS(mSock), (const char*) w.buf.data(), (int) w.buf.size(), 0, (sockaddr*) &to, sizeof(to));
+        // Also this PC itself, for testing with two copies on one machine.
+        to.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        sendto(NS(mSock), (const char*) w.buf.data(), (int) w.buf.size(), 0, (sockaddr*) &to, sizeof(to));
+    }
+    uint8_t buf[512];
+    for (;;) {
+        sockaddr_in from{};
+        SockLen len = sizeof(from);
+        int n = (int) recvfrom(NS(mSock), (char*) buf, sizeof(buf), 0, (sockaddr*) &from, &len);
+        if (n <= 0) {
+            break;
+        }
+        Reader r(buf, (size_t) n);
+        if (r.U32() != kReplyMagic || r.U16() != kProtocolVersion) {
+            continue;
+        }
+        FoundGame g;
+        g.port = r.U16();
+        g.name = r.Str();
+        g.advert = r.Str();
+        g.players = r.U8();
+        bool open = r.U8() != 0;
+        if (!r.ok || !open) {
+            continue;
+        }
+        char ip[INET_ADDRSTRLEN] = {};
+        inet_ntop(AF_INET, &from.sin_addr, ip, sizeof(ip));
+        g.address = ip;
+        g.lastSeen = now;
+        bool found = false;
+        for (auto& e : mGames) {
+            // Loopback and LAN replies from the same PC: keep the LAN address.
+            bool same = (e.address == g.address || (g.address == "127.0.0.1" && e.name == g.name)) && e.port == g.port;
+            if (same) {
+                std::string keep = e.address;
+                e = g;
+                if (g.address == "127.0.0.1") {
+                    e.address = keep;
+                }
+                found = true;
+                break;
+            }
+        }
+        if (!found) {
+            mGames.push_back(g);
+        }
+    }
+    mGames.erase(std::remove_if(mGames.begin(), mGames.end(), [&](const FoundGame& e) { return now - e.lastSeen > 4.0; }),
+                 mGames.end());
+}
+
+std::string LocalAddress() {
+    if (!EnsureSockets()) {
+        return "";
+    }
+    std::string result;
+    intptr_t s = (intptr_t) socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (s == -1) {
+        return "";
+    }
+    // "Connecting" a UDP socket sends nothing; it just picks the outgoing interface.
+    sockaddr_in to{};
+    to.sin_family = AF_INET;
+    to.sin_port = htons(9);
+    inet_pton(AF_INET, "192.168.255.255", &to.sin_addr);
+    const char* targets[] = { "8.8.8.8", "10.255.255.255", "192.168.255.255" };
+    for (const char* t : targets) {
+        inet_pton(AF_INET, t, &to.sin_addr);
+        if (connect(NS(s), (sockaddr*) &to, sizeof(to)) == 0) {
+            sockaddr_in me{};
+            SockLen len = sizeof(me);
+            if (getsockname(NS(s), (sockaddr*) &me, &len) == 0 && me.sin_addr.s_addr != htonl(INADDR_ANY)) {
+                char ip[INET_ADDRSTRLEN] = {};
+                inet_ntop(AF_INET, &me.sin_addr, ip, sizeof(ip));
+                result = ip;
+                break;
+            }
+        }
+    }
+    CloseSock(s);
+    return result;
+}
+
 } // namespace Netplay
