diff --git a/src/port/couch/LanSetup.cpp b/src/port/couch/LanSetup.cpp
new file mode 100644
index 0000000..b401061
--- /dev/null
+++ b/src/port/couch/LanSetup.cpp
@@ -0,0 +1,773 @@
+// LAN GAME setup screen (see lan_setup.h): host or join a game on the local
+// network with a controller, drawn with the game's own font.
+
+#include "lan_setup.h"
+#include "couch.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+#include <libultraship/libultraship.h>
+#include "port/netplay/NetplayCore.h"
+#include "port/ui/GameDraw.h"
+
+extern "C" {
+#include "main.h"
+#include "menus.h"
+#include "menu_items.h"
+#include <defines.h>
+#include <sounds.h>
+#include "audio/external.h"
+}
+
+namespace {
+
+using Netplay::Phase;
+using Netplay::Role;
+
+enum class Mode { Host = 0, Join = 1 };
+enum class Edit { None, Name, Address, Port };
+
+// Rows (the list below them, when joining, follows the last row).
+enum Row { kRowGame, kRowAddress, kRowName, kRowPlayers, kRowDelay, kRowPort, kRowButton, kNumRows };
+
+constexpr int kNameMax = 12;
+const char kNameCharset[] = " ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-.!";
+
+struct State {
+    bool active = false;
+    Mode mode = Mode::Host;
+    int row = kRowGame;
+    int listIndex = -1; // join: highlighted found game (-1: on the rows)
+    Edit edit = Edit::None;
+    int editCursor = 0;
+    std::string editText;   // name being edited
+    std::array<int, 12> addrDigits{};
+    std::array<int, 5> portDigits{};
+    std::string message;    // last error / hint
+    int messageTimer = 0;
+    std::string myAddress;
+    int addressTimer = 0;
+    // Input edges for all local ports together.
+    std::array<uint16_t, MAXCONTROLLERS> prevButtons{};
+    std::array<int8_t, MAXCONTROLLERS> prevDirX{}, prevDirY{};
+    int repeat = 0;
+};
+State sState;
+Netplay::Discovery sDiscovery;
+
+Netplay::Session& S() {
+    return Netplay::Get();
+}
+
+// ---- settings (CVars) ----
+std::string Name() {
+    std::string n = CVarGetString("gLan.Name", "PLAYER");
+    return n.empty() ? std::string("PLAYER") : n;
+}
+uint16_t Port() {
+    return (uint16_t) std::clamp(CVarGetInteger("gLan.Port", Netplay::kDefaultPort), 1024, 65535);
+}
+std::string HostAddress() {
+    return CVarGetString("gLan.HostAddress", "192.168.1.2");
+}
+int LocalPlayers() {
+    return std::clamp(CVarGetInteger("gLan.LocalPlayers", 1), 1, 8);
+}
+int Delay() { // -1 = auto
+    return std::clamp(CVarGetInteger("gLan.Delay", -1), -1, Netplay::kMaxInputDelay);
+}
+
+void Message(const std::string& text) {
+    sState.message = text;
+    sState.messageTimer = 60 * 6;
+}
+
+std::string Advert() {
+    if (gModeSelection == BATTLE) {
+        return "BATTLE";
+    }
+    static const char* kCC[] = { "50CC", "100CC", "150CC", "EXTRA" };
+    return std::string("VS ") + kCC[std::clamp<int>(gCCSelection, 0, 3)];
+}
+
+void AddressToDigits(const std::string& addr) {
+    int o[4] = { 0, 0, 0, 0 };
+    std::sscanf(addr.c_str(), "%d.%d.%d.%d", &o[0], &o[1], &o[2], &o[3]);
+    for (int i = 0; i < 4; i++) {
+        int v = std::clamp(o[i], 0, 255);
+        sState.addrDigits[i * 3 + 0] = v / 100;
+        sState.addrDigits[i * 3 + 1] = (v / 10) % 10;
+        sState.addrDigits[i * 3 + 2] = v % 10;
+    }
+}
+
+std::string DigitsToAddress() {
+    char buf[32];
+    int o[4];
+    for (int i = 0; i < 4; i++) {
+        o[i] = std::min(255, sState.addrDigits[i * 3] * 100 + sState.addrDigits[i * 3 + 1] * 10 +
+                                 sState.addrDigits[i * 3 + 2]);
+    }
+    std::snprintf(buf, sizeof(buf), "%d.%d.%d.%d", o[0], o[1], o[2], o[3]);
+    return buf;
+}
+
+// ---- session control ----
+void StartHosting() {
+    sDiscovery.Stop();
+    S().SetLocalCount(LocalPlayers());
+    int d = Delay();
+    S().SetInputDelay(d < 0 ? 2 : d);
+    S().SetLobbyOptions(0);
+    S().SetAdvert(Advert());
+    if (!S().Host(Port(), Name())) {
+        Message(S().LastError());
+    }
+}
+
+void StartJoinMode() {
+    S().Disconnect();
+    S().SetLocalCount(LocalPlayers());
+    if (!sDiscovery.Start(Port())) {
+        Message("Can't look for games on this network");
+    }
+}
+
+void JoinGame(const std::string& address, uint16_t port) {
+    S().SetLocalCount(LocalPlayers());
+    if (!S().Join(address, port, Name())) {
+        Message(S().LastError());
+    } else {
+        Message("Connecting to " + address);
+    }
+}
+
+bool ClientBusy() {
+    return S().GetRole() == Role::Client; // connecting or in the host's lobby
+}
+
+void Enter() {
+    sState = State{};
+    sState.active = true;
+    sState.mode = CVarGetInteger("gLan.Mode", 0) == 1 ? Mode::Join : Mode::Host;
+    sState.prevButtons.fill(0xFFFF); // the A that got us here doesn't count
+    sState.myAddress = Netplay::LocalAddress();
+    if (sState.mode == Mode::Host) {
+        StartHosting();
+    } else {
+        StartJoinMode();
+    }
+}
+
+void Leave() {
+    sState.active = false;
+    sDiscovery.Stop();
+    if (!S().IsInGame()) {
+        S().Disconnect();
+    }
+}
+
+void SwitchMode(Mode m) {
+    if (sState.mode == m) {
+        return;
+    }
+    sState.mode = m;
+    sState.listIndex = -1;
+    CVarSetInteger("gLan.Mode", m == Mode::Join ? 1 : 0);
+    CVarSave();
+    if (m == Mode::Host) {
+        StartHosting();
+    } else {
+        StartJoinMode();
+    }
+}
+
+// Rows the cursor can stop on in this mode.
+bool RowUsed(int row) {
+    if (sState.mode == Mode::Host) {
+        return row != kRowAddress; // your own address is just shown
+    }
+    return row != kRowDelay; // the host sets the delay
+}
+
+void MoveRow(int dir) {
+    if (sState.listIndex >= 0) {
+        int n = (int) sDiscovery.Games().size();
+        sState.listIndex += dir;
+        if (sState.listIndex < 0) {
+            sState.listIndex = -1;
+            sState.row = kRowButton;
+        } else if (sState.listIndex >= n) {
+            sState.listIndex = n - 1;
+        }
+        play_sound2(SOUND_MENU_CURSOR_MOVE);
+        return;
+    }
+    int r = sState.row;
+    do {
+        r += dir;
+    } while (r >= 0 && r < kNumRows && !RowUsed(r));
+    if (r >= kNumRows) {
+        if (sState.mode == Mode::Join && !sDiscovery.Games().empty()) {
+            sState.listIndex = 0;
+            play_sound2(SOUND_MENU_CURSOR_MOVE);
+        }
+        return;
+    }
+    if (r < 0) {
+        return;
+    }
+    sState.row = r;
+    play_sound2(SOUND_MENU_CURSOR_MOVE);
+}
+
+void Change(int dir) {
+    switch (sState.row) {
+        case kRowGame:
+            if (!ClientBusy()) {
+                SwitchMode(sState.mode == Mode::Host ? Mode::Join : Mode::Host);
+                play_sound2(SOUND_MENU_CURSOR_MOVE);
+            }
+            break;
+        case kRowPlayers: {
+            if (ClientBusy() && S().GetPhase() != Phase::Lobby) {
+                break;
+            }
+            int n = std::clamp(LocalPlayers() + dir, 1, 8);
+            CVarSetInteger("gLan.LocalPlayers", n);
+            CVarSave();
+            S().SetLocalCount(n);
+            play_sound2(SOUND_MENU_CURSOR_MOVE);
+            break;
+        }
+        case kRowDelay: {
+            int d = std::clamp(Delay() + dir, -1, Netplay::kMaxInputDelay);
+            CVarSetInteger("gLan.Delay", d);
+            CVarSave();
+            S().SetInputDelay(d < 0 ? 2 : d);
+            play_sound2(SOUND_MENU_CURSOR_MOVE);
+            break;
+        }
+        default:
+            break;
+    }
+}
+
+void Activate() {
+    switch (sState.row) {
+        case kRowName:
+            if (ClientBusy()) {
+                break;
+            }
+            sState.edit = Edit::Name;
+            sState.editText = Name();
+            sState.editCursor = 0;
+            play_sound2(SOUND_MENU_SELECT);
+            break;
+        case kRowAddress:
+            if (sState.mode == Mode::Join && !ClientBusy()) {
+                sState.edit = Edit::Address;
+                AddressToDigits(HostAddress());
+                sState.editCursor = 0;
+                play_sound2(SOUND_MENU_SELECT);
+            }
+            break;
+        case kRowPort:
+            if (!ClientBusy()) {
+                sState.edit = Edit::Port;
+                int p = Port();
+                for (int i = 4; i >= 0; i--) {
+                    sState.portDigits[i] = p % 10;
+                    p /= 10;
+                }
+                sState.editCursor = 0;
+                play_sound2(SOUND_MENU_SELECT);
+            }
+            break;
+        case kRowButton:
+            if (sState.mode == Mode::Host) {
+                if (S().GetRole() != Role::Host) {
+                    StartHosting();
+                } else if (S().PlayerCount() < 2) {
+                    Message("Waiting for another player to join");
+                } else if (S().PlayerCount() > 8) {
+                    Message("Too many players - 8 at most");
+                } else if (S().RequestStart()) {
+                    play_sound2(SOUND_MENU_OK_CLICKED);
+                }
+            } else if (!ClientBusy()) {
+                JoinGame(HostAddress(), Port());
+                play_sound2(SOUND_MENU_SELECT);
+            }
+            break;
+        default:
+            Change(1);
+            break;
+    }
+}
+
+void FinishEdit(bool keep) {
+    if (keep) {
+        switch (sState.edit) {
+            case Edit::Name: {
+                std::string n = sState.editText;
+                while (!n.empty() && n.back() == ' ') {
+                    n.pop_back();
+                }
+                if (n.empty()) {
+                    n = "PLAYER";
+                }
+                CVarSetString("gLan.Name", n.c_str());
+                // A new name shows once the lobby is reopened (only if nobody's in yet).
+                if (S().GetRole() == Role::Host && S().PcCount() <= 1) {
+                    StartHosting();
+                }
+                break;
+            }
+            case Edit::Address:
+                CVarSetString("gLan.HostAddress", DigitsToAddress().c_str());
+                break;
+            case Edit::Port: {
+                int p = 0;
+                for (int d : sState.portDigits) {
+                    p = p * 10 + d;
+                }
+                CVarSetInteger("gLan.Port", std::clamp(p, 1024, 65535));
+                if (sState.mode == Mode::Host) {
+                    StartHosting();
+                } else {
+                    StartJoinMode();
+                }
+                break;
+            }
+            default:
+                break;
+        }
+        CVarSave();
+        play_sound2(SOUND_MENU_OK_CLICKED);
+    } else {
+        play_sound2(SOUND_MENU_GO_BACK);
+    }
+    sState.edit = Edit::None;
+}
+
+int CharsetIndex(char c) {
+    const char* p = std::strchr(kNameCharset, c);
+    return (p != nullptr && c != '\0') ? (int) (p - kNameCharset) : 0;
+}
+
+void EditInput(uint16_t pressed, int dirX, int dirY) {
+    if (sState.edit == Edit::Name) {
+        std::string& t = sState.editText;
+        if ((int) t.size() <= sState.editCursor) {
+            t.resize(sState.editCursor + 1, ' ');
+        }
+        if (dirY != 0) {
+            int n = (int) sizeof(kNameCharset) - 1;
+            int idx = (CharsetIndex(t[sState.editCursor]) + (dirY > 0 ? 1 : n - 1)) % n;
+            t[sState.editCursor] = kNameCharset[idx];
+        }
+        if (dirX > 0 || (pressed & A_BUTTON)) {
+            if ((pressed & A_BUTTON) && sState.editCursor >= kNameMax - 1) {
+                FinishEdit(true);
+                return;
+            }
+            sState.editCursor = std::min(sState.editCursor + 1, kNameMax - 1);
+        }
+        if (dirX < 0) {
+            sState.editCursor = std::max(sState.editCursor - 1, 0);
+        }
+        if (pressed & B_BUTTON) {
+            // Delete this letter; B on an empty name cancels.
+            if (t.find_first_not_of(' ') == std::string::npos) {
+                FinishEdit(false);
+                return;
+            }
+            t.erase(sState.editCursor, 1);
+            sState.editCursor = std::max(sState.editCursor - 1, 0);
+        }
+        if (pressed & START_BUTTON) {
+            FinishEdit(true);
+        }
+        return;
+    }
+    int* digits = sState.edit == Edit::Address ? sState.addrDigits.data() : sState.portDigits.data();
+    int count = sState.edit == Edit::Address ? 12 : 5;
+    if (dirY != 0) {
+        int& d = digits[sState.editCursor];
+        d = (d + (dirY > 0 ? 1 : 9)) % 10;
+    }
+    if (dirX != 0) {
+        sState.editCursor = std::clamp(sState.editCursor + dirX, 0, count - 1);
+    }
+    if (pressed & (A_BUTTON | START_BUTTON)) {
+        FinishEdit(true);
+    } else if (pressed & B_BUTTON) {
+        FinishEdit(false);
+    }
+}
+
+// ---- drawing ----
+using GameDraw::Box;
+using GameDraw::Text;
+using GameDraw::TextCentered;
+
+// A small filled triangle pointing left (dir < 0) or right.
+void Arrow(int x, int yMid, int dir, int r, int g, int b) {
+    for (int i = 0; i < 5; i++) {
+        int h = 5 - i;
+        int col = dir < 0 ? x + i : x + 4 - i;
+        Box(col, yMid - h, col + 1, yMid + h, r, g, b, 255);
+    }
+}
+
+std::string DelayText() {
+    int d = Delay();
+    return d < 0 ? std::string("AUTO") : std::to_string(d);
+}
+
+} // namespace
+
+// ------------------------------------------------------------------ C API
+
+extern "C" bool lan_setup_active(void) {
+    return gLanMenu && !gCouchParty && gGamestate < RACING && gMenuSelection == CHARACTER_SELECT_MENU &&
+           !S().IsInGame();
+}
+
+extern "C" bool couch_lan_hosting(void) {
+    return gLanMenu && S().GetRole() == Role::Host && gMenuSelection == CHARACTER_SELECT_MENU;
+}
+
+extern "C" void lan_setup_tick(void) {
+    bool want = lan_setup_active();
+    if (want && !sState.active) {
+        Enter();
+    } else if (!want && sState.active) {
+        Leave();
+    }
+    if (!sState.active) {
+        return;
+    }
+    if (sDiscovery.Active()) {
+        sDiscovery.Poll();
+        if (sState.listIndex >= (int) sDiscovery.Games().size()) {
+            sState.listIndex = (int) sDiscovery.Games().size() - 1;
+            if (sState.listIndex < 0) {
+                sState.row = kRowButton;
+            }
+        }
+    }
+    if (S().GetRole() == Role::Host) {
+        S().SetAdvert(Advert());
+    }
+    if (sState.messageTimer > 0 && --sState.messageTimer == 0) {
+        sState.message.clear();
+    }
+    if (!S().LastError().empty() && S().GetRole() == Role::None && sState.message.empty()) {
+        Message(S().LastError());
+    }
+    if (--sState.addressTimer <= 0) {
+        sState.addressTimer = 60 * 5;
+        sState.myAddress = Netplay::LocalAddress();
+    }
+    // A client that lost the host goes back to looking for games.
+    if (sState.mode == Mode::Join && S().GetRole() == Role::None && !sDiscovery.Active()) {
+        sDiscovery.Start(Port());
+    }
+}
+
+extern "C" void lan_setup_input(const OSContPad* pads) {
+    if (!sState.active || is_screen_being_faded()) {
+        for (int p = 0; p < MAXCONTROLLERS; p++) {
+            sState.prevButtons[p] = (uint16_t) pads[p].button;
+        }
+        return;
+    }
+    // All of this PC's controllers can drive the screen.
+    uint16_t pressed = 0;
+    int dirX = 0, dirY = 0;
+    bool anyDir = false, freshDir = false;
+    for (int p = 0; p < MAXCONTROLLERS; p++) {
+        uint16_t held = (uint16_t) pads[p].button;
+        int8_t dx = (held & R_JPAD) || pads[p].stick_x > 50 ? 1 : ((held & L_JPAD) || pads[p].stick_x < -50 ? -1 : 0);
+        int8_t dy = (held & U_JPAD) || pads[p].stick_y > 50 ? 1 : ((held & D_JPAD) || pads[p].stick_y < -50 ? -1 : 0);
+        pressed |= held & ~sState.prevButtons[p];
+        if ((dx != sState.prevDirX[p] || dy != sState.prevDirY[p]) && (dx != 0 || dy != 0)) {
+            freshDir = true;
+            dirX = dx;
+            dirY = dy;
+        }
+        if (dx != 0 || dy != 0) {
+            anyDir = true;
+            if (dirX == 0 && dirY == 0 && !freshDir) {
+                dirX = dx;
+                dirY = dy;
+            }
+        }
+        sState.prevButtons[p] = held;
+        sState.prevDirX[p] = dx;
+        sState.prevDirY[p] = dy;
+    }
+    if (freshDir) {
+        sState.repeat = 20;
+    } else if (anyDir && --sState.repeat <= 0) {
+        sState.repeat = 5;
+    } else {
+        dirX = dirY = 0;
+    }
+
+    if (sState.edit != Edit::None) {
+        EditInput(pressed, dirX, dirY);
+        return;
+    }
+    if (pressed & B_BUTTON) {
+        if (ClientBusy()) {
+            S().Disconnect("Left the lobby");
+            Message("Left the host's game");
+            play_sound2(SOUND_MENU_GO_BACK);
+            return;
+        }
+        Leave();
+        func_8009E208(); // back to the main menu
+        play_sound2(SOUND_MENU_GO_BACK);
+        return;
+    }
+    if (dirY != 0) {
+        MoveRow(dirY > 0 ? -1 : 1);
+    } else if (dirX != 0 && sState.listIndex < 0) {
+        Change(dirX);
+    }
+    if (pressed & A_BUTTON) {
+        if (sState.listIndex >= 0) {
+            const auto& games = sDiscovery.Games();
+            if (sState.listIndex < (int) games.size() && !ClientBusy()) {
+                JoinGame(games[sState.listIndex].address, games[sState.listIndex].port);
+                play_sound2(SOUND_MENU_SELECT);
+            }
+        } else {
+            Activate();
+        }
+    }
+    if ((pressed & START_BUTTON) && sState.mode == Mode::Host) {
+        sState.row = kRowButton;
+        sState.listIndex = -1;
+        Activate();
+    }
+    if ((pressed & Z_TRIG) && sState.mode == Mode::Join && !ClientBusy()) {
+        StartJoinMode(); // look again
+        Message("Looking for games...");
+    }
+}
+
+extern "C" void lan_setup_render(void) {
+    if (!lan_setup_active() || !sState.active) {
+        return;
+    }
+    const bool host = sState.mode == Mode::Host;
+    const bool busy = ClientBusy();
+
+    // Backdrop over the character screen.
+    Box(0, 0, 320, 240, 18, 40, 120, 255);
+    Box(0, 120, 320, 240, 12, 26, 84, 255);
+
+    // Banner.
+    Box(70, 6, 250, 28, 255, 216, 0, 255);
+    Box(72, 8, 248, 26, 208, 32, 32, 255);
+    TextCentered(160, 23, "LAN GAME  " + Advert(), TEXT_YELLOW, 0.7f);
+
+    const int x0 = 22, x1 = 298, valueX = 168, rowH = 16;
+    int y = 34;
+    auto rowBack = [&](int row) {
+        bool sel = sState.listIndex < 0 && sState.row == row && sState.edit == Edit::None;
+        if (sel) {
+            Box(x0, y, x1, y + rowH - 1, 255, 246, 220, 255);
+        } else {
+            Box(x0, y, x1, y + rowH - 1, 16, 16, 16, 230);
+        }
+        return sel;
+    };
+    auto label = [&](const std::string& s, bool sel) { Text(x0 + 6, y + 12, s, sel ? TEXT_RED : TEXT_YELLOW, 0.6f); };
+
+    // GAME: HOST / JOIN
+    {
+        bool sel = rowBack(kRowGame);
+        label("GAME", sel);
+        Arrow(valueX, y + 7, -1, 230, 60, 50);
+        Text(valueX + 10, y + 12, host ? "HOST" : "JOIN", TEXT_RED, 0.6f);
+        Arrow(valueX + 58, y + 7, 1, 230, 60, 50);
+        y += rowH + 1;
+    }
+    // ADDRESS
+    {
+        bool sel = rowBack(kRowAddress);
+        label(host ? "YOUR ADDRESS" : "HOST ADDRESS", sel);
+        if (host) {
+            Text(valueX, y + 12, sState.myAddress.empty() ? "UNKNOWN" : sState.myAddress, TEXT_GREEN, 0.6f);
+        } else if (sState.edit == Edit::Address) {
+            // 192.168.001.023 with the cursor digit highlighted.
+            int cx = valueX;
+            for (int i = 0; i < 12; i++) {
+                std::string d(1, (char) ('0' + sState.addrDigits[i]));
+                if (i == sState.editCursor) {
+                    Box(cx - 1, y + 2, cx + 7, y + 14, 255, 225, 74, 255);
+                }
+                Text(cx, y + 12, d, i == sState.editCursor ? TEXT_RED : TEXT_GREEN, 0.6f);
+                cx += 8;
+                if (i % 3 == 2 && i < 11) {
+                    Text(cx, y + 12, ".", TEXT_GREEN, 0.6f);
+                    cx += 5;
+                }
+            }
+        } else {
+            Text(valueX, y + 12, HostAddress(), TEXT_GREEN, 0.6f);
+        }
+        y += rowH + 1;
+    }
+    // NAME
+    {
+        bool sel = rowBack(kRowName);
+        label("YOUR NAME", sel);
+        if (sState.edit == Edit::Name) {
+            int cx = valueX;
+            for (int i = 0; i < kNameMax; i++) {
+                char c = i < (int) sState.editText.size() ? sState.editText[i] : ' ';
+                if (i == sState.editCursor) {
+                    Box(cx - 1, y + 2, cx + 8, y + 14, 255, 225, 74, 255);
+                } else {
+                    Box(cx, y + 13, cx + 7, y + 14, 127, 216, 255, 255);
+                }
+                if (c != ' ') {
+                    Text(cx, y + 12, std::string(1, c), i == sState.editCursor ? TEXT_RED : TEXT_BLUE, 0.6f);
+                }
+                cx += 10;
+            }
+        } else {
+            Text(valueX, y + 12, Name(), TEXT_BLUE, 0.6f);
+        }
+        y += rowH + 1;
+    }
+    // PLAYERS ON THIS PC
+    {
+        bool sel = rowBack(kRowPlayers);
+        label("PLAYERS ON THIS PC", sel);
+        Arrow(valueX, y + 7, -1, 127, 216, 255);
+        Text(valueX + 12, y + 12, std::to_string(LocalPlayers()), TEXT_BLUE, 0.6f);
+        Arrow(valueX + 26, y + 7, 1, 127, 216, 255);
+        y += rowH + 1;
+    }
+    // INPUT DELAY (host)
+    {
+        bool sel = rowBack(kRowDelay);
+        label("INPUT DELAY", sel);
+        if (host) {
+            Arrow(valueX, y + 7, -1, 127, 216, 255);
+            Text(valueX + 12, y + 12, DelayText(), TEXT_BLUE, 0.6f);
+            Arrow(valueX + 50, y + 7, 1, 127, 216, 255);
+        } else {
+            Text(valueX, y + 12, "SET BY THE HOST", TEXT_BLUE, 0.5f);
+        }
+        y += rowH + 1;
+    }
+    // PORT
+    {
+        bool sel = rowBack(kRowPort);
+        label("PORT", sel);
+        if (sState.edit == Edit::Port) {
+            int cx = valueX;
+            for (int i = 0; i < 5; i++) {
+                if (i == sState.editCursor) {
+                    Box(cx - 1, y + 2, cx + 7, y + 14, 255, 225, 74, 255);
+                }
+                Text(cx, y + 12, std::string(1, (char) ('0' + sState.portDigits[i])),
+                     i == sState.editCursor ? TEXT_RED : TEXT_GREEN, 0.6f);
+                cx += 8;
+            }
+        } else {
+            Text(valueX, y + 12, std::to_string(Port()), TEXT_GREEN, 0.6f);
+        }
+        y += rowH + 4;
+    }
+    // Button
+    {
+        bool sel = sState.listIndex < 0 && sState.row == kRowButton && sState.edit == Edit::None;
+        Box(100, y, 220, y + 16, sel ? 255 : 80, sel ? 246 : 80, sel ? 220 : 80, 255);
+        Box(102, y + 2, 218, y + 14, 16, 16, 16, 255);
+        std::string text;
+        if (host) {
+            text = S().GetRole() == Role::Host ? "START RACE" : "OPEN GAME";
+        } else {
+            text = busy ? (S().GetPhase() == Phase::Lobby ? "CONNECTED" : "CONNECTING...") : "CONNECT";
+        }
+        TextCentered(160, y + 13, text, sel ? TEXT_BLUE_GREEN_RED_CYCLE_1 : TEXT_GREEN, 0.6f);
+        y += 20;
+    }
+
+    // Panel: who's in (host / connected client) or games found (joining).
+    const int py = y;
+    Box(x0, py, x1, 222, 255, 216, 0, 255);
+    Box(x0 + 2, py + 2, x1 - 2, 220, 0, 0, 0, 200);
+    if (host || busy) {
+        const auto& players = S().Players();
+        int total = S().PlayerCount();
+        std::string head = "PLAYERS " + std::to_string(total) + " OF 8";
+        if (host && total < 2) {
+            head += "  - WAITING FOR MORE";
+        } else if (busy && S().GetPhase() == Phase::Lobby) {
+            head += "  - WAITING FOR THE HOST";
+        }
+        Text(x0 + 8, py + 13, head, TEXT_YELLOW, 0.5f);
+        int line = 0;
+        for (int i = 0; i < Netplay::kMaxPlayers; i++) {
+            if (!players[i].connected) {
+                continue;
+            }
+            std::string entry = std::to_string(line + 1) + " " + players[i].name;
+            if (players[i].localCount > 1) {
+                entry += " X" + std::to_string(players[i].localCount);
+            }
+            if (i == 0) {
+                entry += " HOST";
+            }
+            int col = line % 2, r = line / 2;
+            Text(x0 + 8 + col * 136, py + 26 + r * 11, entry, i == S().LocalSlot() ? TEXT_GREEN : TEXT_BLUE, 0.5f);
+            line++;
+        }
+    } else {
+        Text(x0 + 8, py + 13, "GAMES FOUND ON THIS NETWORK", TEXT_YELLOW, 0.5f);
+        const auto& games = sDiscovery.Games();
+        if (games.empty()) {
+            Text(x0 + 8, py + 27, "LOOKING... OR TYPE THE HOST ADDRESS ABOVE", TEXT_BLUE, 0.45f);
+        }
+        for (int i = 0; i < (int) games.size() && i < 4; i++) {
+            const auto& g = games[i];
+            int gy = py + 18 + i * 12;
+            bool sel = sState.listIndex == i;
+            if (sel) {
+                Box(x0 + 4, gy, x1 - 4, gy + 11, 255, 225, 74, 120);
+            }
+            std::string entry = g.name + "  " + g.advert + "  " + std::to_string(g.players) + " OF 8  " + g.address;
+            Text(x0 + 8, gy + 9, entry, sel ? TEXT_RED : TEXT_GREEN, 0.45f);
+        }
+    }
+
+    // Message / controls.
+    if (!sState.message.empty()) {
+        TextCentered(160, 218, sState.message, TEXT_RED, 0.45f);
+    }
+    std::string hint;
+    if (sState.edit == Edit::Name) {
+        hint = "UP DOWN LETTER   LEFT RIGHT MOVE   B DELETE   START DONE";
+    } else if (sState.edit != Edit::None) {
+        hint = "UP DOWN DIGIT   LEFT RIGHT MOVE   A DONE   B CANCEL";
+    } else if (host) {
+        hint = "UP DOWN CHOOSE   LEFT RIGHT CHANGE   A OK   B BACK   START RACE";
+    } else {
+        hint = "UP DOWN CHOOSE   A OK   B BACK   Z LOOK AGAIN";
+    }
+    TextCentered(160, 234, hint, TEXT_YELLOW, 0.42f);
+}
