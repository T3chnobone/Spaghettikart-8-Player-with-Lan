diff --git a/src/port/couch/CouchParty.cpp b/src/port/couch/CouchParty.cpp
index 1372804..2c50498 100644
--- a/src/port/couch/CouchParty.cpp
+++ b/src/port/couch/CouchParty.cpp
@@ -11,6 +11,7 @@
 
 #include <libultraship/libultraship.h>
 #include "port/netplay/NetplayCore.h"
+#include "port/localplay/LocalPlaySettings.h"
 
 extern "C" {
 #include "main.h"
@@ -535,6 +536,26 @@ extern "C" bool couch_select_active(void) {
     return gCouchParty && gGamestate < RACING && gMenuSelection == CHARACTER_SELECT_MENU;
 }
 
+extern "C" bool couch_portrait_spot(s32 playerIdx, s32* column, s32* row) {
+    int count = JoinedCount();
+    if (playerIdx < 0 || playerIdx >= count || count < 1) {
+        return false;
+    }
+    std::vector<LocalPlay::Rect> views = LocalPlay::CurrentLayout(count);
+    if (playerIdx >= (int) views.size()) {
+        return false;
+    }
+    // The views fill the window; the menus use the 320x240 picture inside it.
+    const LocalPlay::Rect& v = views[playerIdx];
+    const float kW = 320.0f, kH = 240.0f;
+    const int kPortraitW = 64, kPortraitH = 76;
+    int x = (int) ((v.x + v.w * 0.5f) * kW) - kPortraitW / 2;
+    int y = (int) ((v.y + v.h * 0.5f) * kH) - kPortraitH / 2;
+    *column = std::clamp(x, 0, (int) kW - kPortraitW);
+    *row = std::clamp(y, 0, (int) kH - kPortraitH);
+    return true;
+}
+
 extern "C" bool couch_select_can_finish(void) {
     return !couch_select_active() || JoinedCount() >= 2;
 }
