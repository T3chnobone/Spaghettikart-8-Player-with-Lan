+// Where a picked character's portrait goes once everyone has picked. Stock:
+// the 1-4 player spots. Couch Party: where that player's view will be on the
+// split screen, so everyone can see where they'll be racing.
+static Unk_D_800E70A0* couch_or_stock_portrait_spot(s32 playerIdx) {
+    static Unk_D_800E70A0 sSpot;
+    s32 column;
+    s32 row;
+
+    if (gCouchParty && couch_portrait_spot(playerIdx, &column, &row)) {
+        sSpot.column = (s16) column;
+        sSpot.row = (s16) row;
+        return &sSpot;
+    }
+    return &D_800E7188[(gScreenModeSelection * 4) + (playerIdx & 3)];
+}
