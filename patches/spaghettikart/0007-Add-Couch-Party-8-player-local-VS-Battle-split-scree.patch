+        } else {
+            spawn_player(&gPlayers[k], k, x, z, height, 32768.0f, k & 7, PLAYER_START_SEQUENCE | PLAYER_CPU);
+        }
+    }
+    D_80164A28 = 0;
+    func_80039AE4();
