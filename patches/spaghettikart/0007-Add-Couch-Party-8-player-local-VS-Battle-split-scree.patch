+#pragma once
+
+// C++ side of Couch Party (see couch.h), shared with the lobby and results UI.
+
+#include <array>
+#include <cstdint>
+#include <vector>
+
+namespace Couch {
+
+constexpr int kMaxPlayers = 8;
+
+struct Slot {
+    bool joined = false;
+    int port = -1;      // controller port (0-based) this player uses
+    int character = 0;  // 0..7
+    bool ready = false;
+};
+
+struct Lobby {
+    bool active = false;                // the lobby is on screen
+    std::array<Slot, kMaxPlayers> slots; // P1..P8, joined players first
+    int JoinedCount() const;
+    bool AllReady() const;
+    bool CanStart() const;
+};
+
+struct Standing {
+    int player = 0;    // 0-based player number
+    int character = 0;
+    bool finished = false; // VS: crossed the line; Battle: survived
+};
+
+enum ResultOption { kRaceAgain, kChangeCourse, kChangeDrivers, kQuit, kNumResultOptions };
+
+struct Results {
+    bool active = false;
+    bool battle = false;
+    std::vector<Standing> order; // 1st place first
+    int cursor = 0;
+};
+
+Lobby& GetLobby();
+Results& GetResults();
+// 1st places this session (reset when the couch party is left).
+int Wins(int player);
+bool IsBattle();
+const char* CharacterName(int character);
+bool UniqueCharacters();
+
+// Actions (also used by mouse/keyboard in the UI).
+void StartRace();
+void LeaveLobby();
+void ChooseResult(int option);
+void CycleCharacter(int slot, int dir);
+
+} // namespace Couch
diff --git a/src/port/couch/couch.h b/src/port/couch/couch.h
new file mode 100644
index 0000000..07055fb
--- /dev/null
+++ b/src/port/couch/couch.h
@@ -0,0 +1,55 @@
+#ifndef SPAGHETTI_COUCH_H
+#define SPAGHETTI_COUCH_H
+
+// Couch Party: VS races and Battles for up to 8 players on one PC.
+//
+// The main menu's third column ("COUCH PARTY", replacing 3P and 4P) offers VS
+// and Battle. The character screen becomes a lobby where each controller
+// presses A to join and picks a character. The race itself is a single-screen
+// (1P) race in VS or Battle mode with every joined player switched to human,
+// drawn with one view per player using the Local Multiplayer split-screen
+// settings (localplay/), the same way the 8-player Grand Prix is.
+
+#include <libultraship.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define COUCH_MAX_PLAYERS 8
+// The main menu column the couch party uses (gPlayerCount while on the menus).
+#define COUCH_MENU_PLAYER_COUNT 3
+
+// 1 while the menus are on the Couch Party column (and through its races).
+extern s32 gCouchParty;
+
+// Couch Party replaces 3P/4P (off during LAN netplay, or if turned off in the
+// settings).
+bool couch_enabled(void);
+// True while a couch VS or Battle race is set up / running.
+bool couch_race_active(void);
+// Human players in the couch race.
+s32 couch_player_count(void);
+// The couch race's player count when one is active, otherwise `stock`.
+s32 couch_count_or(s32 stock);
+// True when the couch party owns the big-race settings (localplay must not touch them).
+bool couch_owns_big_race(void);
+
+// Hooks.
+void couch_menu_tick(void);                // every frame (Game.cpp)
+void couch_filter_pads(OSContPad* pads);   // read_controllers: lobby/results input, controller order
+void couch_on_setup_race(void);            // setup_race(), after gPlayerCountSelection1 is set
+void couch_on_load_menu(s32 menuSelection); // load_menu_states()
+// A human crossed the line on the last lap in VS. Returns true when the race
+// is over (every player but one has finished).
+bool couch_versus_finished(s32 playerId);
+void couch_battle_eliminated(s32 playerId);
+// The race-over pause has run out: show the results (instead of the stock zoom).
+void couch_on_race_over(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
