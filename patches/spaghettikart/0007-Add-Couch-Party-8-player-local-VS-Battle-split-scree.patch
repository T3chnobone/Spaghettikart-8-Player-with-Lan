+struct PadEdge {
+    uint16_t buttons = 0;
+    int8_t dirX = 0, dirY = 0;
+    int repeat = 0;
+};
+std::array<PadEdge, MAXCONTROLLERS> sEdges;
+
+const char* const kNames[8] = { "Mario", "Luigi", "Yoshi", "Toad", "Donkey Kong", "Wario", "Peach", "Bowser" };
+
+struct PadInput {
+    uint16_t pressed = 0;
+    int dirX = 0; // -1/0/1 on a new press or auto-repeat
+    int dirY = 0;
+};
+
+PadInput ReadEdge(int port, const OSContPad& pad) {
+    PadEdge& e = sEdges[port];
+    uint16_t held = (uint16_t) pad.button;
+    int8_t dirX = (held & R_JPAD) || pad.stick_x > 50 ? 1 : ((held & L_JPAD) || pad.stick_x < -50 ? -1 : 0);
+    int8_t dirY = (held & U_JPAD) || pad.stick_y > 50 ? 1 : ((held & D_JPAD) || pad.stick_y < -50 ? -1 : 0);
+    PadInput in;
+    in.pressed = held & ~e.buttons;
+    bool fresh = dirX != e.dirX || dirY != e.dirY;
+    if (fresh) {
+        e.repeat = 20;
+    } else if ((dirX != 0 || dirY != 0) && --e.repeat <= 0) {
+        e.repeat = 6;
+        fresh = true;
+    }
+    if (fresh) {
+        in.dirX = dirX;
+        in.dirY = dirY;
+    }
+    e.buttons = held;
+    e.dirX = dirX;
+    e.dirY = dirY;
+    return in;
+}
+
+void ClearEdges() {
+    for (auto& e : sEdges) {
+        e = PadEdge{};
+    }
+    sPrimeEdges = true;
+}
+
+// Records what's held without acting on it.
+void PrimeEdges(const OSContPad* pads) {
+    for (int port = 0; port < MAXCONTROLLERS; port++) {
+        ReadEdge(port, pads[port]);
+    }
+    sPrimeEdges = false;
+}
+
+bool CharacterTaken(int character, int exceptSlot) {
+    if (!UniqueCharacters()) {
+        return false;
+    }
+    for (int i = 0; i < kMaxPlayers; i++) {
+        if (i != exceptSlot && sLobby.slots[i].joined && sLobby.slots[i].character == character) {
+            return true;
+        }
+    }
+    return false;
+}
+
+int SlotForPort(int port) {
+    for (int i = 0; i < kMaxPlayers; i++) {
+        if (sLobby.slots[i].joined && sLobby.slots[i].port == port) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+void Join(int port) {
+    for (int i = 0; i < kMaxPlayers; i++) {
+        Slot& s = sLobby.slots[i];
+        if (s.joined) {
+            continue;
+        }
+        s = Slot{};
+        s.joined = true;
+        s.port = port;
+        s.character = i;
+        if (CharacterTaken(s.character, i)) {
+            for (int c = 0; c < 8; c++) {
+                if (!CharacterTaken(c, i)) {
+                    s.character = c;
+                    break;
+                }
+            }
+        }
+        play_sound2(SOUND_MENU_SELECT);
+        return;
+    }
+}
+
+// Removes a player; the ones after move up so joined players stay P1..PN.
+void Leave(int slot) {
+    for (int i = slot; i < kMaxPlayers - 1; i++) {
+        sLobby.slots[i] = sLobby.slots[i + 1];
+    }
+    sLobby.slots[kMaxPlayers - 1] = Slot{};
+    play_sound2(SOUND_MENU_GO_BACK);
+}
+
+void ReleaseBigRace() {
+    if (sOwnsBigRace) {
+        gNetBigRace = 0;
+        gNetLocalViews = 0;
+        gNetHumanCount = 0;
+        sOwnsBigRace = false;
+    }
+}
+
+void CouchOff() {
+    gCouchParty = 0;
+    ReleaseBigRace();
+    sCommitted = false;
+    sCount = 0;
+    sLobby = Lobby{};
+    sResults = Results{};
+    sWins.fill(0);
+    GameUI::ShowCouchLobby(false);
+    GameUI::ShowCouchResults(false);
+}
+
+// Puts the roster into the big-race settings used by the race code.
+void ApplyRoster() {
+    gNetBigRace = 1;
+    gNetLocalViews = 1;
+    gNetHumanCount = sCount;
+    gNetViewPlayer = 0;
+    for (int k = 0; k < NETRACE_MAX_HUMANS; k++) {
+        gNetCharacters[k] = (s8) (k < sCount ? sCharacters[k] : k);
+    }
+    gCharacterSelections[0] = (s8) sCharacters[0];
+    sOwnsBigRace = true;
+}
+
+void LobbyInput(const OSContPad* pads) {
+    bool anyoneJoined = sLobby.JoinedCount() > 0;
+    for (int port = 0; port < MAXCONTROLLERS; port++) {
+        PadInput in = ReadEdge(port, pads[port]);
+        int slot = SlotForPort(port);
+        if (slot < 0) {
+            if (in.pressed & (A_BUTTON | START_BUTTON)) {
+                Join(port);
+            } else if ((in.pressed & B_BUTTON) && !anyoneJoined) {
+                sPending = Pending::Back;
+            }
+            continue;
+        }
+        Slot& s = sLobby.slots[slot];
+        if (in.pressed & START_BUTTON) {
+            if (sLobby.CanStart()) {
+                sPending = Pending::Start;
+            } else if (!s.ready) {
+                s.ready = true;
+                play_sound2(SOUND_MENU_SELECT);
+            }
+            continue;
+        }
+        if (in.pressed & B_BUTTON) {
+            if (s.ready) {
+                s.ready = false;
+                play_sound2(SOUND_MENU_GO_BACK);
+            } else {
+                Leave(slot);
+            }
+            continue;
+        }
+        if (in.pressed & A_BUTTON) {
+            if (!s.ready) {
+                s.ready = true;
+                func_800C90F4(0, 0x2900800e + (s.character << 4)); // the character's voice
+            } else if (sLobby.CanStart()) {
+                sPending = Pending::Start;
+            }
+            continue;
+        }
+        if (!s.ready && in.dirX != 0) {
+            CycleCharacter(slot, in.dirX);
+        }
+    }
+}
+
+void ResultsInput(const OSContPad* pads) {
+    for (int p = 0; p < sCount; p++) {
+        PadInput in = ReadEdge(p, pads[p]);
+        if (in.dirY > 0 && sResults.cursor > 0) {
+            sResults.cursor--;
+            play_sound2(SOUND_MENU_CURSOR_MOVE);
+        } else if (in.dirY < 0 && sResults.cursor < kNumResultOptions - 1) {
+            sResults.cursor++;
+            play_sound2(SOUND_MENU_CURSOR_MOVE);
+        }
+        if (in.pressed & (A_BUTTON | START_BUTTON)) {
+            ChooseResult(sResults.cursor);
+            return;
+        }
+    }
+}
+
+void RunPending() {
+    Pending action = sPending;
+    sPending = Pending::None;
+    switch (action) {
+        case Pending::None:
+            break;
+        case Pending::Start:
+            if (!sLobby.active || !sLobby.CanStart() || is_screen_being_faded()) {
+                break;
+            }
+            sCount = sLobby.JoinedCount();
+            for (int k = 0; k < kMaxPlayers; k++) {
+                sPorts[k] = k < sCount ? sLobby.slots[k].port : k;
+                sCharacters[k] = k < sCount ? sLobby.slots[k].character : k;
+            }
+            sCommitted = true;
+            ApplyRoster();
+            sLeavingLobby = true;
+            sLobby.active = false;
+            GameUI::ShowCouchLobby(false);
+            ClearEdges();
+            func_8009E1C0(); // on to the course select
+            play_sound2(SOUND_MENU_OK_CLICKED);
+            break;
+        case Pending::Back:
+            if (!sLobby.active || is_screen_being_faded()) {
+                break;
+            }
+            sLeavingLobby = true;
+            sLobby.active = false;
+            GameUI::ShowCouchLobby(false);
+            func_8009E208(); // back to the main menu
+            play_sound2(SOUND_MENU_GO_BACK);
+            break;
+        case Pending::Result:
+            if (!sResults.active) {
+                break;
+            }
+            sResults.active = false;
+            GameUI::ShowCouchResults(false);
+            switch (sPendingResult) {
+                case kRaceAgain:
+                    func_802903B0();
+                    break;
+                case kChangeCourse:
+                    func_80290388();
+                    break;
+                case kChangeDrivers:
+                    func_80290360();
+                    break;
+                default:
+                    func_80290338();
+                    break;
+            }
+            play_sound2(SOUND_MENU_OK_CLICKED);
+            break;
+    }
+}
+
+} // namespace
+
+int Lobby::JoinedCount() const {
+    int n = 0;
+    for (const Slot& s : slots) {
+        n += s.joined ? 1 : 0;
+    }
+    return n;
+}
+
+bool Lobby::AllReady() const {
+    for (const Slot& s : slots) {
+        if (s.joined && !s.ready) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool Lobby::CanStart() const {
+    return JoinedCount() >= 2 && AllReady();
+}
+
+Lobby& GetLobby() {
+    return sLobby;
+}
+
+Results& GetResults() {
+    return sResults;
+}
+
+int Wins(int player) {
+    return (player >= 0 && player < kMaxPlayers) ? sWins[player] : 0;
+}
+
+bool IsBattle() {
+    return gModeSelection == BATTLE;
+}
+
+const char* CharacterName(int character) {
+    return kNames[character & 7];
+}
+
+bool UniqueCharacters() {
+    return CVarGetInteger("gUniqueCharacterSelections", true) != 0;
+}
+
+void StartRace() {
+    sPending = Pending::Start;
+}
+
+void LeaveLobby() {
+    sPending = Pending::Back;
+}
+
+void ChooseResult(int option) {
+    sPendingResult = std::clamp(option, 0, kNumResultOptions - 1);
+    sPending = Pending::Result;
+}
+
+void CycleCharacter(int slot, int dir) {
+    if (slot < 0 || slot >= kMaxPlayers || !sLobby.slots[slot].joined) {
+        return;
+    }
+    Slot& s = sLobby.slots[slot];
+    int c = s.character;
+    for (int tries = 0; tries < 8; tries++) {
+        c = (c + (dir > 0 ? 1 : 7)) & 7;
+        if (!CharacterTaken(c, slot)) {
+            s.character = c;
+            play_sound2(SOUND_MENU_CURSOR_MOVE);
+            return;
+        }
+    }
+}
+
+} // namespace Couch
+
+using namespace Couch;
+
+// ------------------------------------------------------------------ C API
+
+extern "C" bool couch_enabled(void) {
+    return CVarGetInteger("gCouchParty.Disabled", 0) == 0 && Netplay::Get().GetRole() == Netplay::Role::None;
+}
+
+extern "C" bool couch_race_active(void) {
+    return gCouchParty && sCommitted && netrace_active();
+}
+
+extern "C" s32 couch_player_count(void) {
+    return sCount;
+}
+
+extern "C" s32 couch_count_or(s32 stock) {
+    return couch_race_active() ? sCount : stock;
+}
+
+extern "C" bool couch_owns_big_race(void) {
+    return sOwnsBigRace;
+}
+
+extern "C" void couch_menu_tick(void) {
+    if (sWasCouch && !gCouchParty) {
+        CouchOff();
+    }
+    if (gCouchParty && !couch_enabled()) {
+        CouchOff(); // a netplay session started
+    }
+    sWasCouch = gCouchParty != 0;
+    if (!gCouchParty) {
+        return;
+    }
+
+    bool onMenus = gGamestate < RACING;
+    bool lobby = onMenus && gMenuSelection == CHARACTER_SELECT_MENU;
+    if (!lobby) {
+        sLeavingLobby = false;
+    }
+    if (lobby && !sLobby.active && !sLeavingLobby) {
+        // Coming from the main menu: a fresh roster. From "change drivers":
+        // keep everyone, but they ready up again.
+        if (!sCommitted) {
+            sLobby = Lobby{};
+        }
+        for (Slot& s : sLobby.slots) {
+            s.ready = false;
+        }
+        sLobby.active = true;
+        sCommitted = false;
+        ClearEdges();
+        GameUI::ShowCouchLobby(true);
+    } else if (!lobby && sLobby.active) {
+        sLobby.active = false;
+        GameUI::ShowCouchLobby(false);
+    }
+    if (sResults.active && gGamestate != RACING) {
+        sResults.active = false;
+        GameUI::ShowCouchResults(false);
+    }
+    // Closed with the window's X: they're needed to carry on, so back they come.
+    if (sLobby.active) {
+        GameUI::ShowCouchLobby(true);
+    }
+    if (sResults.active) {
+        GameUI::ShowCouchResults(true);
+    }
+    RunPending();
+}
+
+extern "C" void couch_filter_pads(OSContPad* pads) {
+    if (!gCouchParty) {
+        return;
+    }
+    if (sLobby.active) {
+        if (sPrimeEdges || is_screen_being_faded()) {
+            PrimeEdges(pads); // fading in: just track what's held
+        } else {
+            LobbyInput(pads);
+        }
+        std::memset(pads, 0, sizeof(OSContPad) * MAXCONTROLLERS);
+        return;
+    }
+    if (!sCommitted) {
+        return;
+    }
+    // Player k drives with the controller they joined with.
+    OSContPad raw[MAXCONTROLLERS];
+    std::memcpy(raw, pads, sizeof(raw));
+    for (int k = 0; k < MAXCONTROLLERS; k++) {
+        if (k < sCount && sPorts[k] >= 0 && sPorts[k] < MAXCONTROLLERS) {
+            pads[k] = raw[sPorts[k]];
+        } else {
+            std::memset(&pads[k], 0, sizeof(OSContPad));
+        }
+    }
+    if (sResults.active) {
+        if (sPrimeEdges) {
+            PrimeEdges(pads);
+        } else {
+            ResultsInput(pads);
+        }
+        std::memset(pads, 0, sizeof(OSContPad) * MAXCONTROLLERS);
+    }
+}
+
+extern "C" void couch_on_setup_race(void) {
+    if (!gCouchParty || !sCommitted || sCount < 2) {
+        return;
+    }
+    gPlayerCount = 1;
+    gPlayerCountSelection1 = 1;
+    gScreenModeSelection = SCREEN_MODE_1P;
+    ApplyRoster();
+    sFinishOrder.clear();
+    sEliminated.clear();
+    sResults = Results{};
+    GameUI::ShowCouchResults(false);
+}
+
+extern "C" void couch_on_load_menu(s32 menuSelection) {
+    if (!gCouchParty) {
+        return;
+    }
+    switch (menuSelection) {
+        case MAIN_MENU:
+        case CHARACTER_SELECT_MENU:
+        case COURSE_SELECT_MENU:
+            // Back on the menus: the couch column again (races run as 1P).
+            gPlayerCount = COUCH_MENU_PLAYER_COUNT;
+            gPlayerCountSelection1 = COUCH_MENU_PLAYER_COUNT;
+            gScreenModeSelection = SCREEN_MODE_3P_4P_SPLITSCREEN;
+            break;
+        default:
+            CouchOff();
+            break;
+    }
+}
+
+extern "C" bool couch_versus_finished(s32 playerId) {
+    if (std::find(sFinishOrder.begin(), sFinishOrder.end(), playerId) == sFinishOrder.end()) {
+        sFinishOrder.push_back(playerId);
+    }
+    return (int) sFinishOrder.size() >= sCount - 1;
+}
+
+extern "C" void couch_battle_eliminated(s32 playerId) {
+    if (std::find(sEliminated.begin(), sEliminated.end(), playerId) == sEliminated.end()) {
+        sEliminated.push_back(playerId);
+    }
+}
+
+extern "C" void couch_on_race_over(void) {
+    Results r;
+    r.active = true;
+    r.battle = gModeSelection == BATTLE;
+    std::vector<int> order;
+    if (r.battle) {
+        if (std::find(sEliminated.begin(), sEliminated.end(), gPlayerWinningIndex) == sEliminated.end()) {
+            order.push_back(gPlayerWinningIndex);
+        }
+        // Still in when the battle ended, then the last one out first.
+        for (int k = 0; k < sCount; k++) {
+            if (std::find(order.begin(), order.end(), k) == order.end() &&
+                std::find(sEliminated.begin(), sEliminated.end(), k) == sEliminated.end()) {
+                order.push_back(k);
+            }
+        }
+        for (auto it = sEliminated.rbegin(); it != sEliminated.rend(); ++it) {
+            order.push_back(*it);
+        }
+    } else {
+        order = sFinishOrder;
+        std::vector<int> rest;
+        for (int k = 0; k < sCount; k++) {
+            if (std::find(order.begin(), order.end(), k) == order.end()) {
+                rest.push_back(k);
+            }
+        }
+        std::sort(rest.begin(), rest.end(),
+                  [](int a, int b) { return gGPCurrentRaceRankByPlayerId[a] < gGPCurrentRaceRankByPlayerId[b]; });
+        order.insert(order.end(), rest.begin(), rest.end());
+    }
+    for (size_t i = 0; i < order.size(); i++) {
+        int k = order[i];
+        if (k < 0 || k >= sCount) {
+            continue;
+        }
+        bool finished = r.battle ? (i == 0) : (std::find(sFinishOrder.begin(), sFinishOrder.end(), k) !=
+                                                sFinishOrder.end());
+        r.order.push_back({ k, sCharacters[k], finished });
+    }
+    if (!r.order.empty()) {
+        sWins[r.order[0].player]++;
+    }
+    sResults = r;
+    ClearEdges();
+    GameUI::ShowCouchResults(true);
+}
diff --git a/src/port/couch/CouchParty.h b/src/port/couch/CouchParty.h
