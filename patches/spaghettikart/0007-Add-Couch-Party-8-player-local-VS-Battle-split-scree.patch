+void spawn_players_couch_battle(void) {
+    // Spot order and facing as in the 4-player battle.
+    static const f32 sDirX[4] = { 0.0f, 0.0f, -1.0f, 1.0f };
+    static const f32 sDirZ[4] = { 1.0f, -1.0f, 0.0f, 0.0f };
+    static const f32 sFacing[4] = { 32768.0f, 0.0f, -16384.0f, 16384.0f };
+    static const f32 sFacingDonut[4] = { -16384.0f, 16384.0f, 0.0f, 32768.0f };
+    f32 distance;
+    f32 height;
+    s32 k;
+    s32 humans = couch_player_count();
+
+    if (IsBlockFort()) {
+        distance = 200.0f;
+        height = 5.0f;
+    } else if (IsSkyscraper()) {
+        distance = 400.0f;
+        height = 480.0f;
+    } else if (IsDoubleDeck()) {
+        distance = 160.0f;
+        height = 55.0f;
+    } else if (IsBigDonut()) {
+        distance = 575.0f;
+        height = 200.0f;
+    } else {
+        distance = 200.0f; // a custom arena
+        height = 50.0f;
+    }
+    for (k = 0; k < NUM_PLAYERS; k++) {
+        s32 spot = k % 4;
+        f32 x = sDirX[spot] * distance;
+        f32 z = sDirZ[spot] * distance;
+        f32 facing = IsBigDonut() ? sFacingDonut[spot] : sFacing[spot];
+        if (k >= 4) {
+            // Sideways from the spot (across the line to the arena's centre).
+            x += sDirZ[spot] != 0.0f ? 40.0f : 0.0f;
+            z += sDirX[spot] != 0.0f ? 40.0f : 0.0f;
