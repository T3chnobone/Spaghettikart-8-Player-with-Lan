+// Couch Party: covers the "3P" picture at the top of the third main menu
+// column with the mode's name. The VS / BATTLE rows below are kept.
+void draw_couch_party_column_title(MenuItem* arg0) {
+    s32 x = arg0->column;
+    s32 y = arg0->row;
+    s32 alpha = 255;
+
+    if ((arg0->state == 1) || (arg0->state == 4)) {
+        // Fading in or out with the other columns.
+        alpha = arg0->param1 * 8;
+        if (alpha > 255) {
+            alpha = 255;
+        }
+        if (alpha < 0) {
+            alpha = 0;
+        }
+    }
+    gDisplayListHead = draw_box_fill(gDisplayListHead, x + 3, y + 3, x + 60, y + 50, 20, 30, 70, alpha);
