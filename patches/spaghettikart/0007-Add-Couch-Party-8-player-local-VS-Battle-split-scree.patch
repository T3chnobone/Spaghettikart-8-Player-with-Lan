--- a/src/port/localplay/ViewLayout.cpp
+++ b/src/port/localplay/ViewLayout.cpp
@@ -53,8 +53,32 @@ void ChooseGrid(int count, float areaAspect, float targetAspect, int& cols, int&
     }
 }
 
+void GridForStyle(SplitStyle style, int count, float areaAspect, float targetAspect, int& cols, int& rows) {
+    count = std::max(count, 1);
+    switch (style) {
+        case SplitStyle::SideBySide:
+            cols = count;
+            rows = 1;
+            break;
+        case SplitStyle::Stacked:
+            cols = 1;
+            rows = count;
+            break;
+        case SplitStyle::TwoRows:
+            rows = count >= 3 ? 2 : 1;
+            cols = (count + rows - 1) / rows;
+            if (areaAspect < 1.0f) {
