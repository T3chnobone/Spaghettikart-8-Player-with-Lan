diff --git a/src/port/ui/CouchWindow.cpp b/src/port/ui/CouchWindow.cpp
new file mode 100644
index 0000000..70cf848
--- /dev/null
+++ b/src/port/ui/CouchWindow.cpp
@@ -0,0 +1,256 @@
+#include "CouchWindow.h"
+
+#include <imgui.h>
+#include <algorithm>
+#include <memory>
+#include <string>
+
+#include "ship/Context.h"
+#include "ship/window/gui/Gui.h"
+#include "LocalPlayWindow.h"
+#include "port/couch/CouchParty.h"
+#include "port/localplay/LocalPlaySettings.h"
+
+extern "C" {
+#include "main.h"
+#include <defines.h>
+}
+
+namespace GameUI {
+
+namespace {
+
+const char* const kLobbyName = "Couch Party";
+const char* const kResultsName = "Couch Party Results";
+const ImVec4 kGold(1.0f, 0.84f, 0.2f, 1.0f);
+const ImVec4 kGreen(0.45f, 0.9f, 0.45f, 1.0f);
+const ImVec4 kGrey(0.65f, 0.65f, 0.65f, 1.0f);
+
+// One colour per player, as on the stock character screen and beyond.
+const ImU32 kPlayerColors[Couch::kMaxPlayers] = {
+    IM_COL32(230, 60, 60, 255),  IM_COL32(60, 110, 230, 255), IM_COL32(240, 200, 40, 255),
+    IM_COL32(60, 190, 80, 255),  IM_COL32(240, 130, 40, 255), IM_COL32(170, 80, 220, 255),
+    IM_COL32(40, 200, 210, 255), IM_COL32(230, 100, 180, 255),
+};
+
+std::shared_ptr<Ship::GuiWindow> Find(const char* name) {
+    auto* ctx = Ship::Context::GetRawInstance();
+    if (!ctx || !ctx->GetWindow() || !ctx->GetWindow()->GetGui()) {
+        return nullptr;
+    }
+    return ctx->GetWindow()->GetGui()->GetGuiWindow(name);
+}
+
+void SetShown(const char* name, bool show) {
+    auto window = Find(name);
+    if (!window) {
+        return;
+    }
+    if (show && !window->IsVisible()) {
+        window->Show();
+    } else if (!show && window->IsVisible()) {
+        window->Hide();
+    }
+}
+
+std::string Ordinal(size_t n) {
+    const char* suffix = "th";
+    if (n % 100 < 11 || n % 100 > 13) {
+        suffix = n % 10 == 1 ? "st" : n % 10 == 2 ? "nd" : n % 10 == 3 ? "rd" : "th";
+    }
+    return std::to_string(n) + suffix;
+}
+
+std::string ModeLine() {
+    if (Couch::IsBattle()) {
+        return "BATTLE";
+    }
+    static const char* kCC[] = { "50cc", "100cc", "150cc", "Extra" };
+    return std::string("VS  ") + kCC[std::clamp<int>(gCCSelection, 0, 3)];
+}
+
+void CenterOnAppear(float widthFrac, float heightFrac) {
+    ImVec2 vp = ImGui::GetMainViewport()->Size;
+    ImVec2 center = ImGui::GetMainViewport()->GetCenter();
+    ImVec2 size(std::max(560.0f, vp.x * widthFrac), std::max(380.0f, vp.y * heightFrac));
+    ImGui::SetWindowSize(size, ImGuiCond_Appearing);
+    ImGui::SetWindowPos(ImVec2(center.x - size.x / 2, center.y - size.y / 2), ImGuiCond_Appearing);
+}
+
+// A player's tile in the lobby grid.
+void DrawSlot(int index, const Couch::Slot& slot, ImVec2 a, ImVec2 b) {
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+    const float font = ImGui::GetFontSize();
+    ImU32 color = kPlayerColors[index];
+    dl->AddRectFilled(a, b, slot.joined ? IM_COL32(35, 40, 55, 255) : IM_COL32(28, 28, 28, 255), 8.0f);
+    dl->AddRect(a, b, slot.joined ? color : IM_COL32(80, 80, 80, 255), 8.0f, 0, slot.ready ? 4.0f : 2.0f);
+
+    std::string tag = "P" + std::to_string(index + 1);
+    dl->AddText(nullptr, font * 1.6f, ImVec2(a.x + 10, a.y + 8), slot.joined ? color : IM_COL32(110, 110, 110, 255),
+                tag.c_str());
+
+    auto centered = [&](float y, float size, ImU32 col, const std::string& text) {
+        ImVec2 ts = ImGui::GetFont()->CalcTextSizeA(size, FLT_MAX, 0.0f, text.c_str());
+        dl->AddText(nullptr, size, ImVec2((a.x + b.x - ts.x) / 2, y), col, text.c_str());
+    };
+    float h = b.y - a.y;
+    if (!slot.joined) {
+        centered(a.y + h * 0.45f, font * 1.1f, IM_COL32(150, 150, 150, 255), "Press A to join");
+        return;
+    }
+    std::string name = Couch::CharacterName(slot.character);
+    centered(a.y + h * 0.36f, font * 1.5f, IM_COL32(255, 255, 255, 255),
+             slot.ready ? name : "<  " + name + "  >");
+    std::string pad = "Controller " + std::to_string(slot.port + 1);
+    centered(a.y + h * 0.62f, font * 0.95f, IM_COL32(170, 170, 170, 255), pad);
+    if (slot.ready) {
+        centered(a.y + h * 0.78f, font * 1.2f, IM_COL32(110, 230, 110, 255), "READY!");
+    } else {
+        centered(a.y + h * 0.78f, font * 0.95f, IM_COL32(200, 200, 120, 255), "A = ready   B = leave");
+    }
+}
+
+} // namespace
+
+void ShowCouchLobby(bool show) {
+    SetShown(kLobbyName, show);
+}
+
+void ShowCouchResults(bool show) {
+    SetShown(kResultsName, show);
+}
+
+// ------------------------------------------------------------------ lobby
+
+void CouchLobbyWindow::DrawElement() {
+    Couch::Lobby& lobby = Couch::GetLobby();
+    CenterOnAppear(0.8f, 0.78f);
+    if (!lobby.active) {
+        ImGui::TextColored(kGrey, "Choose COUCH PARTY on the main menu to open the lobby.");
+        return;
+    }
+
+    ImGui::SetWindowFontScale(1.25f);
+    ImGui::TextColored(kGold, "COUCH PARTY - %s", ModeLine().c_str());
+    ImGui::SameLine();
+    int joined = lobby.JoinedCount();
+    ImGui::TextColored(kGrey, "   %d / %d players", joined, Couch::kMaxPlayers);
+    ImGui::SetWindowFontScale(1.0f);
+    ImGui::Separator();
+
+    // 4 x 2 grid of player tiles.
+    ImVec2 avail = ImGui::GetContentRegionAvail();
+    float footer = ImGui::GetFrameHeightWithSpacing() * 4.5f + 90.0f;
+    float gap = 10.0f;
+    float tileW = (avail.x - gap * 3) / 4;
+    float tileH = std::max(90.0f, (avail.y - footer - gap) / 2);
+    ImVec2 origin = ImGui::GetCursorScreenPos();
+    for (int i = 0; i < Couch::kMaxPlayers; i++) {
+        int col = i % 4, row = i / 4;
+        ImVec2 a(origin.x + col * (tileW + gap), origin.y + row * (tileH + gap));
+        ImVec2 b(a.x + tileW, a.y + tileH);
+        DrawSlot(i, lobby.slots[i], a, b);
+        // Mouse: click a joined tile to change character.
+        ImGui::SetCursorScreenPos(a);
+        ImGui::PushID(i);
+        if (ImGui::InvisibleButton("##tile", ImVec2(tileW, tileH), ImGuiButtonFlags_MouseButtonLeft |
+                                                                        ImGuiButtonFlags_MouseButtonRight) &&
+            lobby.slots[i].joined && !lobby.slots[i].ready) {
+            Couch::CycleCharacter(i, ImGui::IsMouseReleased(ImGuiMouseButton_Right) ? -1 : 1);
+        }
+        ImGui::PopID();
+    }
+    ImGui::SetCursorScreenPos(ImVec2(origin.x, origin.y + tileH * 2 + gap * 2));
+
+    // Status and how to start.
+    if (joined < 2) {
+        ImGui::TextColored(kGrey, "Each player presses A on their controller to join (2 to 8 players).");
+    } else if (!lobby.AllReady()) {
+        ImGui::TextColored(kGrey, "Left/Right picks a character, A when you're ready.");
+    } else {
+        ImGui::TextColored(kGreen, "Everyone's ready - press START!");
+    }
+    ImGui::TextColored(kGrey, "B leaves (B with nobody joined goes back). START goes on to the course select.");
+
+    ImGui::Spacing();
+    ImGui::SeparatorText("Split screen");
+    ImGui::SetNextItemWidth(220.0f);
+    SplitStyleCombo("##split");
+    ImGui::SameLine();
+    ImGui::TextColored(kGrey, "%s", LocalPlay::SpanMonitors() ? "Spanning the ticked monitors"
+                                                               : "One window (Settings > Local Multiplayer for monitors)");
+    DrawSplitPreview(std::max(joined, 2), 70.0f);
+
+    ImGui::Spacing();
+    ImGui::BeginDisabled(!lobby.CanStart());
+    if (ImGui::Button("Start")) {
+        Couch::StartRace();
+    }
+    ImGui::EndDisabled();
+    ImGui::SameLine();
+    if (ImGui::Button("Back")) {
+        Couch::LeaveLobby();
+    }
+}
+
+// ---------------------------------------------------------------- results
+
+void CouchResultsWindow::DrawElement() {
+    Couch::Results& r = Couch::GetResults();
+    if (ImGui::IsWindowAppearing()) {
+        ImVec2 center = ImGui::GetMainViewport()->GetCenter();
+        ImGui::SetWindowPos(ImVec2(center.x - 210, center.y - 200));
+    }
+    if (!r.active) {
+        ImGui::TextColored(kGrey, "No results yet.");
+        return;
+    }
+    ImGui::SetWindowFontScale(1.3f);
+    ImGui::TextColored(kGold, "%s", r.battle ? "BATTLE RESULTS" : "VS RESULTS");
+    ImGui::SetWindowFontScale(1.0f);
+    ImGui::Separator();
+
+    if (ImGui::BeginTable("##standings", 4, ImGuiTableFlags_RowBg | ImGuiTableFlags_SizingFixedFit)) {
+        ImGui::TableSetupColumn("Place");
+        ImGui::TableSetupColumn("Player");
+        ImGui::TableSetupColumn("Driver", ImGuiTableColumnFlags_WidthStretch);
+        ImGui::TableSetupColumn("Wins");
+        ImGui::TableHeadersRow();
+        for (size_t i = 0; i < r.order.size(); i++) {
+            const Couch::Standing& s = r.order[i];
+            ImGui::TableNextRow();
+            ImGui::TableNextColumn();
+            if (i == 0) {
+                ImGui::TextColored(kGold, "%s", r.battle ? "WINNER" : "1st");
+            } else if (r.battle) {
+                ImGui::Text("%s", Ordinal(i + 1).c_str());
+            } else {
+                ImGui::Text("%s%s", Ordinal(i + 1).c_str(), s.finished ? "" : " *");
+            }
+            ImGui::TableNextColumn();
+            ImGui::TextColored(ImGui::ColorConvertU32ToFloat4(kPlayerColors[s.player & 7]), "P%d", s.player + 1);
+            ImGui::TableNextColumn();
+            ImGui::TextUnformatted(Couch::CharacterName(s.character));
+            ImGui::TableNextColumn();
+            ImGui::Text("%d", Couch::Wins(s.player));
+        }
+        ImGui::EndTable();
+    }
+    if (!r.battle) {
+        ImGui::TextColored(kGrey, "* still racing when the race ended");
+    }
+
+    ImGui::Spacing();
+    static const char* kOptions[Couch::kNumResultOptions] = { "Race again", "Change course", "Change drivers",
+                                                             "Quit to menu" };
+    for (int i = 0; i < Couch::kNumResultOptions; i++) {
+        bool selected = i == r.cursor;
+        std::string label = std::string(selected ? "> " : "  ") + kOptions[i];
+        if (ImGui::Selectable(label.c_str(), selected)) {
+            Couch::ChooseResult(i);
+        }
+    }
+    ImGui::TextColored(kGrey, "Up/Down and A on any player's controller.");
+}
+
+} // namespace GameUI
