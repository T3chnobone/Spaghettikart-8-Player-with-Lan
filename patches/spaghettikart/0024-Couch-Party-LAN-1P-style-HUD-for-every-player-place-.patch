+void render_view_place_number(s32 playerId) {
+    s32 rank;
+    s32 x;
+    s32 y;
+
+    if ((playerId < 0) || (playerId >= NUM_PLAYERS) || (playerHUD[playerId].unk_81 == 0)) {
+        return;
+    }
+    rank = gGPCurrentRaceRankByPlayerId[playerId];
+    if ((rank < 0) || (rank > 7)) {
+        return;
+    }
+    x = playerHUD[playerId].rankX + playerHUD[playerId].slideRankX;
+    y = playerHUD[playerId].rankY + playerHUD[playerId].slideRankY;
+    FrameInterpolation_RecordOpenChild("Player place number", playerId);
+    if (rank < 4) {
+        func_8004A384(x, y, 0U, playerHUD[playerId].rankScaling, 0xFF, D_800E55F8[rank], 0, 0xFF,
+                      (u8*) D_0D015258[rank], D_0D006030, 0x40, 0x40, 0x40, 0x40);
+    } else {
+        func_80042330_wide(x, y, 0U, playerHUD[playerId].rankScaling);
+        gSPDisplayList(gDisplayListHead++, D_0D007A60);
+        func_8004B414(0xFF, D_800E55F8[rank], 0, 0xFF);
+        func_80044DA0((u8*) common_texture_hud_place[rank], 0x80, 0x40);
+        gSPVertex(gDisplayListHead++, (uintptr_t) sPlaceDigitVtx[rank - 4], 4, 0);
+        gSPDisplayList(gDisplayListHead++, common_rectangle_display);
+        gSPTexture(gDisplayListHead++, 0x0001, 0x0001, 0, G_TX_RENDERTILE, G_OFF);
+    }
+    FrameInterpolation_RecordCloseChild();
+}
