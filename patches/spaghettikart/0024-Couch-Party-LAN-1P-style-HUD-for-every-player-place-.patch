+// the 4-player VS race. The ROM only has those numbers for 1-4, so 5-8 use the
+// digit from the 1P "5th".."8th" pictures (the digit part only, same colours).
+// The digit of "5th".."8th" is the left part of the 128x64 picture, up to
+// where "th" starts: 57, 59, 53 and 57 pixels (measured on the US ROM).
+static Vtx sPlaceDigitVtx[4][4] = {
+    { { { { -28, -32, 0 }, 0, { 0, 0 }, { 255, 255, 255, 255 } } },
+      { { { 28, -32, 0 }, 0, { 56 << 6, 0 }, { 255, 255, 255, 255 } } },
+      { { { 28, 31, 0 }, 0, { 56 << 6, 63 << 6 }, { 255, 255, 255, 255 } } },
+      { { { -28, 31, 0 }, 0, { 0, 63 << 6 }, { 255, 255, 255, 255 } } } },
+    { { { { -29, -32, 0 }, 0, { 0, 0 }, { 255, 255, 255, 255 } } },
+      { { { 29, -32, 0 }, 0, { 58 << 6, 0 }, { 255, 255, 255, 255 } } },
+      { { { 29, 31, 0 }, 0, { 58 << 6, 63 << 6 }, { 255, 255, 255, 255 } } },
+      { { { -29, 31, 0 }, 0, { 0, 63 << 6 }, { 255, 255, 255, 255 } } } },
+    { { { { -26, -32, 0 }, 0, { 0, 0 }, { 255, 255, 255, 255 } } },
+      { { { 26, -32, 0 }, 0, { 52 << 6, 0 }, { 255, 255, 255, 255 } } },
+      { { { 26, 31, 0 }, 0, { 52 << 6, 63 << 6 }, { 255, 255, 255, 255 } } },
+      { { { -26, 31, 0 }, 0, { 0, 63 << 6 }, { 255, 255, 255, 255 } } } },
+    { { { { -28, -32, 0 }, 0, { 0, 0 }, { 255, 255, 255, 255 } } },
+      { { { 28, -32, 0 }, 0, { 56 << 6, 0 }, { 255, 255, 255, 255 } } },
+      { { { 28, 31, 0 }, 0, { 56 << 6, 63 << 6 }, { 255, 255, 255, 255 } } },
+      { { { -28, 31, 0 }, 0, { 0, 63 << 6 }, { 255, 255, 255, 255 } } } },
+};
