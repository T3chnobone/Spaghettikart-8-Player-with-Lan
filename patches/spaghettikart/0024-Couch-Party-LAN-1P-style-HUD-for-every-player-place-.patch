+// Couch Party / LAN views: every player has their own 1P HUD layout, cycled with
+// their own C-right (right stick right) like the stock 1P race:
+// 0 = minimap, 1 = speedometer, 2 = race positions. HUD only, never read by the race.
+static s8 sViewHudMode[NETRACE_MAX_HUMANS];
+static s8 sSavedHudModes;
+static bool sSavedE6, sSavedE8, sSavedF0;
+static bool sViewHudSaved = false;
+// Each player's own speedometer needle (the stock one follows player 1).
+static u16 sViewNeedle[NETRACE_MAX_HUMANS];
+static u8 sViewNeedleJitter[NETRACE_MAX_HUMANS];
+static f32 sViewNeedleLast[NETRACE_MAX_HUMANS];
+
+static void hud_set_1p_layout(s32 mode) {
+    gHUDModes = mode;
+    D_801657E8 = (mode == 0);
+    D_801657E6 = (mode == 1);
+    D_801657F0 = (mode == 2);
+}
+
+static bool view_hud_toggle(void) {
+    s32 first = 0;
+    s32 count = gNetHumanCount;
+    s32 p;
+    bool changed = false;
+
+    couch_local_players(&first, &count); // LAN GAME: only this PC's players
+    for (p = first; (p < first + count) && (p < gNetHumanCount) && (p < NETRACE_MAX_HUMANS); p++) {
+        if (p < 0) {
+            continue;
+        }
+        if (get_player_controller(p)->buttonPressed & R_CBUTTONS) {
+            if (++sViewHudMode[p] >= 3) {
+                sViewHudMode[p] = 0;
+            }
+            changed = true;
+        }
+    }
+    return changed;
+}
+
+void view_hud_begin(s32 playerId) {
+    if ((playerId < 0) || (playerId >= NETRACE_MAX_HUMANS)) {
+        return;
+    }
+    if (!sViewHudSaved) {
+        sSavedHudModes = gHUDModes;
+        sSavedE6 = D_801657E6;
+        sSavedE8 = D_801657E8;
+        sSavedF0 = D_801657F0;
+        sViewHudSaved = true;
+    }
+    hud_set_1p_layout(sViewHudMode[playerId]);
+}
+
+void view_hud_end(void) {
+    if (sViewHudSaved) {
+        gHUDModes = sSavedHudModes;
+        D_801657E6 = sSavedE6;
+        D_801657E8 = sSavedE8;
+        D_801657F0 = sSavedF0;
+        sViewHudSaved = false;
+    }
+}
+
+// Mirrors func_8005C360 for one player.
+static void view_needle_update(s32 p, f32 speed) {
+    u16 v;
+    if (speed < 10.0) {
+        v = (u16) (128.0f * speed) + 0xDD00;
+    } else if (speed < 20.0) {
+        v = (u16) ((speed - 10.0) * 256.0) + 0xE200;
+    } else {
+        v = (u16) ((speed - 20.0) * 268.8) + 0xEC00;
+    }
+    if (speed == sViewNeedleLast[p]) {
+        if (speed > 5.0f) {
+            if (++sViewNeedleJitter[p] >= 8) {
+                sViewNeedleJitter[p] = 0;
+            }
+        } else {
+            sViewNeedleJitter[p] = 0;
+        }
+    }
+    sViewNeedle[p] = v + D_800E55A0[sViewNeedleJitter[p]];
+    sViewNeedleLast[p] = speed;
+}
+
+u16 view_hud_needle(s32 playerId) {
+    if ((playerId > 0) && (playerId < NETRACE_MAX_HUMANS) && gNetLocalViews && netrace_active()) {
+        return (sViewNeedle[playerId] != 0) ? sViewNeedle[playerId] : 0xDD00;
+    }
+    return D_8016579E;
+}
+
