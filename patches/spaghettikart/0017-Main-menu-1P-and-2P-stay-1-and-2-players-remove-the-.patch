From d5a8542a94d19a31e2e694fc4396e99459e7de90 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 30 Oct 2026 13:22:43 +0000
Subject: [PATCH 17/17] Main menu 1P and 2P stay 1 and 2 players: remove the
 8-player Grand Prix

More players: Couch Party or LAN GAME (VS/Battle).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Qq7B1uqfWVWykYRDDMiuXa
---
 docs/LOCAL_MULTIPLAYER.md        |  6 ++++++
 docs/NETPLAY.md                  |  6 ++++++
 src/port/localplay/localplay.cpp |  4 +++-
 src/port/netplay/netrace.c       |  6 ++----
 src/port/ui/LocalPlayWindow.cpp  | 10 ++++------
 src/port/ui/NetplayWindow.cpp    | 13 +++++--------
 6 files changed, 26 insertions(+), 19 deletions(-)

diff --git a/docs/LOCAL_MULTIPLAYER.md b/docs/LOCAL_MULTIPLAYER.md
index 28544a8..93d01bd 100644
--- a/docs/LOCAL_MULTIPLAYER.md
+++ b/docs/LOCAL_MULTIPLAYER.md
@@ -1,5 +1,11 @@
 # Local Multiplayer (up to 8 players) and Multiple Screens
 
+> **Note:** the 8-player Grand Prix has been removed. The main menu's 1P column
+> is always 1 player and 2P is 2 players. For more players use **COUCH PARTY**
+> (one PC) or **LAN GAME** (several PCs). The sections below on the Grand Prix
+> describe the earlier build.
+
+
 Up to 8 people on one PC, each with their own view, on one screen or spread
 over several monitors.
 
diff --git a/docs/NETPLAY.md b/docs/NETPLAY.md
index ac19d19..fd5509a 100644
--- a/docs/NETPLAY.md
+++ b/docs/NETPLAY.md
@@ -1,5 +1,11 @@
 # LAN Netplay
 
+> **Note:** the 8-player Grand Prix has been removed. The main menu's 1P column
+> is always 1 player and 2P is 2 players. For more players use **COUCH PARTY**
+> (one PC) or **LAN GAME** (several PCs). The sections below on the Grand Prix
+> describe the earlier build.
+
+
 Play SpaghettiKart with up to **8 people on separate PCs** over a local network.
 
 ## LAN GAME (from the main menu)
diff --git a/src/port/localplay/localplay.cpp b/src/port/localplay/localplay.cpp
index 072ddb2..b301a8d 100644
--- a/src/port/localplay/localplay.cpp
+++ b/src/port/localplay/localplay.cpp
@@ -141,7 +141,9 @@ void AutoAssignPads() {
 // ---- settings ----
 
 bool Enabled() {
-    return CVarGetInteger("gLocalPlay.Enabled", 0) != 0;
+    // The 8-player Grand Prix is gone: the menu's 1P column is always 1 player.
+    // (Couch Party has its own roster and doesn't use this.)
+    return false;
 }
 int PlayerCount() {
     return std::clamp(CVarGetInteger("gLocalPlay.Players", 4), 2, NETRACE_MAX_HUMANS);
diff --git a/src/port/netplay/netrace.c b/src/port/netplay/netrace.c
index 0c2c51f..abb9c55 100644
--- a/src/port/netplay/netrace.c
+++ b/src/port/netplay/netrace.c
@@ -30,10 +30,8 @@ bool netrace_active(void) {
         (gPlayerCountSelection1 != 1) || gDemoMode) {
         return false;
     }
-    if (gModeSelection == GRAND_PRIX) {
-        return true;
-    }
-    // Couch Party runs VS races and Battles the same way, all players local.
+    // The main menu's 1P column stays one player: no 8-player Grand Prix.
+    // Couch Party and LAN GAME run VS races and Battles this way.
     return gCouchParty && gNetLocalViews && ((gModeSelection == VERSUS) || (gModeSelection == BATTLE));
 }
 
