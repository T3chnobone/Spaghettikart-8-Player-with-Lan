diff --git a/src/port/localplay/ViewLayout.cpp b/src/port/localplay/ViewLayout.cpp
new file mode 100644
index 0000000..45699f7
--- /dev/null
+++ b/src/port/localplay/ViewLayout.cpp
@@ -0,0 +1,116 @@
+#include "ViewLayout.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace LocalPlay {
+
+MonitorRect UnionOfMonitors(const std::vector<MonitorRect>& monitors, uint32_t mask) {
+    MonitorRect u;
+    bool any = false;
+    for (size_t pass = 0; pass < 2 && !any; pass++) {
+        for (size_t i = 0; i < monitors.size(); i++) {
+            if (pass == 0 && i < 32 && !(mask & (1u << i))) {
+                continue;
+            }
+            const MonitorRect& m = monitors[i];
+            if (!any) {
+                u = m;
+                any = true;
+            } else {
+                u.left = std::min(u.left, m.left);
+                u.top = std::min(u.top, m.top);
+                u.right = std::max(u.right, m.right);
+                u.bottom = std::max(u.bottom, m.bottom);
+            }
+        }
+    }
+    return u;
+}
+
+void ChooseGrid(int count, float areaAspect, float targetAspect, int& cols, int& rows) {
+    cols = 1;
+    rows = std::max(count, 1);
+    if (count <= 1) {
+        cols = rows = 1;
+        return;
+    }
+    float best = 1e9f;
+    for (int c = 1; c <= count; c++) {
+        int r = (count + c - 1) / c;
+        if ((r - 1) * c >= count) {
+            continue; // a whole empty row
+        }
+        float cellAspect = areaAspect * (float) r / (float) c;
+        float aspectCost = std::fabs(std::log(cellAspect / targetAspect));
+        float wasteCost = 0.6f * (float) (r * c - count) / (float) count;
+        float cost = aspectCost + wasteCost;
+        if (cost < best - 1e-4f) {
+            best = cost;
+            cols = c;
+            rows = r;
+        }
+    }
+}
+
+std::vector<Rect> LayoutViews(int count, const MonitorRect& window, const std::vector<MonitorRect>& monitors,
+                              uint32_t mask, float targetAspect) {
+    std::vector<Rect> out;
+    if (count <= 0 || window.Width() <= 0 || window.Height() <= 0) {
+        return out;
+    }
+
+    // Selected monitors, clipped to the window; the window itself if none.
+    std::vector<MonitorRect> areas;
+    for (size_t i = 0; i < monitors.size(); i++) {
+        if (i < 32 && !(mask & (1u << i))) {
+            continue;
+        }
+        MonitorRect m = monitors[i];
+        m.left = std::max(m.left, window.left);
+        m.top = std::max(m.top, window.top);
+        m.right = std::min(m.right, window.right);
+        m.bottom = std::min(m.bottom, window.bottom);
+        if (m.Width() > 0 && m.Height() > 0) {
+            areas.push_back(m);
+        }
+    }
+    if (areas.empty()) {
+        areas.push_back(window);
+    }
+    // More monitors than views: use the first ones.
+    if ((int) areas.size() > count) {
+        areas.resize(count);
+    }
+
+    const float W = (float) window.Width();
+    const float H = (float) window.Height();
+    int remaining = count;
+    for (size_t a = 0; a < areas.size(); a++) {
+        int monitorsLeft = (int) (areas.size() - a);
+        int here = (remaining + monitorsLeft - 1) / monitorsLeft;
+        remaining -= here;
+
+        const MonitorRect& m = areas[a];
+        float mx = (float) (m.left - window.left), my = (float) (m.top - window.top);
+        float mw = (float) m.Width(), mh = (float) m.Height();
+        int cols, rows;
+        ChooseGrid(here, mw / mh, targetAspect, cols, rows);
+        float cw = mw / cols, ch = mh / rows;
+        for (int i = 0; i < here; i++) {
+            int row = i / cols;
+            int col = i % cols;
+            int inRow = std::min(cols, here - row * cols);
+            float rowOffset = (cols - inRow) * cw * 0.5f; // centre a short last row
+            Rect r;
+            r.x = (mx + rowOffset + col * cw) / W;
+            r.y = (my + row * ch) / H;
+            r.w = cw / W;
+            r.h = ch / H;
+            out.push_back(r);
+        }
+    }
+    return out;
+}
+
+} // namespace LocalPlay
diff --git a/src/port/localplay/ViewLayout.h b/src/port/localplay/ViewLayout.h
new file mode 100644
index 0000000..6b1b547
--- /dev/null
+++ b/src/port/localplay/ViewLayout.h
@@ -0,0 +1,43 @@
+#pragma once
+
+// Pure layout math for local split-screen views (no game or engine code, so
+// it can be unit tested on its own).
+
+#include <cstdint>
+#include <vector>
+
+namespace LocalPlay {
+
+// Rectangle in pixels (or any consistent unit).
+struct Rect {
+    float x = 0, y = 0, w = 0, h = 0;
+};
+
+// Integer rectangle as reported by the OS (virtual desktop coordinates).
+struct MonitorRect {
+    int32_t left = 0, top = 0, right = 0, bottom = 0;
+    int32_t Width() const {
+        return right - left;
+    }
+    int32_t Height() const {
+        return bottom - top;
+    }
+};
+
+// Smallest rectangle covering every monitor whose bit is set in `mask`
+// (bit i = monitors[i]). Falls back to all monitors if the mask selects none.
+MonitorRect UnionOfMonitors(const std::vector<MonitorRect>& monitors, uint32_t mask);
+
+// Picks columns x rows for `count` views in an area of the given aspect ratio:
+// as close to `targetAspect` per view as possible while wasting few cells.
+void ChooseGrid(int count, float areaAspect, float targetAspect, int& cols, int& rows);
+
+// Lays out `count` views over the selected monitors, which are given relative
+// to `window` (normally their union). Views are shared out in monitor order
+// (earlier monitors take any extra one) and arranged in a grid on each; a
+// last row that isn't full is centred. Returned rects are fractions 0..1 of
+// the window, one per view.
+std::vector<Rect> LayoutViews(int count, const MonitorRect& window, const std::vector<MonitorRect>& monitors,
+                              uint32_t mask, float targetAspect = 4.0f / 3.0f);
+
+} // namespace LocalPlay
diff --git a/src/port/localplay/localplay.cpp b/src/port/localplay/localplay.cpp
new file mode 100644
index 0000000..2b17f90
--- /dev/null
+++ b/src/port/localplay/localplay.cpp
@@ -0,0 +1,285 @@
+// Local multiplayer settings: players and characters, gamepad assignment, and
+// the window/monitor layout the per-player views are drawn into.
+
+#include "LocalPlaySettings.h"
+#include "ViewLayout.h"
+#include "localplay.h"
+#include "localplay_internal.h"
+
+#include <algorithm>
+#include <vector>
+
+#include <libultraship/libultraship.h>
+#include "ship/Context.h"
+#include "ship/window/Window.h"
+#include "ship/controller/controldeck/ControlDeck.h"
+#include "ship/controller/controldevice/controller/Controller.h"
+#include "ship/controller/physicaldevice/ConnectedPhysicalDeviceManager.h"
+#include "port/netplay/NetplayCore.h"
+
+extern "C" {
+uint32_t OTRGetGameRenderWidth();
+uint32_t OTRGetGameRenderHeight();
+#include "main.h"
+#include <defines.h>
+#include "port/netplay/netrace.h"
+}
+
+namespace LocalPlay {
+
+namespace {
+
+struct SpanState {
+    bool applied = false;
+    uint32_t mask = 0;
+    MonitorRect window;              // union of the spanned monitors
+    std::vector<MonitorRect> monitors;
+    uint32_t savedW = 0, savedH = 0; // window before spanning
+    int32_t savedX = 0, savedY = 0;
+};
+SpanState sSpan;
+
+size_t sLastPadCount = SIZE_MAX;
+int sPadCheckCountdown = 0;
+
+std::shared_ptr<Ship::Window> GetWindow() {
+    auto* ctx = Ship::Context::GetRawInstance();
+    return ctx ? ctx->GetWindow() : nullptr;
+}
+
+MonitorRect ToMonitorRect(const Ship::WindowRect& r) {
+    return { r.Left, r.Top, r.Right, r.Bottom };
+}
+
+void ApplySettingsToRace() {
+    bool netplay = Netplay::Get().GetRole() != Netplay::Role::None;
+    if (netplay) {
+        // A netplay session owns the big-race settings.
+        gNetLocalViews = 0;
+        return;
+    }
+    if (gGamestate == RACING) {
+        return; // never change the field mid-race
+    }
+    if (Enabled()) {
+        gNetBigRace = 1;
+        gNetLocalViews = 1;
+        gNetHumanCount = PlayerCount();
+        gNetCharacters[0] = 0; // P1 picks in the normal character menu
+        for (int k = 1; k < NETRACE_MAX_HUMANS; k++) {
+            gNetCharacters[k] = (s8) Character(k);
+        }
+    } else if (gNetLocalViews) {
+        gNetLocalViews = 0;
+        gNetBigRace = 0;
+        gNetHumanCount = 0;
+    }
+}
+
+void ApplySpan() {
+    auto window = GetWindow();
+    if (!window) {
+        return;
+    }
+    bool want = SpanMonitors();
+    uint32_t mask = MonitorMask();
+    if (want) {
+        std::vector<MonitorRect> monitors = Monitors();
+        if (monitors.empty()) {
+            return;
+        }
+        if (sSpan.applied && mask == sSpan.mask && monitors.size() == sSpan.monitors.size()) {
+            return; // nothing changed
+        }
+        MonitorRect u = UnionOfMonitors(monitors, mask);
+        if (!sSpan.applied) {
+            sSpan.savedW = window->GetWidth();
+            sSpan.savedH = window->GetHeight();
+            sSpan.savedX = window->GetPosX();
+            sSpan.savedY = window->GetPosY();
+        }
+        if (window->IsFullscreen()) {
+            window->SetFullscreen(false);
+        }
+        window->SetBorderless(true);
+        window->SetCurrentDimensions(false, (uint32_t) u.Width(), (uint32_t) u.Height(), u.left, u.top);
+        sSpan.applied = true;
+        sSpan.mask = mask;
+        sSpan.window = u;
+        sSpan.monitors = monitors;
+    } else if (sSpan.applied) {
+        window->SetBorderless(false);
+        if (sSpan.savedW > 0 && sSpan.savedH > 0) {
+            window->SetCurrentDimensions(false, sSpan.savedW, sSpan.savedH, sSpan.savedX, sSpan.savedY);
+        }
+        sSpan = SpanState{};
+    }
+}
+
+void AutoAssignPads() {
+    if (!AutoAssignGamepads()) {
+        sLastPadCount = SIZE_MAX;
+        return;
+    }
+    if (--sPadCheckCountdown > 0) {
+        return;
+    }
+    sPadCheckCountdown = 30; // about twice a second
+    size_t count = GamepadNames().size();
+    if (count != sLastPadCount) {
+        sLastPadCount = count;
+        AssignGamepadsToPlayers();
+    }
+}
+
+} // namespace
+
+// ---- settings ----
+
+bool Enabled() {
+    return CVarGetInteger("gLocalPlay.Enabled", 0) != 0;
+}
+int PlayerCount() {
+    return std::clamp(CVarGetInteger("gLocalPlay.Players", 4), 2, NETRACE_MAX_HUMANS);
+}
+int Character(int player) {
+    static const int kDefaults[NETRACE_MAX_HUMANS] = { 0, 1, 2, 3, 4, 5, 6, 7 };
+    std::string key = "gLocalPlay.Character" + std::to_string(player);
+    return std::clamp(CVarGetInteger(key.c_str(), kDefaults[player & 7]), 0, 7);
+}
+bool AutoAssignGamepads() {
+    return CVarGetInteger("gLocalPlay.AutoAssignPads", 1) != 0;
+}
+bool KeyboardIsPlayerOne() {
+    return CVarGetInteger("gLocalPlay.KeyboardIsP1", 0) != 0;
+}
+bool SpanMonitors() {
+    return CVarGetInteger("gLocalPlay.SpanMonitors", 0) != 0;
+}
+uint32_t MonitorMask() {
+    return (uint32_t) CVarGetInteger("gLocalPlay.MonitorMask", -1);
+}
+float RenderScale() {
+    return std::clamp(CVarGetFloat("gLocalPlay.RenderScale", 1.0f), 0.25f, 2.0f);
+}
+
+// ---- system queries ----
+
+std::vector<MonitorRect> Monitors() {
+    std::vector<MonitorRect> out;
+    auto window = GetWindow();
+    if (!window) {
+        return out;
+    }
+    for (const auto& r : window->GetMonitorRects()) {
+        out.push_back(ToMonitorRect(r));
+    }
+    return out;
+}
+
+std::vector<std::string> GamepadNames() {
+    std::vector<std::string> names;
+    auto* ctx = Ship::Context::GetRawInstance();
+    if (!ctx || !ctx->GetControlDeck()) {
+        return names;
+    }
+    auto byId = ctx->GetControlDeck()->GetConnectedPhysicalDeviceManager()->GetConnectedSDLGamepadNames();
+    std::vector<int32_t> ids;
+    for (const auto& [id, name] : byId) {
+        ids.push_back(id);
+    }
+    std::sort(ids.begin(), ids.end()); // connection order
+    for (int32_t id : ids) {
+        names.push_back(byId[id]);
+    }
+    return names;
+}
+
+void AssignGamepadsToPlayers() {
+    auto* ctx = Ship::Context::GetRawInstance();
+    if (!ctx || !ctx->GetControlDeck()) {
+        return;
+    }
+    auto deck = ctx->GetControlDeck();
+    auto devices = deck->GetConnectedPhysicalDeviceManager();
+    std::vector<int32_t> ids;
+    for (const auto& [id, name] : devices->GetConnectedSDLGamepadNames()) {
+        ids.push_back(id);
+    }
+    std::sort(ids.begin(), ids.end());
+
+    // Gamepad i drives player i+1, or player i+2 when the keyboard is P1.
+    const size_t firstPadPort = KeyboardIsPlayerOne() ? 1 : 0;
+    for (uint8_t port = 0; port < MAXCONTROLLERS; port++) {
+        for (size_t i = 0; i < ids.size(); i++) {
+            if (i + firstPadPort == port) {
+                devices->UnignoreInstanceIdForPort(port, ids[i]);
+            } else {
+                devices->IgnoreInstanceIdForPort(port, ids[i]);
+            }
+        }
+        bool hasPad = port >= firstPadPort && port - firstPadPort < ids.size();
+        auto controller = deck->GetControllerByPort(port);
+        if (hasPad && controller &&
+            !controller->HasMappingsForPhysicalDeviceType(Ship::PhysicalDeviceType::SDLGamepad)) {
+            controller->AddDefaultMappings(Ship::PhysicalDeviceType::SDLGamepad);
+        }
+    }
+}
+
+void ApplyWindowSize(uint32_t width, uint32_t height) {
+    auto window = GetWindow();
+    if (!window || SpanMonitors()) {
+        return;
+    }
+    // Centre on the monitor the window is on now.
+    std::vector<MonitorRect> monitors = Monitors();
+    MonitorRect target = monitors.empty() ? MonitorRect{ 0, 0, (int32_t) width, (int32_t) height } : monitors[0];
+    int32_t cx = window->GetPosX() + (int32_t) window->GetWidth() / 2;
+    int32_t cy = window->GetPosY() + (int32_t) window->GetHeight() / 2;
+    for (const auto& m : monitors) {
+        if (cx >= m.left && cx < m.right && cy >= m.top && cy < m.bottom) {
+            target = m;
+            break;
+        }
+    }
+    width = std::min<uint32_t>(width, (uint32_t) target.Width());
+    height = std::min<uint32_t>(height, (uint32_t) target.Height());
+    if (window->IsFullscreen()) {
+        window->SetFullscreen(false);
+    }
+    window->SetCurrentDimensions(false, width, height, target.left + (target.Width() - (int32_t) width) / 2,
+                                 target.top + (target.Height() - (int32_t) height) / 2);
+}
+
+std::vector<Rect> CurrentLayout(int count) {
+    if (sSpan.applied) {
+        return LayoutViews(count, sSpan.window, sSpan.monitors, sSpan.mask);
+    }
+    // One window on one screen: lay out over the window itself.
+    MonitorRect window{ 0, 0, (int32_t) OTRGetGameRenderWidth(), (int32_t) OTRGetGameRenderHeight() };
+    return LayoutViews(count, window, { window }, 1);
+}
+
+} // namespace LocalPlay
+
+// ---- C API ----
+
+extern "C" void localplay_update(void) {
+    LocalPlay::ApplySettingsToRace();
+    LocalPlay::AutoAssignPads();
+    LocalPlay::ApplySpan();
+}
+
+extern "C" int localplay_get_layout(int count, LPRect* out) {
+    std::vector<LocalPlay::Rect> rects = LocalPlay::CurrentLayout(count);
+    int n = std::min<int>(count, (int) rects.size());
+    for (int i = 0; i < n; i++) {
+        out[i] = { rects[i].x, rects[i].y, rects[i].w, rects[i].h };
+    }
+    return n;
+}
+
+extern "C" float localplay_render_scale(void) {
+    return LocalPlay::RenderScale();
+}
