diff --git a/src/port/localplay/localplay_render.c b/src/port/localplay/localplay_render.c
new file mode 100644
index 0000000..f1cdb29
--- /dev/null
+++ b/src/port/localplay/localplay_render.c
@@ -0,0 +1,180 @@
+// Local multi-view races: per-player cameras, drawing each player's view into
+// its own framebuffer, and composing those views on screen.
+
+#include <libultraship.h>
+#include "mk64.h"
+#include <assets/models/common_data.h>
+#include "port/Engine.h"
+#include "port/Game.h"
+#include "port/interpolation/matrix.h"
+#include "main.h"
+#include "camera.h"
+#include "code_800029B0.h"
+#include "code_80057C60.h"
+#include "racing/skybox_and_splitscreen.h"
+#include "port/netplay/netrace.h"
+#include "localplay.h"
+#include "localplay_internal.h"
+
+int gfx_create_framebuffer(uint32_t width, uint32_t height, uint32_t native_width, uint32_t native_height,
+                           uint8_t resize, bool forceFixedAspect);
+void gfx_set_framebuffer_pixel_size(int fb, uint32_t width, uint32_t height);
+
+float gLocalViewAspectOverride = 0.0f;
+
+static s32 sViewFb[NETRACE_MAX_HUMANS] = { -1, -1, -1, -1, -1, -1, -1, -1 };
+static u32 sViewFbW[NETRACE_MAX_HUMANS];
+static u32 sViewFbH[NETRACE_MAX_HUMANS];
+
+bool localplay_views_active(void) {
+    return gNetLocalViews && netrace_active() && (gGamestate == RACING) && (gNetHumanCount > 1);
+}
+
+void localplay_feed_extra_pads(const OSContPad* pads) {
+    s32 i;
+
+    if (!gNetLocalViews) {
+        return;
+    }
+    for (i = 4; i < NETRACE_MAX_HUMANS; i++) {
+        netrace_set_extra_pad(i - 4, (u16) pads[i].button, pads[i].stick_x, pads[i].stick_y);
+    }
+}
+
+// The 1P Grand Prix already has cameras for P1 (screen 1) and P2 (screen 2,
+// used for the end-of-race shot). Add one for each other local player.
+void localplay_spawn_view_cameras(u32 mode) {
+    s32 v;
+
+    if (!gNetLocalViews || !netrace_active()) {
+        return;
+    }
+    for (v = 0; v < NETRACE_MAX_HUMANS; v++) {
+        ScreenContext* screen = &gScreenContexts[v];
+        if (v >= gNetHumanCount) {
+            if (v >= 2) {
+                screen->camera = NULL; // stale from an earlier race
+                screen->raceCamera = NULL;
+                screen->pendingCamera = NULL;
+            }
+            continue;
+        }
+        screen->player = &gPlayers[v];
+        screen->controllers = get_player_controller(v);
+        if (v >= 2) {
+            Vec3f spawn = { gPlayers[v].pos[0], gPlayers[v].pos[1], gPlayers[v].pos[2] };
+            Camera* camera = CM_AddCamera(spawn, gPlayers[v].rotation[1], mode);
+            if (camera == NULL) {
+                screen->camera = NULL;
+                continue;
+            }
+            CM_AttachCamera(camera, v);
+            screen->camera = camera;
+            screen->raceCamera = camera;
+            screen->pendingCamera = NULL;
+            screen->lookBehindCamera = NULL;
+        }
+    }
+}
+
+static s32 ensure_view_fb(s32 v, u32 width, u32 height) {
+    if (sViewFb[v] < 0) {
+        sViewFb[v] = gfx_create_framebuffer(SCREEN_WIDTH, SCREEN_HEIGHT, SCREEN_WIDTH, SCREEN_HEIGHT, false, false);
+        sViewFbW[v] = sViewFbH[v] = 0;
+    }
+    if (width != sViewFbW[v] || height != sViewFbH[v]) {
+        gfx_set_framebuffer_pixel_size(sViewFb[v], width, height);
+        sViewFbW[v] = width;
+        sViewFbH[v] = height;
+    }
+    return sViewFb[v];
+}
+
+static void compose_setup(void) {
+    gSPMatrix(gDisplayListHead++, &gIdentityMatrix, G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
+    gDPSetEnvColor(gDisplayListHead++, 255, 255, 255, 255);
+    gDPSetOtherMode(gDisplayListHead++,
+                    G_AD_DISABLE | G_CD_DISABLE | G_CK_NONE | G_TC_FILT | G_TF_BILERP | G_TT_NONE | G_TL_TILE |
+                        G_TD_CLAMP | G_TP_NONE | G_CYC_1CYCLE | G_PM_NPRIMITIVE,
+                    G_AC_NONE | G_ZS_PRIM | G_RM_OPA_SURF | G_RM_OPA_SURF2);
+    gSPClearGeometryMode(gDisplayListHead++,
+                         G_CULL_BOTH | G_FOG | G_LIGHTING | G_TEXTURE_GEN | G_TEXTURE_GEN_LINEAR | G_ZBUFFER);
+    gSPSetGeometryMode(gDisplayListHead++, G_SHADE | G_SHADING_SMOOTH);
+    gDPSetCombineLERP(gDisplayListHead++, TEXEL0, 0, ENVIRONMENT, 0, 0, 0, 0, ENVIRONMENT, TEXEL0, 0, ENVIRONMENT, 0,
+                      0, 0, 0, ENVIRONMENT);
+    gDPSetScissor(gDisplayListHead++, G_SC_NON_INTERLACE, 0, 0, SCREEN_WIDTH, SCREEN_HEIGHT);
+}
+
+// Draws framebuffer `fb` into `rect` (fractions of the window).
+static void compose_view(s32 fb, LPRect rect, u32 texW, u32 texH) {
+    // Window-wide N64 coordinates: x spans the full widescreen width.
+    float aspect = OTRGetAspectRatio();
+    float left = SCREEN_WIDTH / 2.0f - (SCREEN_HEIGHT / 2.0f) * aspect;
+    float width = SCREEN_HEIGHT * aspect;
+    s32 x0 = (s32) ((left + rect.x * width) * 4.0f);
+    s32 x1 = (s32) ((left + (rect.x + rect.w) * width) * 4.0f);
+    s32 y0 = (s32) (rect.y * SCREEN_HEIGHT * 4.0f);
+    s32 y1 = (s32) ((rect.y + rect.h) * SCREEN_HEIGHT * 4.0f);
+
+    gDPSetTextureImageFB(gDisplayListHead++, 0, 0, 0, fb);
+    gDPImageRectangle(gDisplayListHead++, x0, y0, 0, 0, x1, y1, texW, texH, G_TX_RENDERTILE, texW, texH);
+}
+
+void localplay_render_views(void) {
+    LPRect rects[NETRACE_MAX_HUMANS];
+    s32 count = gNetHumanCount;
+    s32 v;
+    float renderW = (float) OTRGetGameRenderWidth();
+    float renderH = (float) OTRGetGameRenderHeight();
+    float scale = localplay_render_scale();
+    s32 drawn[NETRACE_MAX_HUMANS] = { 0 };
+
+    if (count > NETRACE_MAX_HUMANS) {
+        count = NETRACE_MAX_HUMANS;
+    }
+    count = localplay_get_layout(count, rects);
+
+    for (v = 0; v < count; v++) {
+        ScreenContext* screen = &gScreenContexts[v];
+        float pixelW = rects[v].w * renderW;
+        float pixelH = rects[v].h * renderH;
+        u32 fbW = (u32) (pixelW * scale);
+        u32 fbH = (u32) (pixelH * scale);
+        s32 fb;
+
+        if (screen->camera == NULL || pixelW < 1.0f || pixelH < 1.0f) {
+            continue;
+        }
+        fbW = fbW < 16 ? 16 : fbW;
+        fbH = fbH < 16 ? 16 : fbH;
+        fb = ensure_view_fb(v, fbW, fbH);
+
+        // Each view is a normal full-screen 1P render into its own buffer.
+        screen->player = &gPlayers[v];
+        screen->screenWidth = SCREEN_WIDTH;
+        screen->screenHeight = SCREEN_HEIGHT;
+        screen->screenStartX = SCREEN_WIDTH / 2;
+        screen->screenStartY = SCREEN_HEIGHT / 2;
+
+        gLocalViewAspectOverride = pixelW / pixelH;
+        gNetViewPlayer = v; // the HUD shows this player's item, laps, place
+
+        gsSPSetFB(gDisplayListHead++, fb);
+        render_screens(screen, RENDER_SCREEN_MODE_1P_PLAYER_ONE, 0, v);
+        func_800591B4(); // minimap and other overlays, per view
+        gsSPResetFB(gDisplayListHead++);
+        drawn[v] = 1;
+    }
+
+    gLocalViewAspectOverride = 0.0f;
+    gNetViewPlayer = 0;
+
+    init_rdp();
+    compose_setup();
+    for (v = 0; v < count; v++) {
+        if (drawn[v]) {
+            compose_view(sViewFb[v], rects[v], sViewFbW[v], sViewFbH[v]);
+        }
+    }
+    init_rdp();
+}
