@@ -0,0 +1,41 @@
+#ifndef SPAGHETTI_LOCALPLAY_H
+#define SPAGHETTI_LOCALPLAY_H
+
+// Local multiplayer for up to 8 players on one PC: a Grand Prix where each
+// player has their own view, laid out across one window that can span several
+// monitors. The race itself is the "big race" from netplay/netrace.h; this
+// adds local inputs, one camera per player, and rendering each view to its own
+// framebuffer before composing them on screen.
+
+#include <libultraship.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// While a view is being drawn, the aspect ratio widescreen helpers should use
+// (0 = the window's own).
+extern float gLocalViewAspectOverride;
+
+// True while a local multi-view race is on screen.
+bool localplay_views_active(void);
+
+// Once per frame, before the game frame: applies settings, assigns gamepads,
+// spans the window over monitors.
+void localplay_update(void);
+
+// After the controllers are read: players 5-8 take ports 5-8.
+void localplay_feed_extra_pads(const OSContPad* pads);
+
+// Race setup: a camera following each local player (spawn_players.c).
+void localplay_spawn_view_cameras(u32 mode);
+
+// Race render: draw every player's view and compose them (main.c).
+void localplay_render_views(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
