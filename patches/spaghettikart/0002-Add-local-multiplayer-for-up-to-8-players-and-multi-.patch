diff --git a/src/port/ui/LocalPlayWindow.cpp b/src/port/ui/LocalPlayWindow.cpp
new file mode 100644
index 0000000..1d46199
--- /dev/null
+++ b/src/port/ui/LocalPlayWindow.cpp
@@ -0,0 +1,230 @@
+#include "LocalPlayWindow.h"
+
+#include <imgui.h>
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "port/localplay/LocalPlaySettings.h"
+
+namespace GameUI {
+
+namespace {
+
+const char* kCharacterNames[8] = { "Mario", "Luigi", "Yoshi", "Toad", "Donkey Kong", "Wario", "Peach", "Bowser" };
+const ImVec4 kGrey(0.65f, 0.65f, 0.65f, 1.0f);
+
+struct Resolution {
+    uint32_t w, h;
+};
+const Resolution kWindowSizes[] = { { 1280, 720 },  { 1600, 900 },  { 1920, 1080 },
+                                    { 2560, 1440 }, { 3440, 1440 }, { 3840, 2160 } };
+
+void Save() {
+    CVarSave();
+}
+
+bool CheckboxCVar(const char* label, const char* cvar, bool def) {
+    bool v = CVarGetInteger(cvar, def ? 1 : 0) != 0;
+    if (ImGui::Checkbox(label, &v)) {
+        CVarSetInteger(cvar, v ? 1 : 0);
+        Save();
+        return true;
+    }
+    return false;
+}
+
+void Wrapped(const ImVec4& color, const char* text) {
+    ImGui::PushTextWrapPos(0.0f);
+    ImGui::TextColored(color, "%s", text);
+    ImGui::PopTextWrapPos();
+}
+
+// A little map of the monitors with the player views laid out on them.
+void DrawLayoutPreview(const std::vector<LocalPlay::MonitorRect>& monitors) {
+    if (monitors.empty()) {
+        return;
+    }
+    uint32_t mask = LocalPlay::MonitorMask();
+    bool span = LocalPlay::SpanMonitors();
+    LocalPlay::MonitorRect all = LocalPlay::UnionOfMonitors(monitors, 0xFFFFFFFFu);
+    LocalPlay::MonitorRect window =
+        span ? LocalPlay::UnionOfMonitors(monitors, mask) : LocalPlay::MonitorRect{ 0, 0, 16, 9 };
+
+    float availW = ImGui::GetContentRegionAvail().x;
+    float boxH = 140.0f;
+    ImVec2 origin = ImGui::GetCursorScreenPos();
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+    int players = LocalPlay::PlayerCount();
+
+    if (span) {
+        float scale = std::min(availW / (float) all.Width(), boxH / (float) all.Height());
+        auto map = [&](float x, float y) {
+            return ImVec2(origin.x + (x - all.left) * scale, origin.y + (y - all.top) * scale);
+        };
+        for (size_t i = 0; i < monitors.size(); i++) {
+            const auto& m = monitors[i];
+            bool on = (mask & (1u << i)) != 0;
+            dl->AddRectFilled(map((float) m.left, (float) m.top), map((float) m.right, (float) m.bottom),
+                              on ? IM_COL32(40, 60, 90, 255) : IM_COL32(45, 45, 45, 255));
+            dl->AddRect(map((float) m.left, (float) m.top), map((float) m.right, (float) m.bottom),
+                        IM_COL32(160, 160, 160, 255));
+            std::string label = std::to_string(i + 1);
+            dl->AddText(map((float) m.left + 8 / scale, (float) m.top + 4 / scale), IM_COL32(200, 200, 200, 255),
+                        label.c_str());
+        }
+        auto views = LocalPlay::LayoutViews(players, window, monitors, mask);
+        for (size_t v = 0; v < views.size(); v++) {
+            float x0 = window.left + views[v].x * window.Width();
+            float y0 = window.top + views[v].y * window.Height();
+            float x1 = x0 + views[v].w * window.Width();
+            float y1 = y0 + views[v].h * window.Height();
+            ImVec2 a = map(x0, y0), b = map(x1, y1);
+            dl->AddRect(ImVec2(a.x + 2, a.y + 2), ImVec2(b.x - 2, b.y - 2), IM_COL32(120, 200, 120, 255));
+            std::string label = "P" + std::to_string(v + 1);
+            dl->AddText(ImVec2((a.x + b.x) / 2 - 8, (a.y + b.y) / 2 - 7), IM_COL32(220, 255, 220, 255),
+                        label.c_str());
+        }
+        ImGui::Dummy(ImVec2(all.Width() * scale, all.Height() * scale));
+    } else {
+        float w = std::min(availW, boxH * 16.0f / 9.0f);
+        float h = w * 9.0f / 16.0f;
+        dl->AddRectFilled(origin, ImVec2(origin.x + w, origin.y + h), IM_COL32(40, 60, 90, 255));
+        auto views = LocalPlay::LayoutViews(players, window, { window }, 1);
+        for (size_t v = 0; v < views.size(); v++) {
+            ImVec2 a(origin.x + views[v].x * w, origin.y + views[v].y * h);
+            ImVec2 b(a.x + views[v].w * w, a.y + views[v].h * h);
+            dl->AddRect(ImVec2(a.x + 2, a.y + 2), ImVec2(b.x - 2, b.y - 2), IM_COL32(120, 200, 120, 255));
+            std::string label = "P" + std::to_string(v + 1);
+            dl->AddText(ImVec2((a.x + b.x) / 2 - 8, (a.y + b.y) / 2 - 7), IM_COL32(220, 255, 220, 255),
+                        label.c_str());
+        }
+        ImGui::Dummy(ImVec2(w, h));
+    }
+}
+
+} // namespace
+
+void LocalPlayWindow::DrawElement() {
+    // ---------------------------------------------------------------- players
+    ImGui::SeparatorText("Players");
+    CheckboxCVar("Local multiplayer (up to 8 players)", "gLocalPlay.Enabled", false);
+    ImGui::BeginDisabled(!LocalPlay::Enabled());
+    int players = LocalPlay::PlayerCount();
+    if (ImGui::SliderInt("Players", &players, 2, 8)) {
+        CVarSetInteger("gLocalPlay.Players", players);
+        Save();
+    }
+    for (int k = 1; k < players; k++) {
+        int c = LocalPlay::Character(k);
+        std::string label = "Player " + std::to_string(k + 1);
+        if (ImGui::Combo(label.c_str(), &c, kCharacterNames, 8)) {
+            CVarSetInteger(("gLocalPlay.Character" + std::to_string(k)).c_str(), c);
+            Save();
+        }
+    }
+    ImGui::EndDisabled();
+    Wrapped(kGrey, "Start a race with 1P > Mario GP. Player 1 picks their character in the menu; "
+                   "players 2-8 drive the characters above, each with their own view. "
+                   "Empty grid slots are CPU drivers.");
+
+    // ------------------------------------------------------------ controllers
+    ImGui::SeparatorText("Controllers");
+    CheckboxCVar("Give each gamepad its own player automatically", "gLocalPlay.AutoAssignPads", true);
+    if (CheckboxCVar("Player 1 uses the keyboard", "gLocalPlay.KeyboardIsP1", false)) {
+        LocalPlay::AssignGamepadsToPlayers();
+    }
+    if (ImGui::Button("Assign gamepads now")) {
+        LocalPlay::AssignGamepadsToPlayers();
+    }
+    ImGui::SameLine();
+    if (ImGui::Button("Open bindings")) {
+        CVarSetInteger(CVAR_CONTROLLER_CONFIGURATION_WINDOW_OPEN, 1);
+    }
+    {
+        std::vector<std::string> pads = LocalPlay::GamepadNames();
+        int first = LocalPlay::KeyboardIsPlayerOne() ? 2 : 1;
+        if (first == 2) {
+            ImGui::Text("Player 1: keyboard");
+        }
+        if (pads.empty()) {
+            ImGui::TextColored(kGrey, "No gamepads connected.");
+        }
+        for (size_t i = 0; i < pads.size(); i++) {
+            int player = (int) i + first;
+            if (player <= 8) {
+                ImGui::Text("Player %d: %s", player, pads[i].c_str());
+            } else {
+                ImGui::TextColored(kGrey, "(unused) %s", pads[i].c_str());
+            }
+        }
+    }
+
+    // ---------------------------------------------------------------- screens
+    ImGui::SeparatorText("Screens");
+    std::vector<LocalPlay::MonitorRect> monitors = LocalPlay::Monitors();
+    uint32_t mask = LocalPlay::MonitorMask();
+    for (size_t i = 0; i < monitors.size() && i < 32; i++) {
+        const auto& m = monitors[i];
+        bool on = (mask & (1u << i)) != 0;
+        std::string label = "Monitor " + std::to_string(i + 1) + "  " + std::to_string(m.Width()) + "x" +
+                            std::to_string(m.Height()) + "  at " + std::to_string(m.left) + ", " +
+                            std::to_string(m.top);
+        if (ImGui::Checkbox(label.c_str(), &on)) {
+            mask = on ? (mask | (1u << i)) : (mask & ~(1u << i));
+            CVarSetInteger("gLocalPlay.MonitorMask", (int32_t) mask);
+            Save();
+        }
+    }
+    ImGui::BeginDisabled(monitors.size() < 2);
+    CheckboxCVar("Span the game window across the ticked monitors", "gLocalPlay.SpanMonitors", false);
+    ImGui::EndDisabled();
+    if (monitors.size() < 2) {
+        ImGui::TextColored(kGrey, "Only one monitor found.");
+    }
+    Wrapped(kGrey, "Views are shared out over the ticked monitors (earlier monitors take any extra) "
+                   "and each monitor keeps its own resolution.");
+    DrawLayoutPreview(monitors);
+
+    // ------------------------------------------------------------- resolution
+    ImGui::SeparatorText("Resolution");
+    float scale = LocalPlay::RenderScale() * 100.0f;
+    if (ImGui::SliderFloat("View render scale", &scale, 25.0f, 200.0f, "%.0f%%")) {
+        CVarSetFloat("gLocalPlay.RenderScale", scale / 100.0f);
+        Save();
+    }
+    if (ImGui::IsItemHovered()) {
+        ImGui::SetTooltip("Resolution each player's view is drawn at, relative to its size on screen.\n"
+                          "Lower it if 8 views run slowly; raise it for sharper views.");
+    }
+    ImGui::BeginDisabled(LocalPlay::SpanMonitors());
+    if (ImGui::BeginCombo("Window size", "Choose...")) {
+        uint32_t maxW = 0, maxH = 0;
+        for (const auto& m : monitors) {
+            maxW = std::max<uint32_t>(maxW, (uint32_t) m.Width());
+            maxH = std::max<uint32_t>(maxH, (uint32_t) m.Height());
+        }
+        for (const auto& r : kWindowSizes) {
+            if (maxW && (r.w > maxW || r.h > maxH)) {
+                continue;
+            }
+            std::string label = std::to_string(r.w) + " x " + std::to_string(r.h);
+            if (ImGui::Selectable(label.c_str())) {
+                LocalPlay::ApplyWindowSize(r.w, r.h);
+            }
+        }
+        for (size_t i = 0; i < monitors.size(); i++) {
+            std::string label = "Monitor " + std::to_string(i + 1) + " size (" +
+                                std::to_string(monitors[i].Width()) + " x " + std::to_string(monitors[i].Height()) +
+                                ")";
+            if (ImGui::Selectable(label.c_str())) {
+                LocalPlay::ApplyWindowSize((uint32_t) monitors[i].Width(), (uint32_t) monitors[i].Height());
+            }
+        }
+        ImGui::EndCombo();
+    }
+    ImGui::EndDisabled();
+    Wrapped(kGrey, "Full screen is in Settings > General; internal resolution is in Settings > Graphics.");
+}
+
+} // namespace GameUI
