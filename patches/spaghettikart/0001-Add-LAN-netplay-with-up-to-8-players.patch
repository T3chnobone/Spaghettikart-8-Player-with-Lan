+    X(&gMainMenuSelection, sizeof(gMainMenuSelection))                                                     \
+    X(&gSubMenuSelection, sizeof(gSubMenuSelection))                                                       \
+    X(&gPlayerSelectMenuSelection, sizeof(gPlayerSelectMenuSelection))                                     \
+    X(&gCupSelection, sizeof(gCupSelection))                                                               \
+    X(&sTempCupSelection, sizeof(sTempCupSelection))                                                       \
+    X(&gCourseIndexInCup, sizeof(gCourseIndexInCup))                                                       \
+    X(&gScreenModeListIndex, sizeof(gScreenModeListIndex))                                                 \
+    X(&gPlayerCount, sizeof(gPlayerCount))                                                                 \
+    X(&gNextDemoId, sizeof(gNextDemoId))                                                                   \
+    X(&gDemoUseController, sizeof(gDemoUseController))                                                     \
+    X(&gMenuTimingCounter, sizeof(gMenuTimingCounter))                                                     \
+    X(&gMenuDelayTimer, sizeof(gMenuDelayTimer))                                                           \
+    X(&gScreenModeSelection, sizeof(gScreenModeSelection))                                                 \
+    X(&gPlayerCountSelection1, sizeof(gPlayerCountSelection1))                                             \
+    X(&gModeSelection, sizeof(gModeSelection))                                                             \
+    X(&gCCSelection, sizeof(gCCSelection))                                                                 \
+    X(&gIsMirrorMode, sizeof(gIsMirrorMode))                                                               \
+    X(&gRandomSeed16, sizeof(gRandomSeed16))                                                               \
+    X(&gTickLogic, sizeof(gTickLogic))
+
+std::vector<uint8_t> CaptureStartState() {
+    std::vector<uint8_t> b;
+#define CAPTURE(ptr, size)                                \
+    {                                                     \
+        const uint8_t* p = (const uint8_t*) (ptr);        \
+        b.insert(b.end(), p, p + (size));                 \
+    }
+    MENU_BYTES(CAPTURE)
+#undef CAPTURE
+
+    // Big race: who drives which kart, with which character.
+    const Session& s = Get();
+    bool bigRace = !(s.LobbyOptions() & kOptionSplitScreen);
+    Put8(b, bigRace ? 1 : 0);
+    Put8(b, (uint8_t) s.PlayerCount());
+    for (int i = 0; i < kMaxPlayers; i++) {
+        Put8(b, s.Players()[i].profile);
+    }
+    gNetBigRace = bigRace ? 1 : 0;
+    gNetHumanCount = s.PlayerCount();
+    for (int i = 0; i < kMaxPlayers; i++) {
+        gNetCharacters[i] = (s8) (s.Players()[i].profile & 7);
+    }
+
+    Put8(b, (uint8_t) kNumSyncedCVars);
+    for (auto& cv : kSyncedCVars) {
+        PutStr(b, cv.name);
+        Put8(b, cv.isFloat ? 1 : 0);
+        if (cv.isFloat) {
+            float f = CVarGetFloat(cv.name, kUnsetFloat);
+            uint32_t bits;
+            memcpy(&bits, &f, 4);
+            Put32(b, bits);
+        } else {
+            Put32(b, (uint32_t) CVarGetInteger(cv.name, kUnsetInt));
+        }
+    }
+    SaveAndOverrideLocalOnly();
+    return b;
+}
+
+bool ApplyStartState(const std::vector<uint8_t>& b, std::string& err) {
+    size_t need = 0;
+#define MEASURE(ptr, size) need += (size);
+    MENU_BYTES(MEASURE)
+#undef MEASURE
+    if (b.size() < need) {
+        err = "start state too short";
+        return false;
+    }
+    size_t at = 0;
+#define APPLY(ptr, size)                    \
+    {                                       \
+        memcpy((void*) (ptr), &b[at], (size)); \
+        at += (size);                       \
+    }
+    MENU_BYTES(APPLY)
+#undef APPLY
+
+    SaveAndOverrideLocalOnly();
+    Cursor r{ b, at };
+    gNetBigRace = r.Get8() ? 1 : 0;
+    gNetHumanCount = r.Get8();
+    for (int i = 0; i < kMaxPlayers; i++) {
+        gNetCharacters[i] = (s8) (r.Get8() & 7);
+    }
+    int n = r.Get8();
+    for (int i = 0; i < n && r.ok; i++) {
+        std::string name = r.GetStr();
+        bool isFloat = r.Get8() != 0;
+        uint32_t bits = r.Get32();
+        if (!r.ok) {
+            break;
+        }
+        if (isFloat) {
+            float f;
+            memcpy(&f, &bits, 4);
+            if (f == kUnsetFloat) {
+                CVarClear(name.c_str());
+            } else {
+                CVarSetFloat(name.c_str(), f);
+            }
+        } else if ((int32_t) bits == kUnsetInt) {
+            CVarClear(name.c_str());
+        } else {
+            CVarSetInteger(name.c_str(), (int32_t) bits);
+        }
+    }
+    if (!r.ok) {
+        err = "malformed settings";
+        return false;
+    }
+    return true;
+}
+
+uint32_t StateHash() {
+    uint32_t h = 2166136261u;
+    h = Fnv(h, &gRandomSeed16, sizeof(gRandomSeed16));
+    h = Fnv(h, &gMenuSelection, sizeof(gMenuSelection));
+    h = Fnv(h, &gModeSelection, sizeof(gModeSelection));
+    h = Fnv(h, &gCCSelection, sizeof(gCCSelection));
+    h = Fnv(h, &gPlayerCountSelection1, sizeof(gPlayerCountSelection1));
+    h = Fnv(h, gCharacterSelections, sizeof(s8) * 4);
+    h = Fnv(h, &gNetHumanCount, sizeof(gNetHumanCount));
+    if (gGamestate == RACING) {
+        h = Fnv(h, &gGamestate, sizeof(gGamestate));
+        for (int i = 0; i < NUM_PLAYERS; i++) {
+            const Player& p = gPlayers[i];
+            h = Fnv(h, &p.pos, sizeof(p.pos));
+            h = Fnv(h, &p.velocity, sizeof(p.velocity));
+            h = Fnv(h, &p.rotation, sizeof(p.rotation));
+            h = Fnv(h, &p.currentSpeed, sizeof(p.currentSpeed));
+            h = Fnv(h, &p.type, sizeof(p.type));
+            h = Fnv(h, &p.currentItemCopy, sizeof(p.currentItemCopy));
+        }
+    }
+    return h;
+}
+
+void EnsureHooks() {
+    static bool sInstalled = false;
+    if (sInstalled) {
+        return;
+    }
+    sInstalled = true;
+    Hooks hooks;
+    hooks.compatBlob = [] { return EncodeCompat(LocalCompat()); };
+    hooks.describeMismatch = DescribeMismatch;
+    hooks.captureStartState = CaptureStartState;
+    hooks.applyStartState = ApplyStartState;
+    hooks.stateHash = StateHash;
+    hooks.onSessionEnd = RestoreOverrides;
+    Get().SetHooks(std::move(hooks));
+}
+
+Pad FromOS(const OSContPad& p) {
+    Pad pad;
+    pad.button = (uint32_t) p.button;
+    pad.stickX = p.stick_x;
+    pad.stickY = p.stick_y;
+    pad.rightStickX = p.right_stick_x;
+    pad.rightStickY = p.right_stick_y;
+    return pad;
+}
+
+void ToOS(const Pad& pad, OSContPad& p) {
+    p.button = (decltype(p.button)) pad.button;
+    p.stick_x = pad.stickX;
+    p.stick_y = pad.stickY;
+    p.right_stick_x = pad.rightStickX;
+    p.right_stick_y = pad.rightStickY;
+    p.err_no = 0;
+    p.gyro_x = 0.0f;
+    p.gyro_y = 0.0f;
+}
+
+} // namespace
+
+namespace Netplay {
+// Used by the UI so it can run the same pre-flight the hooks need.
+void InstallGameHooks() {
+    EnsureHooks();
+}
+} // namespace Netplay
+
+extern "C" bool Netplay_Update(void) {
+    EnsureHooks();
+    bool started = Get().Update();
+    if (started) {
+        gNetViewPlayer = Get().LocalSlot(); // render-only: this PC's own kart
+    }
+    if (!Get().IsInGame() && Get().GetPhase() == Phase::Idle) {
+        RestoreOverrides(); // covers a client that applied START but dropped before frame 0
+    }
+    return started;
+}
+
+extern "C" void Netplay_ExchangeInputs(OSContPad* pads) {
+    Session& s = Get();
+    if (!s.IsInGame()) {
+        return;
+    }
+    FramePads all;
+    if (!s.ExchangeInputs(FromOS(pads[0]), all)) {
+        return; // session ended; this machine carries on locally
+    }
+    // Players 1-4 go through the stock controller path; 5-8 (big race) have
+    // their own storage.
+    for (int i = 0; i < 4; i++) {
+        ToOS(all[i], pads[i]);
+    }
+    for (int i = 4; i < kMaxPlayers; i++) {
+        netrace_set_extra_pad(i - 4, (u16) all[i].button, all[i].stickX, all[i].stickY);
+    }
+}
+
+extern "C" bool Netplay_IsInGame(void) {
+    return Get().IsInGame();
+}
+
+extern "C" void Netplay_OnLocalReset(void) {
+    if (Get().GetRole() != Role::None) {
+        Get().Disconnect("Session ended: a player reset the game");
+    }
+}
