+#include "netrace.h"
+
+#include <macros.h>
+#include <common_structs.h>
+#include <defines.h>
+#include "main.h"
+#include "camera.h"
+#include "code_800029B0.h"
+#include "spawn_players.h"
+#include "menus.h"
+
+s32 gNetBigRace = 0;
+s32 gNetHumanCount = 0;
+s8 gNetCharacters[NETRACE_MAX_HUMANS] = { 0 };
+s32 gNetViewPlayer = 0;
+
+// Inputs for players 5-8. Kept apart from gControllers[4..7], which the stock
+// game uses for "any controller" input and for time-trial ghost replays.
+static struct Controller sExtraControllers[NETRACE_MAX_HUMANS - 4];
+
+// Ticks spent waiting for the last humans to finish after the first one did.
+static s32 sFinishWaitTicks = 0;
+// ~45 seconds at the game's 60 logic ticks per second.
+#define NETRACE_FINISH_TIMEOUT_TICKS (60 * 45)
+
+bool netrace_active(void) {
+    return gNetBigRace && (gNetHumanCount > 0) && (gModeSelection == GRAND_PRIX) &&
+           (gScreenModeSelection == SCREEN_MODE_1P) && (gPlayerCountSelection1 == 1) && !gDemoMode;
+}
+
+bool netrace_is_remote_human(s32 playerId) {
+    return netrace_active() && (playerId > 0) && (playerId < gNetHumanCount) && (playerId < NUM_PLAYERS);
+}
+
+s32 netrace_human_loop_count(void) {
+    if (netrace_active()) {
+        return gNetHumanCount;
+    }
+    return gPlayerCountSelection1;
+}
+
+s32 netrace_view_player(void) {
+    if (netrace_active() && gNetViewPlayer > 0 && gNetViewPlayer < gNetHumanCount) {
+        return gNetViewPlayer;
+    }
+    return 0;
+}
+
+struct Controller* get_player_controller(s32 playerId) {
+    if (playerId >= 4 && playerId < NETRACE_MAX_HUMANS) {
+        return &sExtraControllers[playerId - 4];
+    }
+    if (playerId < 0 || playerId >= NUM_PLAYERS) {
+        return &gControllers[0];
+    }
+    return &gControllers[playerId];
+}
+
+// Mirrors update_controller() in main.c for players 5-8.
+void netrace_set_extra_pad(s32 index, u16 button, s8 stickX, s8 stickY) {
+    struct Controller* controller;
+    u16 stick;
+
+    if (index < 0 || index >= NETRACE_MAX_HUMANS - 4) {
+        return;
+    }
+    controller = &sExtraControllers[index];
+    controller->rawStickX = stickX;
+    controller->rawStickY = stickY;
+    controller->rightRawStickX = 0;
+    controller->rightRawStickY = 0;
+    if ((button & 4) != 0) {
+        button |= Z_TRIG;
+    }
+    controller->buttonPressed = button & (button ^ controller->button);
+    controller->buttonDepressed = controller->button & (button ^ controller->button);
+    controller->button = button;
+
+    stick = 0;
+    if (controller->rawStickX < -50) {
+        stick |= L_JPAD;
+    }
+    if (controller->rawStickX > 50) {
+        stick |= R_JPAD;
+    }
+    if (controller->rawStickY < -50) {
+        stick |= D_JPAD;
+    }
+    if (controller->rawStickY > 50) {
+        stick |= U_JPAD;
+    }
+    controller->stickPressed = stick & (stick ^ controller->stickDirection);
+    controller->stickDepressed = controller->stickDirection & (stick ^ controller->stickDirection);
+    controller->stickDirection = stick;
+}
+
+// Called by the 1P Grand Prix spawn before karts are created. chooseCPUPlayers[k - 1]
+// is the character of kart k. Human karts get their player's pick; the
+// remaining CPU karts keep their character unless a human took it, in which
+// case they get the next free one. Same inputs on every PC, same grid.
+void netrace_prepare_grid(void) {
+    bool used[8] = { false };
+    s32 k;
+    s32 next;
+
+    sFinishWaitTicks = 0;
+    if (!netrace_active()) {
+        return;
+    }
+    used[gCharacterSelections[0] & 7] = true;
+    for (k = 1; k < gNetHumanCount && k < NUM_PLAYERS; k++) {
+        chooseCPUPlayers[k - 1] = gNetCharacters[k] & 7;
+        used[chooseCPUPlayers[k - 1]] = true;
+    }
+    for (k = gNetHumanCount; k < NUM_PLAYERS; k++) {
+        s16 c = chooseCPUPlayers[k - 1] & 7;
+        if (used[c]) {
+            for (next = 0; next < 8 && used[next]; next++) {
+            }
+            // With duplicate human picks there are always free characters;
+            // with 8 humans this loop is never reached.
+            c = (s16) (next & 7);
+        }
+        chooseCPUPlayers[k - 1] = c;
+        used[c] = true;
+    }
+}
+
+void netrace_spawn_humans(void) {
+    s32 k;
+
+    if (!netrace_active()) {
+        return;
+    }
+    for (k = 1; k < gNetHumanCount && k < NUM_PLAYERS; k++) {
+        Player* player = &gPlayers[k];
+        player->type = (player->type & ~PLAYER_CPU) | PLAYER_HUMAN;
+    }
+}
+
+// In a 1P race the second screen context's camera only serves the end-of-race
+// shot. Each PC points it at its own kart and renders through it, so the
+// cameras that game logic consults (camera 0, following P1) stay identical
+// everywhere.
+void netrace_attach_view_camera(void) {
+    s32 view = netrace_view_player();
+    Camera* camera = gScreenContexts[PLAYER_TWO].raceCamera;
+
+    if (view == 0 || camera == NULL) {
+        return;
+    }
+    camera->playerId = view;
+}
+
+bool netrace_all_humans_finished(void) {
+    s32 k;
+
+    if (!netrace_active()) {
+        return true;
+    }
+    if (++sFinishWaitTicks >= NETRACE_FINISH_TIMEOUT_TICKS) {
+        return true;
+    }
+    for (k = 0; k < gNetHumanCount && k < NUM_PLAYERS; k++) {
+        if ((gPlayers[k].type & PLAYER_EXISTS) && !(gPlayers[k].type & PLAYER_CINEMATIC_MODE)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+void netrace_reset_finish_timer(void) {
+    sFinishWaitTicks = 0;
+}
diff --git a/src/port/netplay/netrace.h b/src/port/netplay/netrace.h
new file mode 100644
index 0000000..3289998
--- /dev/null
+++ b/src/port/netplay/netrace.h
@@ -0,0 +1,56 @@
+#ifndef SPAGHETTI_NETRACE_H
+#define SPAGHETTI_NETRACE_H
+
+// "Big race": a LAN netplay Grand Prix with up to 8 human drivers, one per PC.
+//
+// The simulation is the stock 1-player Grand Prix (8 karts) on every PC, with
+// karts 2..N switched from CPU to human control by players on other PCs. Each
+// PC then renders its own kart full-screen. Everything here is a no-op unless
+// netplay switched big-race mode on.
+
+#include <libultraship.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct Controller;
+
+#define NETRACE_MAX_HUMANS 8
+
+// Set from the netplay start state (identical on every PC).
+extern s32 gNetBigRace;                        // 1 when the match uses big-race mode
+extern s32 gNetHumanCount;                     // human drivers, 1..8
+extern s8 gNetCharacters[NETRACE_MAX_HUMANS];  // characters for drivers 2..8 ([0] unused: P1 uses the menu)
+// Local, render-only: which kart this PC shows. Never read by game logic.
+extern s32 gNetViewPlayer;
+
+// True while a big-race Grand Prix is actually running (1P Grand Prix selected).
+bool netrace_active(void);
+// True if gPlayers[playerId] is driven by a netplay human (P2..P8).
+bool netrace_is_remote_human(s32 playerId);
+// Number of human players the per-human logic should process.
+s32 netrace_human_loop_count(void);
+// Kart shown on this PC's screen (0 when big race is off).
+s32 netrace_view_player(void);
+
+// Controller for any player index 0..7. Players 1-4 use gControllers as
+// always; players 5-8 use separate storage so gControllers[4..7] keep their
+// stock roles (combined input, ghost replays).
+struct Controller* get_player_controller(s32 playerId);
+// Feed players 5-8's raw inputs for this frame.
+void netrace_set_extra_pad(s32 index, u16 button, s8 stickX, s8 stickY);
+
+// Hooks called from the race code.
+void netrace_prepare_grid(void);          // before the 1P GP spawn: characters for every kart
+void netrace_spawn_humans(void);          // after the 1P GP spawn: CPU -> human for P2..PN
+void netrace_attach_view_camera(void);    // after cameras spawn: point the spare camera at our kart
+bool netrace_all_humans_finished(void);   // race end gate
+void netrace_reset_finish_timer(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
