diff --git a/src/port/netplay/NetplayCore.cpp b/src/port/netplay/NetplayCore.cpp
new file mode 100644
index 0000000..5cdf3dc
--- /dev/null
+++ b/src/port/netplay/NetplayCore.cpp
@@ -0,0 +1,1015 @@
+#include "NetplayCore.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstring>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <winsock2.h>
+#include <ws2tcpip.h>
+using SockLen = int;
+#define NS(s) ((SOCKET) (s))
+#define NP_CLOSESOCK closesocket
+#define NP_WOULDBLOCK(e) ((e) == WSAEWOULDBLOCK)
+#define NP_INPROGRESS(e) ((e) == WSAEWOULDBLOCK || (e) == WSAEINPROGRESS)
+static int NpLastError() {
+    return WSAGetLastError();
+}
+#else
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <sys/select.h>
+#include <sys/socket.h>
+#include <unistd.h>
+using SockLen = socklen_t;
+#define NS(s) ((int) (s))
+#define NP_CLOSESOCK ::close
+#define NP_WOULDBLOCK(e) ((e) == EWOULDBLOCK || (e) == EAGAIN)
+#define NP_INPROGRESS(e) ((e) == EINPROGRESS || (e) == EWOULDBLOCK || (e) == EAGAIN)
+static int NpLastError() {
+    return errno;
+}
+#endif
+
+#if defined(MSG_NOSIGNAL)
+#define NP_SEND_FLAGS MSG_NOSIGNAL
+#else
+#define NP_SEND_FLAGS 0
+#endif
+
+namespace Netplay {
+
+namespace {
+
+constexpr uint32_t kMagic = 0x4D4B3634; // "MK64"
+constexpr uint16_t kProtocolVersion = 1;
+constexpr uint32_t kMaxMessage = 1u << 20;
+
+enum MsgType : uint8_t {
+    MSG_HELLO = 1,  // C->H  magic, version, name, compat blob
+    MSG_WELCOME,    // H->C  slot
+    MSG_REJECT,     // H->C  reason
+    MSG_LOBBY,      // H->C  input delay, player table
+    MSG_START,      // H->C  your slot, player count, input delay, start state
+    MSG_INPUT,      // C->H  frame, pad
+    MSG_FRAME,      // H->C  frame, pads
+    MSG_HASH,       // C->H  frame, hash
+    MSG_DESYNC,     // H->C  frame
+    MSG_BYE,        // any   reason
+    MSG_PROFILE,    // C->H  profile byte
+};
+
+#ifdef _WIN32
+bool sWinsockReady = false;
+#endif
+
+bool EnsureSockets() {
+#ifdef _WIN32
+    if (!sWinsockReady) {
+        WSADATA data;
+        if (WSAStartup(MAKEWORD(2, 2), &data) != 0) {
+            return false;
+        }
+        sWinsockReady = true;
+    }
+#endif
+    return true;
+}
+
+bool SetNonBlocking(intptr_t s) {
+#ifdef _WIN32
+    u_long mode = 1;
+    return ioctlsocket(NS(s), FIONBIO, &mode) == 0;
+#else
+    int flags = fcntl((int) s, F_GETFL, 0);
+    return flags >= 0 && fcntl((int) s, F_SETFL, flags | O_NONBLOCK) == 0;
+#endif
+}
+
+void TuneSocket(intptr_t s) {
+    int one = 1;
+    setsockopt(NS(s), IPPROTO_TCP, TCP_NODELAY, (const char*) &one, sizeof(one));
+#ifdef SO_NOSIGPIPE
+    setsockopt(NS(s), SOL_SOCKET, SO_NOSIGPIPE, (const char*) &one, sizeof(one));
+#endif
+}
+
+void CloseSock(intptr_t& s) {
+    if (s != -1) {
+        NP_CLOSESOCK(NS(s));
+        s = -1;
+    }
+}
+
+// ---- little-endian serialization ----
+struct Writer {
+    std::vector<uint8_t> buf;
+    void U8(uint8_t v) {
+        buf.push_back(v);
+    }
+    void U16(uint16_t v) {
+        U8(v & 0xFF);
+        U8(v >> 8);
+    }
+    void U32(uint32_t v) {
+        U16(v & 0xFFFF);
+        U16(v >> 16);
+    }
+    void Str(const std::string& s) {
+        U16((uint16_t) std::min<size_t>(s.size(), 0xFFFF));
+        buf.insert(buf.end(), s.begin(), s.begin() + std::min<size_t>(s.size(), 0xFFFF));
+    }
+    void Blob(const std::vector<uint8_t>& b) {
+        U32((uint32_t) b.size());
+        buf.insert(buf.end(), b.begin(), b.end());
+    }
+    void PadV(const Pad& p) {
+        U32(p.button);
+        U8((uint8_t) p.stickX);
+        U8((uint8_t) p.stickY);
+        U8((uint8_t) p.rightStickX);
+        U8((uint8_t) p.rightStickY);
+    }
+};
+
+struct Reader {
+    const uint8_t* p;
+    size_t n;
+    bool ok = true;
+    Reader(const uint8_t* data, size_t len) : p(data), n(len) {
+    }
+    bool Need(size_t k) {
+        if (!ok || n < k) {
+            ok = false;
+            return false;
+        }
+        return true;
+    }
+    uint8_t U8() {
+        if (!Need(1)) {
+            return 0;
+        }
+        uint8_t v = *p;
+        p++;
+        n--;
+        return v;
+    }
+    uint16_t U16() {
+        uint16_t lo = U8();
+        return lo | (uint16_t) (U8() << 8);
+    }
+    uint32_t U32() {
+        uint32_t lo = U16();
+        return lo | ((uint32_t) U16() << 16);
+    }
+    std::string Str() {
+        uint16_t len = U16();
+        if (!Need(len)) {
+            return {};
+        }
+        std::string s((const char*) p, len);
+        p += len;
+        n -= len;
+        return s;
+    }
+    std::vector<uint8_t> Blob() {
+        uint32_t len = U32();
+        if (!Need(len)) {
+            return {};
+        }
+        std::vector<uint8_t> b(p, p + len);
+        p += len;
+        n -= len;
+        return b;
+    }
+    Pad PadV() {
+        Pad pad;
+        pad.button = U32();
+        pad.stickX = (int8_t) U8();
+        pad.stickY = (int8_t) U8();
+        pad.rightStickX = (int8_t) U8();
+        pad.rightStickY = (int8_t) U8();
+        return pad;
+    }
+};
+
+double NowSeconds() {
+    using namespace std::chrono;
+    return duration<double>(steady_clock::now().time_since_epoch()).count();
+}
+
+std::string CleanName(const std::string& name, int slot) {
+    std::string out;
+    for (char ch : name) {
+        if (ch >= 32 && ch < 127) {
+            out.push_back(ch);
+        }
+        if (out.size() >= 16) {
+            break;
+        }
+    }
+    if (out.empty()) {
+        out = "Player " + std::to_string(slot + 1);
+    }
+    return out;
+}
+
+} // namespace
+
+struct Session::Conn {
+    intptr_t sock = -1;
+    std::vector<uint8_t> rx;
+    std::vector<uint8_t> tx;
+    bool connecting = false; // client: non-blocking connect still in flight
+    bool handshaken = false; // host: HELLO accepted
+    bool closing = false;    // flush tx then drop
+    bool dead = false;
+
+    ~Conn() {
+        CloseSock(sock);
+    }
+
+    void Flush() {
+        while (!tx.empty() && !dead && !connecting) {
+            int sent = (int) send(NS(sock), (const char*) tx.data(), (int) std::min<size_t>(tx.size(), 1 << 16),
+                                  NP_SEND_FLAGS);
+            if (sent > 0) {
+                tx.erase(tx.begin(), tx.begin() + sent);
+                continue;
+            }
+            if (sent < 0 && NP_WOULDBLOCK(NpLastError())) {
+                return;
+            }
+            dead = true;
+        }
+    }
+};
+
+Session& Get() {
+    static Session sSession;
+    return sSession;
+}
+
+Session::Session() {
+    mInputs.resize(kRing);
+    mHashes.resize(kRing);
+}
+
+Session::~Session() {
+    Disconnect();
+}
+
+int Session::PlayerCount() const {
+    if (mPhase == Phase::InGame) {
+        return mPlayerCount;
+    }
+    int n = 0;
+    for (auto& p : mPlayers) {
+        n += p.connected ? 1 : 0;
+    }
+    return n;
+}
+
+void Session::SetLocalProfile(uint8_t profile) {
+    mLocalProfile = profile;
+    if (mRole == Role::Host) {
+        mPlayers[0].profile = profile;
+        if (mPhase == Phase::Lobby) {
+            BroadcastLobby();
+        }
+    } else if (mRole == Role::Client && mPhase == Phase::Lobby && mConns[0] != nullptr) {
+        Writer w;
+        w.U8(profile);
+        SendTo(*mConns[0], MSG_PROFILE, w.buf);
+    }
+}
+
+void Session::SetLobbyOptions(uint8_t options) {
+    if (mRole == Role::Host) {
+        mLobbyOptions = options;
+        if (mPhase == Phase::Lobby) {
+            BroadcastLobby();
+        }
+    }
+}
+
+void Session::SetInputDelay(int frames) {
+    mInputDelay = std::clamp(frames, 0, kMaxInputDelay);
+    if (mRole == Role::Host && mPhase == Phase::Lobby) {
+        BroadcastLobby();
+    }
+}
+
+void Session::ResetState() {
+    for (auto& c : mConns) {
+        delete c;
+        c = nullptr;
+    }
+    CloseSock(mListenSock);
+    mRole = Role::None;
+    mPhase = Phase::Idle;
+    mLocalSlot = 0;
+    mPlayerCount = 0;
+    mFrame = 0;
+    mStartRequested = false;
+    mStartPending = false;
+    mPlayers = {};
+    mDesyncFrame = UINT32_MAX;
+    mLastStallMs = 0.0;
+    std::fill(mInputs.begin(), mInputs.end(), InputSlot{});
+    std::fill(mHashes.begin(), mHashes.end(), HashSlot{});
+}
+
+void Session::Disconnect(const std::string& reason) {
+    if (mRole == Role::None) {
+        return;
+    }
+    bool wasInGame = mPhase == Phase::InGame;
+    Writer w;
+    w.Str(reason.empty() ? "Player left" : reason);
+    for (auto* c : mConns) {
+        if (c != nullptr && !c->connecting) {
+            SendTo(*c, MSG_BYE, w.buf);
+            c->Flush();
+        }
+    }
+    ResetState();
+    mStatus = reason.empty() ? "Disconnected" : reason;
+    if (wasInGame && mHooks.onSessionEnd) {
+        mHooks.onSessionEnd();
+    }
+}
+
+void Session::Fail(const std::string& reason) {
+    mLastError = reason;
+    Disconnect(reason);
+}
+
+// ------------------------------------------------------------------ hosting
+
+bool Session::Host(uint16_t port, const std::string& name) {
+    Disconnect();
+    mLastError.clear();
+    if (!EnsureSockets()) {
+        mLastError = "Could not initialise networking";
+        return false;
+    }
+    intptr_t s = (intptr_t) socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    if (s == -1) {
+        mLastError = "Could not create socket";
+        return false;
+    }
+    int one = 1;
+    setsockopt(NS(s), SOL_SOCKET, SO_REUSEADDR, (const char*) &one, sizeof(one));
+    sockaddr_in addr{};
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = htonl(INADDR_ANY);
+    addr.sin_port = htons(port);
+    if (bind(NS(s), (sockaddr*) &addr, sizeof(addr)) != 0 || listen(NS(s), 4) != 0 || !SetNonBlocking(s)) {
+        CloseSock(s);
+        mLastError = "Could not listen on port " + std::to_string(port) + " (already in use?)";
+        return false;
+    }
+    mListenSock = s;
+    mRole = Role::Host;
+    mPhase = Phase::Lobby;
+    mLocalSlot = 0;
+    mLocalName = CleanName(name, 0);
+    mPlayers[0] = { true, mLocalName, mLocalProfile };
+    mStatus = "Hosting on port " + std::to_string(port) + " - waiting for players";
+    return true;
+}
+
+void Session::AcceptNewClients() {
+    while (mListenSock != -1) {
+        sockaddr_in from{};
+        SockLen len = sizeof(from);
+        auto raw = accept(NS(mListenSock), (sockaddr*) &from, &len);
+        intptr_t s = (intptr_t) raw;
+        if (s == -1) {
+            return;
+        }
+        SetNonBlocking(s);
+        TuneSocket(s);
+        auto* c = new Conn();
+        c->sock = s;
+
+        int slot = -1;
+        if (mPhase == Phase::Lobby) {
+            for (int i = 1; i < kMaxPlayers; i++) {
+                if (mConns[i] == nullptr) {
+                    slot = i;
+                    break;
+                }
+            }
+        }
+        if (slot < 0) {
+            Writer w;
+            w.Str(mPhase == Phase::InGame ? "A match is already running" : "The lobby is full");
+            SendTo(*c, MSG_REJECT, w.buf);
+            c->Flush();
+            delete c;
+            continue;
+        }
+        mConns[slot] = c; // becomes a player once HELLO checks out
+    }
+}
+
+bool Session::RequestStart() {
+    if (mRole != Role::Host || mPhase != Phase::Lobby || PlayerCount() < 2) {
+        return false;
+    }
+    mStartRequested = true;
+    return true;
+}
+
+void Session::BroadcastLobby() {
+    Writer w;
+    w.U8((uint8_t) mInputDelay);
+    w.U8(mLobbyOptions);
+    for (auto& p : mPlayers) {
+        w.U8(p.connected ? 1 : 0);
+        w.Str(p.name);
+        w.U8(p.profile);
+    }
+    for (int i = 1; i < kMaxPlayers; i++) {
+        if (mConns[i] != nullptr && mConns[i]->handshaken) {
+            SendTo(*mConns[i], MSG_LOBBY, w.buf);
+        }
+    }
+}
+
+// ------------------------------------------------------------------ joining
+
+bool Session::Join(const std::string& address, uint16_t port, const std::string& name) {
+    Disconnect();
+    mLastError.clear();
+    if (!EnsureSockets()) {
+        mLastError = "Could not initialise networking";
+        return false;
+    }
+    addrinfo hints{};
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+    addrinfo* res = nullptr;
+    std::string portStr = std::to_string(port);
+    if (getaddrinfo(address.c_str(), portStr.c_str(), &hints, &res) != 0 || res == nullptr) {
+        mLastError = "Could not resolve '" + address + "'";
+        return false;
+    }
+    intptr_t s = (intptr_t) socket(res->ai_family, res->ai_socktype, res->ai_protocol);
+    if (s == -1 || !SetNonBlocking(s)) {
+        freeaddrinfo(res);
+        CloseSock(s);
+        mLastError = "Could not create socket";
+        return false;
+    }
+    TuneSocket(s);
+    int rc = connect(NS(s), res->ai_addr, (SockLen) res->ai_addrlen);
+    freeaddrinfo(res);
+    if (rc != 0 && !NP_INPROGRESS(NpLastError())) {
+        CloseSock(s);
+        mLastError = "Could not connect to " + address;
+        return false;
+    }
+    auto* c = new Conn();
+    c->sock = s;
+    c->connecting = true;
+    mConns[0] = c;
+    mRole = Role::Client;
+    mPhase = Phase::Connecting;
+    mLocalName = CleanName(name, 1);
+    mStatus = "Connecting to " + address + ":" + portStr + "...";
+    mConnectStarted = NowSeconds();
+    return true;
+}
+
+// ------------------------------------------------------------------ messaging
+
+void Session::SendTo(Conn& c, uint8_t type, const std::vector<uint8_t>& payload) {
+    uint32_t len = (uint32_t) payload.size() + 1;
+    c.tx.push_back(len & 0xFF);
+    c.tx.push_back((len >> 8) & 0xFF);
+    c.tx.push_back((len >> 16) & 0xFF);
+    c.tx.push_back((len >> 24) & 0xFF);
+    c.tx.push_back(type);
+    c.tx.insert(c.tx.end(), payload.begin(), payload.end());
+    c.Flush();
+}
+
+void Session::Broadcast(uint8_t type, const std::vector<uint8_t>& payload) {
+    for (int i = 1; i < kMaxPlayers; i++) {
+        if (mConns[i] != nullptr && mConns[i]->handshaken) {
+            SendTo(*mConns[i], type, payload);
+        }
+    }
+}
+
+// Reads everything available on a connection and dispatches whole messages.
+// Returns false when the connection is gone.
+bool Session::PumpConn(Conn& c, int slotIndex) {
+    if (c.dead) {
+        return false;
+    }
+    if (c.connecting) {
+        fd_set wset, eset;
+        FD_ZERO(&wset);
+        FD_ZERO(&eset);
+        FD_SET(NS(c.sock), &wset);
+        FD_SET(NS(c.sock), &eset);
+        timeval tv{ 0, 0 };
+        if (select((int) c.sock + 1, nullptr, &wset, &eset, &tv) <= 0) {
+            return true; // still connecting
+        }
+        int err = 0;
+        SockLen len = sizeof(err);
+        getsockopt(NS(c.sock), SOL_SOCKET, SO_ERROR, (char*) &err, &len);
+        if (err != 0 || FD_ISSET(NS(c.sock), &eset)) {
+            return false;
+        }
+        c.connecting = false;
+        if (mHooks.compatBlob == nullptr) {
+            return false;
+        }
+        Writer w;
+        w.U32(kMagic);
+        w.U16(kProtocolVersion);
+        w.Str(mLocalName);
+        w.Blob(mHooks.compatBlob());
+        SendTo(c, MSG_HELLO, w.buf);
+    }
+
+    uint8_t buf[4096];
+    for (;;) {
+        int n = (int) recv(NS(c.sock), (char*) buf, sizeof(buf), 0);
+        if (n > 0) {
+            c.rx.insert(c.rx.end(), buf, buf + n);
+            continue;
+        }
+        if (n == 0) {
+            c.dead = true;
+            break;
+        }
+        if (NP_WOULDBLOCK(NpLastError())) {
+            break;
+        }
+        c.dead = true;
+        break;
+    }
+
+    size_t off = 0;
+    while (c.rx.size() - off >= 5) {
+        const uint8_t* h = c.rx.data() + off;
+        uint32_t len = h[0] | (h[1] << 8) | (h[2] << 16) | ((uint32_t) h[3] << 24);
+        if (len == 0 || len > kMaxMessage) {
+            c.dead = true;
+            break;
+        }
+        if (c.rx.size() - off < 4 + (size_t) len) {
+            break;
+        }
+        HandleMessage(c, slotIndex, h[4], h + 5, len - 1);
+        off += 4 + len;
+        if (c.closing || mRole == Role::None) {
+            break;
+        }
+    }
+    if (mRole == Role::None) {
+        return false; // session was torn down while handling
+    }
+    c.rx.erase(c.rx.begin(), c.rx.begin() + std::min(off, c.rx.size()));
+    c.Flush();
+    return !c.dead && !c.closing;
+}
+
+void Session::HandleMessage(Conn& c, int slotIndex, uint8_t type, const uint8_t* data, size_t len) {
+    Reader r(data, len);
+
+    if (mRole == Role::Host) {
+        if (!c.handshaken) {
+            if (type != MSG_HELLO) {
+                c.closing = true;
+                return;
+            }
+            uint32_t magic = r.U32();
+            uint16_t version = r.U16();
+            std::string name = r.Str();
+            std::vector<uint8_t> blob = r.Blob();
+            std::string reject;
+            if (!r.ok || magic != kMagic) {
+                reject = "Not a SpaghettiKart netplay client";
+            } else if (version != kProtocolVersion) {
+                reject = "Netplay version mismatch (host " + std::to_string(kProtocolVersion) + ", you " +
+                         std::to_string(version) + ")";
+            } else if (mHooks.compatBlob && blob != mHooks.compatBlob()) {
+                reject = mHooks.describeMismatch ? mHooks.describeMismatch(mHooks.compatBlob(), blob)
+                                                 : "Game setup differs from the host";
+            }
+            if (!reject.empty()) {
+                Writer w;
+                w.Str(reject);
+                SendTo(c, MSG_REJECT, w.buf);
+                c.closing = true;
+                return;
+            }
+            c.handshaken = true;
+            mPlayers[slotIndex] = { true, CleanName(name, slotIndex) };
+            Writer w;
+            w.U8((uint8_t) slotIndex);
+            SendTo(c, MSG_WELCOME, w.buf);
+            BroadcastLobby();
+            mStatus = "Lobby: " + std::to_string(PlayerCount()) + " players";
+            return;
+        }
+        switch (type) {
+            case MSG_INPUT: {
+                uint32_t frame = r.U32();
+                Pad pad = r.PadV();
+                if (r.ok && mPhase == Phase::InGame && slotIndex < mPlayerCount) {
+                    StoreInput(frame, slotIndex, pad);
+                }
+                break;
+            }
+            case MSG_HASH: {
+                uint32_t frame = r.U32();
+                uint32_t hash = r.U32();
+                if (r.ok && mPhase == Phase::InGame) {
+                    RecordHash(frame, slotIndex, hash);
+                }
+                break;
+            }
+            case MSG_PROFILE: {
+                uint8_t profile = r.U8();
+                if (r.ok && mPhase == Phase::Lobby) {
+                    mPlayers[slotIndex].profile = profile;
+                    BroadcastLobby();
+                }
+                break;
+            }
+            case MSG_BYE:
+                c.closing = true;
+                break;
+            default:
+                break;
+        }
+        return;
+    }
+
+    // ---- client ----
+    switch (type) {
+        case MSG_WELCOME:
+            mLocalSlot = r.U8();
+            mPhase = Phase::Lobby;
+            mStatus = "Connected as player " + std::to_string(mLocalSlot + 1) + " - waiting for host";
+            {
+                Writer w;
+                w.U8(mLocalProfile);
+                SendTo(c, MSG_PROFILE, w.buf);
+            }
+            break;
+        case MSG_REJECT:
+        case MSG_BYE: {
+            std::string reason = r.Str();
+            if (reason.empty()) {
+                reason = "Host closed the session";
+            }
+            mPendingFail = (type == MSG_REJECT ? "Rejected: " : "") + reason;
+            c.closing = true;
+            break;
+        }
+        case MSG_LOBBY: {
+            mInputDelay = r.U8();
+            mLobbyOptions = r.U8();
+            for (auto& p : mPlayers) {
+                p.connected = r.U8() != 0;
+                p.name = r.Str();
+                p.profile = r.U8();
+            }
+            break;
+        }
+        case MSG_START: {
+            int slot = r.U8();
+            int count = r.U8();
+            int delay = r.U8();
+            std::vector<uint8_t> state = r.Blob();
+            if (!r.ok || count < 1 || count > kMaxPlayers || slot >= count) {
+                mPendingFail = "Malformed start message";
+                c.closing = true;
+                break;
+            }
+            std::string err;
+            if (mHooks.applyStartState && !mHooks.applyStartState(state, err)) {
+                mPendingFail = "Could not apply host settings: " + err;
+                c.closing = true;
+                break;
+            }
+            BeginInGame(slot, count, delay);
+            mStartPending = true;
+            break;
+        }
+        case MSG_FRAME: {
+            uint32_t frame = r.U32();
+            int n = r.U8();
+            FramePads pads{};
+            for (int i = 0; i < n && i < kMaxPlayers; i++) {
+                pads[i] = r.PadV();
+            }
+            if (r.ok && mPhase == Phase::InGame) {
+                StoreFrame(frame, pads);
+            }
+            break;
+        }
+        case MSG_DESYNC: {
+            uint32_t frame = r.U32();
+            if (mDesyncFrame == UINT32_MAX) {
+                mDesyncFrame = frame;
+            }
+            break;
+        }
+        default:
+            break;
+    }
+}
+
+// ------------------------------------------------------------------ pumping
+
+bool Session::Update() {
+    if (mRole == Role::None) {
+        return false;
+    }
+
+    if (mRole == Role::Host) {
+        AcceptNewClients();
+        for (int i = 1; i < kMaxPlayers; i++) {
+            Conn* c = mConns[i];
+            if (c == nullptr) {
+                continue;
+            }
+            if (!PumpConn(*c, i)) {
+                if (mRole == Role::None) {
+                    return false;
+                }
+                bool wasPlayer = c->handshaken;
+                std::string who = mPlayers[i].name;
+                delete c;
+                mConns[i] = nullptr;
+                mPlayers[i] = {};
+                if (wasPlayer && mPhase == Phase::InGame && i < mPlayerCount) {
+                    Fail(who + " disconnected");
+                    return false;
+                }
+                if (wasPlayer) {
+                    BroadcastLobby();
+                    mStatus = "Lobby: " + std::to_string(PlayerCount()) + " players";
+                }
+            }
+        }
+
+        if (mStartRequested && mPhase == Phase::Lobby) {
+            mStartRequested = false;
+            if (PlayerCount() < 2) {
+                return false;
+            }
+            // Pack players into slots 0..n-1 so the game sees P1..Pn.
+            std::array<Conn*, kMaxPlayers> packed{};
+            std::array<PlayerInfo, kMaxPlayers> packedInfo{};
+            packedInfo[0] = mPlayers[0];
+            int n = 1;
+            for (int i = 1; i < kMaxPlayers; i++) {
+                if (mConns[i] != nullptr && mConns[i]->handshaken) {
+                    packed[n] = mConns[i];
+                    packedInfo[n] = mPlayers[i];
+                    n++;
+                } else if (mConns[i] != nullptr) {
+                    // Half-open connection that never said hello: drop it.
+                    delete mConns[i];
+                }
+            }
+            mConns = packed;
+            mPlayers = packedInfo;
+            BroadcastLobby(); // clients learn the final P1..Pn names
+
+            std::vector<uint8_t> state = mHooks.captureStartState ? mHooks.captureStartState() : std::vector<uint8_t>{};
+            for (int i = 1; i < n; i++) {
+                Writer w;
+                w.U8((uint8_t) i);
+                w.U8((uint8_t) n);
+                w.U8((uint8_t) mInputDelay);
+                w.Blob(state);
+                SendTo(*mConns[i], MSG_START, w.buf);
+            }
+            BeginInGame(0, n, mInputDelay);
+            return true;
+        }
+        return false;
+    }
+
+    // ---- client ----
+    Conn* host = mConns[0];
+    if (host == nullptr) {
+        return false;
+    }
+    if (mPhase == Phase::Connecting && host->connecting && NowSeconds() - mConnectStarted > mTimeoutSeconds) {
+        Fail("Timed out connecting to host");
+        return false;
+    }
+    if (!PumpConn(*host, 0)) {
+        if (mRole == Role::None) {
+            return false;
+        }
+        std::string reason = mPendingFail;
+        mPendingFail.clear();
+        if (reason.empty()) {
+            reason = mPhase == Phase::Connecting ? "Could not connect to host" : "Lost connection to host";
+        }
+        Fail(reason);
+        return false;
+    }
+    if (mStartPending) {
+        mStartPending = false;
+        mStatus = "In game as player " + std::to_string(mLocalSlot + 1);
+        return true;
+    }
+    return false;
+}
+
+bool Session::WaitForNetwork(int timeoutMs) {
+    fd_set rset;
+    FD_ZERO(&rset);
+    intptr_t maxFd = -1;
+    auto add = [&](intptr_t s) {
+        if (s != -1) {
+            FD_SET(NS(s), &rset);
+            maxFd = std::max(maxFd, s);
+        }
+    };
+    add(mListenSock);
+    for (auto* c : mConns) {
+        if (c != nullptr) {
+            add(c->sock);
+        }
+    }
+    if (maxFd == -1) {
+        return false;
+    }
+    timeval tv{ timeoutMs / 1000, (timeoutMs % 1000) * 1000 };
+    return select((int) maxFd + 1, &rset, nullptr, nullptr, &tv) > 0;
+}
+
+// ------------------------------------------------------------------ lockstep
+
+void Session::BeginInGame(int slot, int playerCount, int inputDelay) {
+    mLocalSlot = slot;
+    mPlayerCount = playerCount;
+    mInputDelay = std::clamp(inputDelay, 0, kMaxInputDelay);
+    mFrame = 0;
+    mDesyncFrame = UINT32_MAX;
+    mPhase = Phase::InGame;
+    std::fill(mInputs.begin(), mInputs.end(), InputSlot{});
+    std::fill(mHashes.begin(), mHashes.end(), HashSlot{});
+    // Nobody has input for the first `delay` frames: everyone starts neutral.
+    for (uint32_t f = 0; f < (uint32_t) mInputDelay; f++) {
+        InputSlot& s = SlotFor(f);
+        s.haveMask = ExpectedMask();
+    }
+    if (mRole == Role::Host) {
+        mStatus = "In game - " + std::to_string(playerCount) + " players";
+    }
+}
+
+uint8_t Session::ExpectedMask() const {
+    return (uint8_t) ((1u << mPlayerCount) - 1);
+}
+
+Session::InputSlot& Session::SlotFor(uint32_t frame) {
+    InputSlot& s = mInputs[frame % kRing];
+    if (s.frame != frame) {
+        s = InputSlot{};
+        s.frame = frame;
+    }
+    return s;
+}
+
+void Session::StoreInput(uint32_t frame, int player, const Pad& pad) {
+    // Ignore stale or wildly-ahead frames; the ring only holds a window.
+    if (frame < mFrame || frame >= mFrame + kRing / 2) {
+        return;
+    }
+    InputSlot& s = SlotFor(frame);
+    s.pads[player] = pad;
+    s.haveMask |= (uint8_t) (1u << player);
+}
+
+void Session::StoreFrame(uint32_t frame, const FramePads& pads) {
+    if (frame < mFrame || frame > mFrame + kRing / 2) {
+        return;
+    }
+    InputSlot& s = SlotFor(frame);
+    s.pads = pads;
+    s.haveMask = ExpectedMask();
+}
+
+void Session::RecordHash(uint32_t frame, int player, uint32_t hash) {
+    HashSlot& h = mHashes[(frame / std::max<uint32_t>(mHashInterval, 1)) % kRing];
+    if (h.frame != frame) {
+        h = HashSlot{};
+        h.frame = frame;
+    }
+    h.hash[player] = hash;
+    h.haveMask |= (uint8_t) (1u << player);
+    if (h.haveMask != ExpectedMask() || mDesyncFrame != UINT32_MAX) {
+        return;
+    }
+    for (int i = 1; i < mPlayerCount; i++) {
+        if (h.hash[i] != h.hash[0]) {
+            mDesyncFrame = frame;
+            Writer w;
+            w.U32(frame);
+            Broadcast(MSG_DESYNC, w.buf);
+            return;
+        }
+    }
+}
+
+bool Session::ExchangeInputs(const Pad& local, FramePads& out) {
+    if (mPhase != Phase::InGame) {
+        return false;
+    }
+
+    // 1. Publish our input for a few frames in the future.
+    uint32_t target = mFrame + (uint32_t) mInputDelay;
+    if (mRole == Role::Host) {
+        StoreInput(target, 0, local);
+    } else {
+        Writer w;
+        w.U32(target);
+        w.PadV(local);
+        SendTo(*mConns[0], MSG_INPUT, w.buf);
+    }
+
+    // 2. Periodic desync check on the state *before* this frame runs.
+    if (mHooks.stateHash && mHashInterval > 0 && mFrame % mHashInterval == 0) {
+        uint32_t h = mHooks.stateHash();
+        if (mRole == Role::Host) {
+            RecordHash(mFrame, 0, h);
+        } else {
+            Writer w;
+            w.U32(mFrame);
+            w.U32(h);
+            SendTo(*mConns[0], MSG_HASH, w.buf);
+        }
+    }
+
+    // 3. Wait for everybody's input for the current frame.
+    double start = NowSeconds();
+    for (;;) {
+        Update();
+        if (mPhase != Phase::InGame) {
+            return false; // dropped while waiting
+        }
+        InputSlot& s = SlotFor(mFrame);
+        if (s.haveMask == ExpectedMask()) {
+            break;
+        }
+        double waited = NowSeconds() - start;
+        if (waited > mTimeoutSeconds) {
+            std::string who;
+            for (int i = 0; i < mPlayerCount; i++) {
+                if (!(s.haveMask & (1u << i))) {
+                    who = mPlayers[i].name.empty() ? "player " + std::to_string(i + 1) : mPlayers[i].name;
+                    break;
+                }
+            }
+            Fail("Timed out waiting for " + (who.empty() ? std::string("the host") : who));
+            return false;
+        }
+        WaitForNetwork(2);
+    }
+    mLastStallMs = (NowSeconds() - start) * 1000.0;
+
+    InputSlot& s = SlotFor(mFrame);
+    if (mRole == Role::Host) {
+        Writer w;
+        w.U32(mFrame);
+        w.U8((uint8_t) mPlayerCount);
+        for (int i = 0; i < mPlayerCount; i++) {
+            w.PadV(s.pads[i]);
+        }
+        Broadcast(MSG_FRAME, w.buf);
+    }
+    out = s.pads;
+    for (int i = mPlayerCount; i < kMaxPlayers; i++) {
+        out[i] = Pad{};
+    }
+    mFrame++;
+    return true;
+}
+
+} // namespace Netplay
diff --git a/src/port/netplay/NetplayCore.h b/src/port/netplay/NetplayCore.h
new file mode 100644
index 0000000..e63af88
--- /dev/null
+++ b/src/port/netplay/NetplayCore.h
@@ -0,0 +1,187 @@
+#pragma once
+
+// LAN netplay core: TCP transport + deterministic lockstep input sync.
+//
+// Topology is a star: one host, up to three clients. Every machine runs the
+// full game simulation. Each frame, every player's controller input is sent to
+// the host; the host bundles the inputs for a frame and relays the bundle to
+// everyone. A frame only runs once its bundle is complete, so all machines feed
+// the game identical inputs on identical frames and the simulations stay in step.
+//
+// This file knows nothing about Mario Kart. Game-specific state (RNG seed, menu
+// cursors, gameplay settings, desync hashes) is plugged in through Hooks.
+
+#include <array>
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace Netplay {
+
+constexpr int kMaxPlayers = 8;
+constexpr uint16_t kDefaultPort = 27064;
+constexpr int kMaxInputDelay = 8;
+
+// Lobby option bits used by the game (Session::LobbyOptions()).
+constexpr uint8_t kOptionSplitScreen = 1; // classic couch split-screen, max 4 players
+                                          // (otherwise: big race, own screen per PC, up to 8)
+
+struct Pad {
+    uint32_t button = 0;
+    int8_t stickX = 0;
+    int8_t stickY = 0;
+    int8_t rightStickX = 0;
+    int8_t rightStickY = 0;
+
+    bool operator==(const Pad& o) const {
+        return button == o.button && stickX == o.stickX && stickY == o.stickY && rightStickX == o.rightStickX &&
+               rightStickY == o.rightStickY;
+    }
+};
+using FramePads = std::array<Pad, kMaxPlayers>;
+
+enum class Role { None, Host, Client };
+enum class Phase {
+    Idle,       // not connected
+    Connecting, // client: TCP connect / handshake in progress
+    Lobby,      // connected, waiting for the host to start
+    InGame,     // lockstep running
+};
+
+struct Hooks {
+    // Bytes that must match on every machine for a session to be allowed
+    // (protocol version, platform, unlocks...). Host rejects mismatches.
+    std::function<std::vector<uint8_t>()> compatBlob;
+    // Human readable explanation of why two compat blobs differ.
+    std::function<std::string(const std::vector<uint8_t>& host, const std::vector<uint8_t>& client)> describeMismatch;
+    // Host: capture the state every client must adopt before frame 0.
+    std::function<std::vector<uint8_t>()> captureStartState;
+    // Client: adopt the host's start state. Return false (and set err) to abort.
+    std::function<bool(const std::vector<uint8_t>& state, std::string& err)> applyStartState;
+    // Hash of the simulation state, checked periodically to detect desyncs.
+    std::function<uint32_t()> stateHash;
+    // Called when a session ends (for whatever reason) so the game can restore
+    // anything it overrode.
+    std::function<void()> onSessionEnd;
+};
+
+struct PlayerInfo {
+    bool connected = false;
+    std::string name;
+    // Small per-player choice shared through the lobby (the game uses it for
+    // the player's character).
+    uint8_t profile = 0;
+};
+
+class Session {
+  public:
+    Session();
+    ~Session();
+
+    void SetHooks(Hooks hooks) { mHooks = std::move(hooks); }
+
+    // --- control (UI thread == game thread) ---
+    bool Host(uint16_t port, const std::string& name);
+    bool Join(const std::string& address, uint16_t port, const std::string& name);
+    void Disconnect(const std::string& reason = "");
+    // Host only: start the match on the next Update().
+    bool RequestStart();
+    void SetInputDelay(int frames);
+    // This player's lobby choice (see PlayerInfo::profile).
+    void SetLocalProfile(uint8_t profile);
+    // Host only: match options shown to everyone in the lobby.
+    void SetLobbyOptions(uint8_t options);
+    uint8_t LobbyOptions() const { return mLobbyOptions; }
+
+    // --- per frame ---
+    // Pump the network. Returns true exactly once when the synced session
+    // starts; the caller must then put the game into its known start state
+    // before running the next frame (which is lockstep frame 0).
+    bool Update();
+    // Exchange inputs for the frame about to run. `local` is this machine's
+    // controller. On success `out` holds every player's input for this frame.
+    // Blocks (up to the timeout) until all inputs for the frame have arrived.
+    // Returns false if netplay is not in-game or the session dropped.
+    bool ExchangeInputs(const Pad& local, FramePads& out);
+
+    // --- status ---
+    Role GetRole() const { return mRole; }
+    Phase GetPhase() const { return mPhase; }
+    bool IsInGame() const { return mPhase == Phase::InGame; }
+    int LocalSlot() const { return mLocalSlot; }
+    int PlayerCount() const;
+    int InputDelay() const { return mInputDelay; }
+    uint32_t CurrentFrame() const { return mFrame; }
+    const std::array<PlayerInfo, kMaxPlayers>& Players() const { return mPlayers; }
+    const std::string& StatusText() const { return mStatus; }
+    const std::string& LastError() const { return mLastError; }
+    bool HasDesynced() const { return mDesyncFrame != UINT32_MAX; }
+    uint32_t DesyncFrame() const { return mDesyncFrame; }
+    double LastStallMs() const { return mLastStallMs; }
+
+    // Seconds to wait for a frame's inputs before giving up on the session.
+    double mTimeoutSeconds = 5.0;
+    // How often (frames) to compare state hashes.
+    uint32_t mHashInterval = 30;
+
+  private:
+    struct Conn;
+    struct InputSlot {
+        uint32_t frame = UINT32_MAX;
+        uint8_t haveMask = 0;
+        FramePads pads{};
+    };
+    static constexpr uint32_t kRing = 256;
+
+    void ResetState();
+    void Fail(const std::string& reason);
+    void AcceptNewClients();
+    bool PumpConn(Conn& c, int slotIndex);
+    void HandleMessage(Conn& c, int slotIndex, uint8_t type, const uint8_t* data, size_t len);
+    void SendTo(Conn& c, uint8_t type, const std::vector<uint8_t>& payload);
+    void Broadcast(uint8_t type, const std::vector<uint8_t>& payload);
+    void BroadcastLobby();
+    bool WaitForNetwork(int timeoutMs);
+    void BeginInGame(int slot, int playerCount, int inputDelay);
+    InputSlot& SlotFor(uint32_t frame);
+    void StoreInput(uint32_t frame, int player, const Pad& pad);
+    void StoreFrame(uint32_t frame, const FramePads& pads);
+    void RecordHash(uint32_t frame, int player, uint32_t hash);
+    uint8_t ExpectedMask() const;
+
+    Hooks mHooks;
+    Role mRole = Role::None;
+    Phase mPhase = Phase::Idle;
+    int mLocalSlot = 0;
+    int mPlayerCount = 0; // fixed once in game
+    int mInputDelay = 2;
+    uint32_t mFrame = 0;
+    bool mStartRequested = false;
+    bool mStartPending = false; // client: START applied, report on next Update
+    std::string mLocalName;
+    uint8_t mLocalProfile = 0;
+    uint8_t mLobbyOptions = 0;
+    std::string mStatus;
+    std::string mLastError;
+    uint32_t mDesyncFrame = UINT32_MAX;
+    double mLastStallMs = 0.0;
+    double mConnectStarted = 0.0;
+    std::string mPendingFail; // client: reason the host gave for closing
+
+    intptr_t mListenSock = -1;
+    std::array<Conn*, kMaxPlayers> mConns{}; // host: index = slot (0 unused); client: [0] = host
+    std::array<PlayerInfo, kMaxPlayers> mPlayers{};
+    std::vector<InputSlot> mInputs;
+    struct HashSlot {
+        uint32_t frame = UINT32_MAX;
+        uint8_t haveMask = 0;
+        std::array<uint32_t, kMaxPlayers> hash{};
+    };
+    std::vector<HashSlot> mHashes;
+};
+
+// Process-wide session used by the game.
+Session& Get();
+
+} // namespace Netplay
