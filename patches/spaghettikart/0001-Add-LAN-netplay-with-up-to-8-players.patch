diff --git a/src/port/ui/NetplayWindow.cpp b/src/port/ui/NetplayWindow.cpp
new file mode 100644
index 0000000..0317139
--- /dev/null
+++ b/src/port/ui/NetplayWindow.cpp
@@ -0,0 +1,230 @@
+#include "NetplayWindow.h"
+
+#include <imgui.h>
+#include <algorithm>
+#include <cstring>
+#include <string>
+
+#include "port/netplay/NetplayCore.h"
+
+namespace Netplay {
+void InstallGameHooks();
+}
+
+namespace GameUI {
+
+namespace {
+char sName[32] = "";
+char sAddress[64] = "";
+int sPort = Netplay::kDefaultPort;
+int sDelay = 2;
+int sCharacter = 1;
+int sSplitScreen = 0;
+
+const char* kCharacterNames[8] = { "Mario", "Luigi", "Yoshi", "Toad", "Donkey Kong", "Wario", "Peach", "Bowser" };
+
+const ImVec4 kRed(1.0f, 0.35f, 0.35f, 1.0f);
+const ImVec4 kGreen(0.45f, 0.9f, 0.45f, 1.0f);
+const ImVec4 kGrey(0.65f, 0.65f, 0.65f, 1.0f);
+
+void SaveSettings() {
+    CVarSetString("gNetplay.Name", sName);
+    CVarSetString("gNetplay.Address", sAddress);
+    CVarSetInteger("gNetplay.Port", sPort);
+    CVarSetInteger("gNetplay.InputDelay", sDelay);
+    CVarSetInteger("gNetplay.Character", sCharacter);
+    CVarSave();
+}
+
+// Character for big races (P1 / the host picks theirs in the game's menu).
+void DrawCharacterPicker(Netplay::Session& s) {
+    if (ImGui::Combo("Your character", &sCharacter, kCharacterNames, 8)) {
+        s.SetLocalProfile((uint8_t) sCharacter);
+        SaveSettings();
+    }
+    if (ImGui::IsItemHovered()) {
+        ImGui::SetTooltip("Used in big races for players 2-8.\nThe host (P1) picks in the normal character menu.");
+    }
+}
+
+bool BigRace(const Netplay::Session& s) {
+    return !(s.LobbyOptions() & Netplay::kOptionSplitScreen);
+}
+
+void DrawPlayers(const Netplay::Session& s) {
+    bool bigRace = BigRace(s);
+    if (!ImGui::BeginTable("##netplayers", 3, ImGuiTableFlags_BordersInnerH)) {
+        return;
+    }
+    ImGui::TableSetupColumn("Slot", ImGuiTableColumnFlags_WidthFixed, 40.0f);
+    ImGui::TableSetupColumn("Name");
+    ImGui::TableSetupColumn("Kart", ImGuiTableColumnFlags_WidthFixed, 110.0f);
+    const auto& players = s.Players();
+    for (int i = 0; i < Netplay::kMaxPlayers; i++) {
+        ImGui::TableNextRow();
+        ImGui::TableNextColumn();
+        ImGui::Text("P%d", i + 1);
+        ImGui::TableNextColumn();
+        if (players[i].connected) {
+            bool you = s.GetPhase() != Netplay::Phase::Connecting && i == s.LocalSlot();
+            ImGui::Text("%s%s%s", players[i].name.c_str(), you ? "  (you)" : "", i == 0 ? "  [host]" : "");
+            ImGui::TableNextColumn();
+            if (!bigRace || i == 0) {
+                ImGui::TextColored(kGrey, "game menu");
+            } else {
+                ImGui::TextUnformatted(kCharacterNames[players[i].profile & 7]);
+            }
+        } else {
+            ImGui::TextColored(kGrey, bigRace ? "open (CPU)" : "open");
+            ImGui::TableNextColumn();
+        }
+    }
+    ImGui::EndTable();
+}
+} // namespace
+
+void NetplayWindow::InitElement() {
+    strncpy(sName, CVarGetString("gNetplay.Name", ""), sizeof(sName) - 1);
+    strncpy(sAddress, CVarGetString("gNetplay.Address", "192.168.1.2"), sizeof(sAddress) - 1);
+    sPort = CVarGetInteger("gNetplay.Port", Netplay::kDefaultPort);
+    sDelay = CVarGetInteger("gNetplay.InputDelay", 2);
+    sCharacter = std::clamp(CVarGetInteger("gNetplay.Character", 1), 0, 7);
+}
+
+void NetplayWindow::DrawElement() {
+    Netplay::InstallGameHooks();
+    Netplay::Session& s = Netplay::Get();
+
+    switch (s.GetPhase()) {
+        case Netplay::Phase::Idle: {
+            if (!s.LastError().empty()) {
+                ImGui::PushTextWrapPos(0.0f);
+                ImGui::TextColored(kRed, "%s", s.LastError().c_str());
+                ImGui::PopTextWrapPos();
+                ImGui::Spacing();
+            }
+            ImGui::InputText("Your name", sName, sizeof(sName));
+            DrawCharacterPicker(s);
+            ImGui::InputInt("Port", &sPort);
+            sPort = std::clamp(sPort, 1024, 65535);
+
+            ImGui::SeparatorText("Host a match");
+            ImGui::SliderInt("Input delay (frames)", &sDelay, 0, Netplay::kMaxInputDelay);
+            if (ImGui::IsItemHovered()) {
+                ImGui::SetTooltip("Frames between pressing a button and it taking effect.\n"
+                                  "2 suits wired LAN; raise it if the game stutters over Wi-Fi.");
+            }
+            if (ImGui::Button("Host")) {
+                SaveSettings();
+                s.SetLocalProfile((uint8_t) sCharacter);
+                if (s.Host((uint16_t) sPort, sName)) {
+                    s.SetInputDelay(sDelay);
+                    s.SetLobbyOptions(sSplitScreen ? Netplay::kOptionSplitScreen : 0);
+                }
+            }
+
+            ImGui::SeparatorText("Join a match");
+            ImGui::InputText("Host IP address", sAddress, sizeof(sAddress));
+            if (ImGui::Button("Join")) {
+                SaveSettings();
+                s.SetLocalProfile((uint8_t) sCharacter);
+                s.Join(sAddress, (uint16_t) sPort, sName);
+            }
+            ImGui::Spacing();
+            ImGui::PushTextWrapPos(0.0f);
+            ImGui::TextColored(kGrey, "Everyone needs the same SpaghettiKart build, the same mods/custom tracks, "
+                                      "and the host's port (%d) allowed through the firewall.",
+                               sPort);
+            ImGui::PopTextWrapPos();
+            break;
+        }
+
+        case Netplay::Phase::Connecting:
+            ImGui::TextUnformatted(s.StatusText().c_str());
+            if (ImGui::Button("Cancel")) {
+                s.Disconnect();
+            }
+            break;
+
+        case Netplay::Phase::Lobby: {
+            ImGui::TextUnformatted(s.StatusText().c_str());
+            ImGui::Spacing();
+            DrawPlayers(s);
+            ImGui::Spacing();
+            if (s.GetRole() == Netplay::Role::Host) {
+                ImGui::TextUnformatted("Match type");
+                if (ImGui::RadioButton("Big race - own screen on every PC (up to 8)", sSplitScreen == 0)) {
+                    sSplitScreen = 0;
+                    s.SetLobbyOptions(0);
+                }
+                if (ImGui::RadioButton("Split-screen - classic couch view (up to 4)", sSplitScreen == 1)) {
+                    sSplitScreen = 1;
+                    s.SetLobbyOptions(Netplay::kOptionSplitScreen);
+                }
+                int delay = s.InputDelay();
+                if (ImGui::SliderInt("Input delay (frames)", &delay, 0, Netplay::kMaxInputDelay)) {
+                    sDelay = delay;
+                    s.SetInputDelay(delay);
+                }
+                bool tooMany = !BigRace(s) && s.PlayerCount() > 4;
+                ImGui::BeginDisabled(s.PlayerCount() < 2 || tooMany);
+                if (ImGui::Button("Start match")) {
+                    s.RequestStart();
+                }
+                ImGui::EndDisabled();
+                ImGui::SameLine();
+                if (ImGui::Button("Close lobby")) {
+                    s.Disconnect("Host closed the lobby");
+                }
+                ImGui::PushTextWrapPos(0.0f);
+                if (tooMany) {
+                    ImGui::TextColored(kRed, "Split-screen supports 4 players. Switch to Big race for %d.",
+                                       s.PlayerCount());
+                } else if (BigRace(s)) {
+                    ImGui::TextColored(kGrey,
+                                       "Start sends everyone to the main menu. Choose 1P > Mario GP, then your "
+                                       "character, class and cup. Players 2-%d drive the characters listed above; "
+                                       "empty slots are CPU.",
+                                       std::max(2, s.PlayerCount()));
+                } else {
+                    ImGui::TextColored(kGrey,
+                                       "Start sends everyone to the main menu together. Then pick a %d-player mode "
+                                       "there - P1 (you) drives the menus.",
+                                       std::max(2, s.PlayerCount()));
+                }
+                ImGui::PopTextWrapPos();
+            } else {
+                ImGui::Text("Match type: %s", BigRace(s) ? "Big race (own screen)" : "Split-screen");
+                if (BigRace(s)) {
+                    DrawCharacterPicker(s);
+                }
+                ImGui::Text("Input delay: %d frames", s.InputDelay());
+                if (ImGui::Button("Leave")) {
+                    s.Disconnect();
+                }
+            }
+            break;
+        }
+
+        case Netplay::Phase::InGame: {
+            ImGui::TextColored(kGreen, "Netplay running - you are P%d of %d", s.LocalSlot() + 1, s.PlayerCount());
+            DrawPlayers(s);
+            ImGui::Text("Frame %u   input delay %d   last wait %.1f ms", s.CurrentFrame(), s.InputDelay(),
+                        s.LastStallMs());
+            if (s.HasDesynced()) {
+                ImGui::PushTextWrapPos(0.0f);
+                ImGui::TextColored(kRed,
+                                   "Desync detected at frame %u - the games have drifted apart. "
+                                   "Check everyone has identical settings/builds, then restart the match.",
+                                   s.DesyncFrame());
+                ImGui::PopTextWrapPos();
+            }
+            if (ImGui::Button("Disconnect")) {
+                s.Disconnect();
+            }
+            break;
+        }
+    }
+}
+
+} // namespace GameUI
