+// Settings from the Enhancements menu that change gameplay. The host's values
+// are pushed to every client for the length of the match, then restored.
+struct SyncedCVar {
+    const char* name;
+    bool isFloat;
+};
+const SyncedCVar kSyncedCVars[] = {
+    { "gAllBombKartsChase", false },  { "gAllThwompsAreMarty", false },  { "gCustomCC", true },
+    { "gDisableItemboxes", false },   { "gDisableLod", false },          { "gDisableRubberbanding", false },
+    { "gEnableCustomCC", false },     { "gEnableMoonJump", false },      { "gFarFrustrum", false },
+    { "gGoFish", false },             { "gHarderCPU", false },           { "gHasTender", false },
+    { "gLookBehind", false },         { "gMinHeight", true },            { "gMultiplayerNoFeatureCuts", false },
+    { "gNoCulling", false },          { "gNoWallColision", false },      { "gNumBuses", false },
+    { "gNumCarriages", false },       { "gNumCars", false },             { "gNumTankerTrucks", false },
+    { "gNumTrains", false },          { "gNumTrucks", false },           { "gShellsShootStraight", false },
+    { "gUniqueCharacterSelections", false },
+};
+constexpr int kNumSyncedCVars = sizeof(kSyncedCVars) / sizeof(kSyncedCVars[0]);
+
+// CVar defaults used only to snapshot "unset" values consistently.
+constexpr int32_t kUnsetInt = INT32_MIN;
+constexpr float kUnsetFloat = -1.0e30f;
+
+struct SavedCVar {
+    bool isFloat;
+    int32_t i;
+    float f;
+};
+std::vector<SavedCVar> sSavedCVars;
+int32_t sSavedFreecam = 0;
+bool sOverridesActive = false;
+
+void SaveAndOverrideLocalOnly() {
+    if (!sOverridesActive) {
+        sSavedCVars.clear();
+        for (auto& cv : kSyncedCVars) {
+            sSavedCVars.push_back({ cv.isFloat, CVarGetInteger(cv.name, kUnsetInt), CVarGetFloat(cv.name, kUnsetFloat) });
+        }
+        sSavedFreecam = CVarGetInteger("gFreecam", 0);
+        sOverridesActive = true;
+    }
+    // Freecam hijacks controller 1, which would feed the wrong input to P1.
+    CVarSetInteger("gFreecam", 0);
+}
+
+void RestoreOverrides() {
+    if (!sOverridesActive) {
+        return;
+    }
+    for (int i = 0; i < kNumSyncedCVars && i < (int) sSavedCVars.size(); i++) {
+        auto& cv = kSyncedCVars[i];
+        auto& saved = sSavedCVars[i];
+        if (cv.isFloat) {
+            if (saved.f != kUnsetFloat) {
+                CVarSetFloat(cv.name, saved.f);
+            } else {
+                CVarClear(cv.name);
+            }
+        } else if (saved.i != kUnsetInt) {
+            CVarSetInteger(cv.name, saved.i);
+        } else {
+            CVarClear(cv.name);
+        }
+    }
+    CVarSetInteger("gFreecam", sSavedFreecam);
+    sOverridesActive = false;
+    gNetBigRace = 0;
+    gNetHumanCount = 0;
+    gNetViewPlayer = 0;
+}
+
+// ---- byte helpers ----
+void Put8(std::vector<uint8_t>& b, uint8_t v) {
+    b.push_back(v);
+}
+void Put32(std::vector<uint8_t>& b, uint32_t v) {
+    for (int i = 0; i < 4; i++) {
+        b.push_back((v >> (8 * i)) & 0xFF);
+    }
+}
+void PutStr(std::vector<uint8_t>& b, const std::string& s) {
+    Put8(b, (uint8_t) std::min<size_t>(s.size(), 255));
+    b.insert(b.end(), s.begin(), s.begin() + std::min<size_t>(s.size(), 255));
+}
+struct Cursor {
+    const std::vector<uint8_t>& b;
+    size_t at = 0;
+    bool ok = true;
+    uint8_t Get8() {
+        if (at >= b.size()) {
+            ok = false;
+            return 0;
+        }
+        return b[at++];
+    }
+    uint32_t Get32() {
+        uint32_t v = 0;
+        for (int i = 0; i < 4; i++) {
+            v |= (uint32_t) Get8() << (8 * i);
+        }
+        return v;
+    }
+    std::string GetStr() {
+        uint8_t n = Get8();
+        if (at + n > b.size()) {
+            ok = false;
+            return {};
+        }
+        std::string s((const char*) b.data() + at, n);
+        at += n;
+        return s;
+    }
+};
+
+uint32_t Fnv(uint32_t h, const void* data, size_t len) {
+    auto* p = (const uint8_t*) data;
+    for (size_t i = 0; i < len; i++) {
+        h = (h ^ p[i]) * 16777619u;
+    }
+    return h;
+}
+
+// ---- compatibility ----
+// Anything that, if different, would make menus or races play out differently.
+const char* PlatformTag() {
+#if defined(_WIN32)
+    const char* os = "windows";
+#elif defined(__APPLE__)
+    const char* os = "macos";
+#elif defined(__linux__)
+    const char* os = "linux";
+#else
+    const char* os = "other";
+#endif
+#if defined(__x86_64__) || defined(_M_X64)
+    const char* cpu = "x64";
+#elif defined(__aarch64__) || defined(_M_ARM64)
+    const char* cpu = "arm64";
+#else
+    const char* cpu = "other";
+#endif
+    static std::string tag = std::string(os) + "-" + cpu;
+    return tag.c_str();
+}
+
+struct Compat {
+    uint8_t extraUnlocked = 0;
+    uint32_t trackCount = 0;
+    uint32_t trackHash = 0;
+    uint32_t playerSize = 0;
+    std::string platform;
+};
+
+std::vector<uint8_t> EncodeCompat(const Compat& c) {
+    std::vector<uint8_t> b;
+    Put8(b, c.extraUnlocked);
+    Put32(b, c.trackCount);
+    Put32(b, c.trackHash);
+    Put32(b, c.playerSize);
+    PutStr(b, c.platform);
+    return b;
+}
+
+Compat DecodeCompat(const std::vector<uint8_t>& b) {
+    Cursor r{ b };
+    Compat c;
+    c.extraUnlocked = r.Get8();
+    c.trackCount = r.Get32();
+    c.trackHash = r.Get32();
+    c.playerSize = r.Get32();
+    c.platform = r.GetStr();
+    return c;
+}
+
+Compat LocalCompat() {
+    Compat c;
+    c.extraUnlocked = has_unlocked_extra_mode() ? 1 : 0;
+    uint32_t h = 2166136261u;
+    for (auto* info : gTrackRegistry.GetAllInfo()) {
+        h = Fnv(h, info->ResourceName.data(), info->ResourceName.size());
+        h = Fnv(h, "|", 1);
+        c.trackCount++;
+    }
+    c.trackHash = h;
+    c.playerSize = sizeof(Player);
+    c.platform = PlatformTag();
+    return c;
+}
+
+std::string DescribeMismatch(const std::vector<uint8_t>& hostBlob, const std::vector<uint8_t>& clientBlob) {
+    Compat h = DecodeCompat(hostBlob);
+    Compat c = DecodeCompat(clientBlob);
+    if (h.playerSize != c.playerSize) {
+        return "Different SpaghettiKart builds - everyone needs the same version";
+    }
+    if (h.platform != c.platform) {
+        return "Different platforms (host " + h.platform + ", you " + c.platform +
+               ") - mixed builds can desync, so all players need the same OS build";
+    }
+    if (h.trackCount != c.trackCount || h.trackHash != c.trackHash) {
+        return "Different track lists - install the same custom tracks/mods as the host";
+    }
+    if (h.extraUnlocked != c.extraUnlocked) {
+        return std::string("Extra (mirror) mode is ") + (h.extraUnlocked ? "unlocked" : "locked") +
+               " for the host but not for you - the menus would differ";
+    }
+    return "Game setup differs from the host";
+}
