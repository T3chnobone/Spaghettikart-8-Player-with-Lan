@@ -722,8 +756,33 @@ extern "C" void couch_on_race_over(void) {
     if (!r.order.empty()) {
         sWins[r.order[0].player]++;
     }
-    r.lockFrames = kResultsLockFrames;
+    for (size_t i = 0; i < r.order.size() && i < 3; i++) {
+        sPlaces[r.order[i].player][i]++;
+    }
+    // The results are the stock VS/Battle results menu (race_logic.c spawns
+    // it), so the overlay panel stays closed.
+    r.active = false;
     sResults = r;
-    ClearEdges();
-    GameUI::ShowCouchResults(true);
+    sResultsReady = true;
+    StockResultsData();
+}
+
+extern "C" bool couch_results_ready(void) {
+    return sResultsReady && couch_race_active();
+}
+
+extern "C" s32 couch_results_player_count(s32 stock) {
+    return couch_results_ready() ? sCount : stock;
+}
+
+extern "C" bool couch_results_entry(s32 place, s32* player, s32* character, s32* wins, bool* finished) {
+    if (!couch_results_ready() || place < 0 || place >= (s32) sResults.order.size()) {
+        return false;
+    }
+    const Standing& st = sResults.order[place];
+    *player = st.player;
+    *character = st.character;
+    *wins = Wins(st.player);
+    *finished = st.finished;
+    return true;
 }
