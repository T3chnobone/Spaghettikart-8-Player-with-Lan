+// The stock VS/Battle results menu draws players 1-4 from the character
+// selections and the session counters it keeps for 2, 3 and 4 players. With
+// up to 4 couch players, give it the couch party's own numbers.
+void StockResultsData() {
+    const int n = std::min(sCount, 4);
+    if (n < 2) {
+        return;
+    }
+    auto clamp99 = [](int v) { return (u8) std::min(v, 99); };
+    for (int k = 0; k < n; k++) {
+        gCharacterSelections[k] = (s8) sCharacters[k];
+        if (gModeSelection == BATTLE) {
+            u8* wins = n == 2 ? gNmiUnknown4 : (n == 3 ? gNmiUnknown5 : gNmiUnknown6);
+            wins[k] = clamp99(sWins[k]);
+        } else if (n == 2) {
+            gNmiUnknown1[k] = clamp99(sWins[k]);
+        } else {
+            u8* places = n == 3 ? gNmiUnknown2 : gNmiUnknown3;
+            for (int i = 0; i < 3; i++) {
+                places[k * 3 + i] = clamp99(sPlaces[k][i]);
+            }
+        }
+    }
+}
+
 } // namespace
 
 Results& GetResults() {
