+// Couch Party players 5-8: the stock cursors only come in 1P-4P, so these are
+// drawn as a frame in the player's colour with a "5P".."8P" tag.
+void render_couch_cursor(MenuItem* arg0, s32 playerId) {
+    static const u8 sColors[4][3] = { { 255, 140, 30 }, { 180, 90, 255 }, { 40, 220, 200 }, { 255, 90, 160 } };
+    static char* const sTags[4] = { "5P", "6P", "7P", "8P" };
+    const u8* c = sColors[(playerId - 4) & 3];
+    s32 x0 = arg0->column;
+    s32 y0 = arg0->row;
+    s32 x1 = x0 + 0x40;
+    s32 y1 = y0 + 0x4C;
+    s32 alpha = 255;
+
+    if ((playerId < 4) || (playerId >= (s32) ARRAY_COUNT(gCharacterGridSelections)) ||
+        (gCharacterGridSelections[playerId] == 0)) {
+        return;
+    }
+    if (gCharacterGridIsSelected[playerId]) {
+        // Locked in: pulse, like the stock cursors.
+        s32 t = gGlobalTimer % 16;
+        alpha = 0xBF + ((t >= 8) ? ((16 - t) * 8) : (t * 8));
+        if (alpha > 255) {
+            alpha = 255;
+        }
+    }
+    gDisplayListHead = draw_box(gDisplayListHead, x0, y0, x1, y0 + 3, c[0], c[1], c[2], alpha);
+    gDisplayListHead = draw_box(gDisplayListHead, x0, y1 - 3, x1, y1, c[0], c[1], c[2], alpha);
+    gDisplayListHead = draw_box(gDisplayListHead, x0, y0, x0 + 3, y1, c[0], c[1], c[2], alpha);
+    gDisplayListHead = draw_box(gDisplayListHead, x1 - 3, y0, x1, y1, c[0], c[1], c[2], alpha);
+    gDisplayListHead = draw_box(gDisplayListHead, x0, y0, x0 + 20, y0 + 12, c[0], c[1], c[2], alpha);
+    set_text_color(TEXT_YELLOW);
+    print_text_mode_1(x0 + 2, y0 + 11, sTags[(playerId - 4) & 3], 0, 0.6f, 0.6f);
+}
+
+void update_couch_cursor(MenuItem* arg0) {
+    s32 playerId = 4 + (arg0->type - COUCH_SELECT_MENU_5P_CURSOR);
+    s8 characterSelectionIndex = gCharacterGridSelections[playerId];
+
+    // Above the portraits, between the stock cursors.
+    arg0->priority = 0xD - ((playerId - 4) * 2);
+    if (arg0->priority < 9) {
+        arg0->priority = 9;
+    }
+    hover_cursor_over_character_portrait(arg0, characterSelectionIndex - 1);
+}
+
 void update_cursor(MenuItem* arg0) {
     s32 playerId;
     s8 characterSelectionIndex;
