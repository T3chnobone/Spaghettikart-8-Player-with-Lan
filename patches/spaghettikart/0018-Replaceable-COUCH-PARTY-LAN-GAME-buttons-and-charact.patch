diff --git a/src/port/textures/CustomTextures.cpp b/src/port/textures/CustomTextures.cpp
new file mode 100644
index 000000000..7e9bdc463
--- /dev/null
+++ b/src/port/textures/CustomTextures.cpp
@@ -0,0 +1,115 @@
+#include "custom_textures.h"
+
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+#include <libultraship/libultraship.h>
+#include <stb_image.h>
+#include "ship/Context.h"
+#include "spdlog/spdlog.h"
+
+namespace {
+
+// Largest picture accepted, per side. Bigger (HD) pictures than the slot they
+// go in are fine: they are scaled down when drawn.
+constexpr int kMaxSide = 512;
+
+struct CustomTexture {
+    const char* file;
+    int width = 0;
+    int height = 0;
+    bool present = false;
+};
+
+CustomTexture sTextures[CUSTOM_TEX_COUNT] = {
+    { "couch_party_button.png" },    { "lan_game_button.png" },       { "character_highlight.png" },
+    { "character_highlight_p1.png" }, { "character_highlight_p2.png" }, { "character_highlight_p3.png" },
+    { "character_highlight_p4.png" }, { "character_highlight_p5.png" }, { "character_highlight_p6.png" },
+    { "character_highlight_p7.png" }, { "character_highlight_p8.png" },
+};
+
+// The pixels live inside the exe's own memory, not on the heap: on Windows the
+// renderer only accepts low texture addresses that belong to a loaded module.
+alignas(16) uint8_t sPixels[CUSTOM_TEX_COUNT][kMaxSide * kMaxSide * 4];
+
+bool sLoaded = false;
+
+void LoadOne(int i, const std::string& dir) {
+    CustomTexture& t = sTextures[i];
+    std::string path = dir + "/" + t.file;
+    std::ifstream in(path, std::ios::binary);
+    if (!in) {
+        return; // not there: the built-in picture is used
+    }
+    std::vector<unsigned char> bytes((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    int w = 0;
+    int h = 0;
+    unsigned char* rgba = stbi_load_from_memory(bytes.data(), (int) bytes.size(), &w, &h, nullptr, 4);
+    if (rgba == nullptr) {
+        SPDLOG_WARN("textures: can't read {} ({}), using the built-in picture", path, stbi_failure_reason());
+        return;
+    }
+    if ((w <= 0) || (h <= 0) || (w > kMaxSide) || (h > kMaxSide)) {
+        SPDLOG_WARN("textures: {} is {}x{}, the most is {}x{}; using the built-in picture", path, w, h, kMaxSide,
+                    kMaxSide);
+        stbi_image_free(rgba);
+        return;
+    }
+    memcpy(sPixels[i], rgba, (size_t) w * h * 4);
+    stbi_image_free(rgba);
+    t.width = w;
+    t.height = h;
+    t.present = true;
+    SPDLOG_INFO("textures: using {} ({}x{})", path, w, h);
+}
+
+void LoadAll() {
+    if (sLoaded) {
+        return;
+    }
+    sLoaded = true;
+    const std::string dir = Ship::Context::GetPathRelativeToAppDirectory("textures");
+    for (int i = 0; i < CUSTOM_TEX_COUNT; i++) {
+        LoadOne(i, dir);
+    }
+}
+
+} // namespace
+
+extern "C" bool custom_texture_present(CustomTextureId id) {
+    LoadAll();
+    return (id >= 0) && (id < CUSTOM_TEX_COUNT) && sTextures[id].present;
+}
+
+extern "C" Gfx* custom_texture_draw(Gfx* dl, CustomTextureId id, s32 x, s32 y, s32 w, s32 h, u8 r, u8 g, u8 b,
+                                    u8 a) {
+    if (!custom_texture_present(id) || (w <= 0) || (h <= 0)) {
+        return dl;
+    }
+    const CustomTexture& t = sTextures[id];
+    const bool scaled = (t.width != w) || (t.height != h);
+
+    gDPPipeSync(dl++);
+    gDPSetCycleType(dl++, G_CYC_1CYCLE);
+    gDPSetTexturePersp(dl++, G_TP_NONE);
+    gDPSetTextureLOD(dl++, G_TL_TILE);
+    gDPSetTextureLUT(dl++, G_TT_NONE);
+    gDPSetTextureConvert(dl++, G_TC_FILT);
+    gDPSetTextureFilter(dl++, scaled ? G_TF_BILERP : G_TF_POINT);
+    gDPSetAlphaCompare(dl++, G_AC_NONE);
+    gDPSetRenderMode(dl++, G_RM_XLU_SURF, G_RM_XLU_SURF2);
+    gDPSetCombineMode(dl++, G_CC_MODULATERGBA_PRIM, G_CC_MODULATERGBA_PRIM);
+    gDPSetPrimColor(dl++, 0, 0, r, g, b, a);
+    gDPLoadTextureTile(dl++, sPixels[id], G_IM_FMT_RGBA, G_IM_SIZ_32b, t.width, t.height, 0, 0, t.width - 1,
+                       t.height - 1, 0, G_TX_NOMIRROR | G_TX_CLAMP, G_TX_NOMIRROR | G_TX_CLAMP, G_TX_NOMASK,
+                       G_TX_NOMASK, G_TX_NOLOD, G_TX_NOLOD);
+    gSPWideTextureRectangle(dl++, x << 2, y << 2, (x + w) << 2, (y + h) << 2, G_TX_RENDERTILE, 0, 0,
+                            (t.width << 10) / w, (t.height << 10) / h);
+    gDPPipeSync(dl++);
+    gDPSetTextureFilter(dl++, G_TF_BILERP);
+    return dl;
+}
