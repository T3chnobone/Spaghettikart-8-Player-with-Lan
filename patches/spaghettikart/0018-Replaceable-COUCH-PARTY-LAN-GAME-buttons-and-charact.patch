+#ifndef SPAGHETTI_CUSTOM_TEXTURES_H
+#define SPAGHETTI_CUSTOM_TEXTURES_H
+
+// Replaceable menu pictures: PNG files in the "textures" folder next to the
+// game. A picture whose file is there is drawn instead of the built-in one;
+// when the file is missing (or can't be read) the game draws its own.
+// Files are read once, the first time the menus need them, so a change shows
+// after the game is restarted.
+
+#include <libultraship.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+    CUSTOM_TEX_COUCH_PARTY_BUTTON,   // textures/couch_party_button.png
+    CUSTOM_TEX_LAN_GAME_BUTTON,      // textures/lan_game_button.png
+    CUSTOM_TEX_CHARACTER_HIGHLIGHT,  // textures/character_highlight.png (tinted per player)
+    CUSTOM_TEX_CHARACTER_HIGHLIGHT_P1, // textures/character_highlight_p1.png .. _p8.png (not tinted)
+    CUSTOM_TEX_CHARACTER_HIGHLIGHT_P8 = CUSTOM_TEX_CHARACTER_HIGHLIGHT_P1 + 7,
+    CUSTOM_TEX_COUNT
+} CustomTextureId;
+
+// True if the file for this picture was found and loaded.
+bool custom_texture_present(CustomTextureId id);
+
+// Draws the picture stretched over the screen rectangle (x, y, w, h) in the
+// menus' 320x240 space, multiplied by the colour (r, g, b) and alpha a.
+// Does nothing and returns dl unchanged if the picture isn't present.
+Gfx* custom_texture_draw(Gfx* dl, CustomTextureId id, s32 x, s32 y, s32 w, s32 h, u8 r, u8 g, u8 b, u8 a);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
