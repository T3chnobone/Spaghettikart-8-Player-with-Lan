diff --git a/src/port/ui/LeaderboardWindow.cpp b/src/port/ui/LeaderboardWindow.cpp
new file mode 100644
index 0000000..68cc1b2
--- /dev/null
+++ b/src/port/ui/LeaderboardWindow.cpp
@@ -0,0 +1,274 @@
+#include "LeaderboardWindow.h"
+
+#include <imgui.h>
+#include <imgui_internal.h>
+#include <algorithm>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "port/Game.h"
+#include "ship/Context.h"
+#include "ship/window/gui/Gui.h"
+#include "port/leaderboard/LeaderboardGame.h"
+
+namespace GameUI {
+
+namespace {
+
+std::shared_ptr<Ship::GuiWindow> sEntryWindow;
+const char* const kEntryWindowName = "Time Trial Record";
+const ImVec4 kGold(1.0f, 0.84f, 0.2f, 1.0f);
+const ImVec4 kGreen(0.45f, 0.9f, 0.45f, 1.0f);
+const ImVec4 kGrey(0.65f, 0.65f, 0.65f, 1.0f);
+
+std::string Ordinal(size_t n) {
+    const char* suffix = "th";
+    if (n % 100 < 11 || n % 100 > 13) {
+        suffix = n % 10 == 1 ? "st" : n % 10 == 2 ? "nd" : n % 10 == 3 ? "rd" : "th";
+    }
+    return std::to_string(n) + suffix;
+}
+
+uint32_t BestLap(const Leaderboard::Entry& e) {
+    uint32_t best = 0;
+    for (uint32_t lap : e.lapsCs) {
+        if (lap > 0 && (best == 0 || lap < best)) {
+            best = lap;
+        }
+    }
+    return best;
+}
+
+// Draws a board. `highlight` (1-based, 0 = none) marks a row; `preview` is
+// shown in that slot as a not-yet-saved entry.
+void DrawBoardTable(const Leaderboard::Board* board, size_t highlight, const Leaderboard::Entry* preview,
+                    bool compact) {
+    std::vector<Leaderboard::Entry> rows;
+    if (board != nullptr) {
+        rows = board->entries;
+    }
+    if (preview != nullptr && highlight > 0 && highlight <= rows.size() + 1) {
+        rows.insert(rows.begin() + (highlight - 1), *preview);
+        if (rows.size() > Leaderboard::kMaxEntries) {
+            rows.resize(Leaderboard::kMaxEntries);
+        }
+    }
+    if (rows.empty()) {
+        ImGui::TextColored(kGrey, "No times yet. Finish a Time Trial on this track to set one.");
+        return;
+    }
+    int columns = compact ? 3 : 6;
+    ImGuiTableFlags flags = ImGuiTableFlags_RowBg | ImGuiTableFlags_BordersInnerH | ImGuiTableFlags_SizingFixedFit;
+    if (!ImGui::BeginTable("##board", columns, flags)) {
+        return;
+    }
+    ImGui::TableSetupColumn("#");
+    ImGui::TableSetupColumn("Name", ImGuiTableColumnFlags_WidthStretch);
+    ImGui::TableSetupColumn("Time");
+    if (!compact) {
+        ImGui::TableSetupColumn("Best lap");
+        ImGui::TableSetupColumn("Driver");
+        ImGui::TableSetupColumn("Date");
+    }
+    ImGui::TableHeadersRow();
+    for (size_t i = 0; i < rows.size(); i++) {
+        const auto& e = rows[i];
+        bool mark = highlight == i + 1;
+        ImGui::TableNextRow();
+        if (mark) {
+            ImGui::TableSetBgColor(ImGuiTableBgTarget_RowBg0, IM_COL32(60, 90, 40, 255));
+        }
+        ImGui::TableNextColumn();
+        if (i == 0) {
+            ImGui::TextColored(kGold, "1");
+        } else {
+            ImGui::Text("%zu", i + 1);
+        }
+        ImGui::TableNextColumn();
+        ImGui::TextUnformatted(mark && preview ? "(you)" : e.name.c_str());
+        ImGui::TableNextColumn();
+        ImGui::TextUnformatted(Leaderboard::FormatTime(e.timeCs).c_str());
+        if (!compact) {
+            ImGui::TableNextColumn();
+            uint32_t lap = BestLap(e);
+            ImGui::TextUnformatted(lap ? Leaderboard::FormatTime(lap).c_str() : "-");
+            ImGui::TableNextColumn();
+            ImGui::TextUnformatted(Leaderboard::kCharacterNames[e.character & 7]);
+            ImGui::TableNextColumn();
+            ImGui::TextUnformatted(e.date.c_str());
+        }
+    }
+    ImGui::EndTable();
+}
+
+// The name as arcade-style letter boxes with the gamepad cursor.
+void DrawNameBoxes(const Leaderboard::PendingRecord& p) {
+    const float box = ImGui::GetFontSize() * 1.6f;
+    const float gap = 3.0f;
+    ImVec2 origin = ImGui::GetCursorScreenPos();
+    ImDrawList* dl = ImGui::GetWindowDrawList();
+    size_t len = std::strlen(p.name);
+    for (int i = 0; i < (int) Leaderboard::kMaxNameLength; i++) {
+        ImVec2 a(origin.x + i * (box + gap), origin.y);
+        ImVec2 b(a.x + box, a.y + box);
+        bool cursor = i == p.cursor;
+        dl->AddRectFilled(a, b, cursor ? IM_COL32(70, 100, 160, 255) : IM_COL32(40, 40, 40, 255), 3.0f);
+        dl->AddRect(a, b, cursor ? IM_COL32(255, 220, 80, 255) : IM_COL32(110, 110, 110, 255), 3.0f, 0,
+                    cursor ? 2.0f : 1.0f);
+        if ((size_t) i < len && p.name[i] != ' ') {
+            char c[2] = { p.name[i], 0 };
+            ImVec2 ts = ImGui::CalcTextSize(c);
+            dl->AddText(ImVec2(a.x + (box - ts.x) / 2, a.y + (box - ts.y) / 2), IM_COL32(255, 255, 255, 255), c);
+        }
+    }
+    ImGui::Dummy(ImVec2(Leaderboard::kMaxNameLength * (box + gap), box));
+}
+
+} // namespace
+
+void ShowLeaderboardEntryWindow(bool show) {
+    if (!sEntryWindow) {
+        sEntryWindow = Ship::Context::GetRawInstance()->GetWindow()->GetGui()->GetGuiWindow(kEntryWindowName);
+    }
+    if (sEntryWindow) {
+        if (show) {
+            sEntryWindow->Show();
+        } else {
+            sEntryWindow->Hide();
+        }
+    }
+}
+
+// ------------------------------------------------------------ name entry
+
+void LeaderboardEntryWindow::UpdateElement() {
+    // Closed with the window's X: treat as Skip.
+    if (!IsVisible() && Leaderboard::Pending().active) {
+        Leaderboard::SkipPending();
+    }
+}
+
+void LeaderboardEntryWindow::DrawElement() {
+    Leaderboard::PendingRecord& p = Leaderboard::Pending();
+    if (!p.active) {
+        ImGui::TextColored(kGrey, "No record to save.");
+        if (ImGui::Button("Close")) {
+            SetVisibility(false);
+        }
+        return;
+    }
+    if (ImGui::IsWindowAppearing()) {
+        ImVec2 size = ImGui::GetWindowSize();
+        ImVec2 center = ImGui::GetMainViewport()->GetCenter();
+        ImGui::SetWindowPos(ImVec2(center.x - size.x / 2, center.y - size.y / 2));
+    }
+
+    ImGui::TextColored(kGold, "NEW RECORD - %s place!", Ordinal(p.rank).c_str());
+    ImGui::Text("%s   %s", p.trackName.c_str(), Leaderboard::FormatTime(p.entry.timeCs).c_str());
+    ImGui::TextColored(kGrey, "Laps: %s  %s  %s", Leaderboard::FormatTime(p.entry.lapsCs[0]).c_str(),
+                       Leaderboard::FormatTime(p.entry.lapsCs[1]).c_str(),
+                       Leaderboard::FormatTime(p.entry.lapsCs[2]).c_str());
+    ImGui::Spacing();
+    ImGui::SeparatorText("Enter your name");
+
+    // The gamepad edited the name: let go of the text box so it shows the change.
+    if (p.padEdited) {
+        p.padEdited = false;
+        if (ImGui::GetActiveID() != 0) {
+            ImGui::ClearActiveID();
+        }
+    }
+    DrawNameBoxes(p);
+    ImGui::Spacing();
+
+    if (ImGui::IsWindowAppearing()) {
+        ImGui::SetKeyboardFocusHere();
+    }
+    ImGui::SetNextItemWidth(220.0f);
+    bool enter = ImGui::InputText("##name", p.name, sizeof(p.name), ImGuiInputTextFlags_EnterReturnsTrue);
+    ImGui::SameLine();
+    if (ImGui::Button("Save") || enter) {
+        Leaderboard::SubmitPending();
+        return;
+    }
+    ImGui::SameLine();
+    if (ImGui::Button("Skip")) {
+        Leaderboard::SkipPending();
+        return;
+    }
+    // Keep the arcade cursor inside the name typed with the keyboard.
+    p.cursor = std::min<int>(p.cursor, (int) Leaderboard::kMaxNameLength - 1);
+
+    ImGui::TextColored(kGrey, "Keyboard: type, then Enter.");
+    ImGui::TextColored(kGrey, "Gamepad: Up/Down letter, Left/Right or A/B move, Start save, Z skip.");
+    ImGui::Spacing();
+    DrawBoardTable(Leaderboard::GetStore().Get(p.track), p.rank, &p.entry, true);
+}
+
+// ------------------------------------------------------------ browse
+
+void LeaderboardWindow::DrawElement() {
+    static std::string sSelected;
+    Leaderboard::Store& store = Leaderboard::GetStore();
+
+    // Every installed track, plus any track that has times but isn't installed now.
+    std::vector<std::pair<std::string, std::string>> tracks; // resource, display
+    for (const TrackInfo* info : gTrackRegistry.GetAllInfo()) {
+        tracks.emplace_back(info->ResourceName, info->Name.empty() ? info->ResourceName : info->Name);
+    }
+    for (const std::string& t : store.Tracks()) {
+        bool known = std::any_of(tracks.begin(), tracks.end(), [&](const auto& x) { return x.first == t; });
+        if (!known) {
+            tracks.emplace_back(t, Leaderboard::TrackDisplayName(t) + " (not installed)");
+        }
+    }
+    if (sSelected.empty()) {
+        std::string current = Leaderboard::CurrentTrack();
+        sSelected = !current.empty() ? current : (tracks.empty() ? std::string() : tracks[0].first);
+    }
+
+    std::string preview = Leaderboard::TrackDisplayName(sSelected);
+    if (ImGui::BeginCombo("Track", preview.c_str())) {
+        for (const auto& [res, name] : tracks) {
+            const Leaderboard::Board* b = store.Get(res);
+            std::string label = name + (b ? "  (" + std::to_string(b->entries.size()) + ")" : "");
+            if (ImGui::Selectable(label.c_str(), res == sSelected)) {
+                sSelected = res;
+            }
+        }
+        ImGui::EndCombo();
+    }
+    ImGui::Spacing();
+    DrawBoardTable(store.Get(sSelected), 0, nullptr, false);
+    ImGui::Spacing();
+
+    if (store.Get(sSelected) != nullptr) {
+        if (ImGui::Button("Clear this track's times")) {
+            ImGui::OpenPopup("Clear times?");
+        }
+        if (ImGui::BeginPopupModal("Clear times?", nullptr, ImGuiWindowFlags_AlwaysAutoResize)) {
+            ImGui::Text("Delete every time on %s?", preview.c_str());
+            if (ImGui::Button("Delete")) {
+                store.Clear(sSelected);
+                Leaderboard::SaveStore();
+                ImGui::CloseCurrentPopup();
+            }
+            ImGui::SameLine();
+            if (ImGui::Button("Cancel")) {
+                ImGui::CloseCurrentPopup();
+            }
+            ImGui::EndPopup();
+        }
+    }
+    ImGui::Separator();
+    bool enabled = !CVarGetInteger("gLeaderboard.Disabled", 0);
+    if (ImGui::Checkbox("Ask for my name after a top-10 Time Trial", &enabled)) {
+        CVarSetInteger("gLeaderboard.Disabled", enabled ? 0 : 1);
+        CVarSave();
+    }
+    ImGui::TextColored(kGrey, "Times are saved on this PC in leaderboards.json, next to the game.");
+}
+
+} // namespace GameUI
