+#pragma once
+
+// C++ side of the time-trial leaderboards, shared with the UI.
+
+#include <string>
+
+#include "Leaderboard.h"
+
+namespace Leaderboard {
+
+// The leaderboards on disk (loaded on first use).
+Store& GetStore();
+// Writes the store to disk; logs on failure.
+void SaveStore();
+// Display name for a track resource name, from the installed tracks.
+std::string TrackDisplayName(const std::string& track);
+// Resource name of the track being raced, or "" outside a race.
+std::string CurrentTrack();
+
+extern const char* const kCharacterNames[8];
+
+// A record waiting for its name.
+struct PendingRecord {
+    bool active = false;
+    std::string track;
+    std::string trackName;
+    Entry entry;
+    size_t rank = 0;
+    char name[kMaxNameLength + 1] = {};
+    int cursor = 0;          // arcade-style cursor (gamepad entry)
+    bool padEdited = false;  // the gamepad changed the name this frame
+};
+
+PendingRecord& Pending();
+// Saves the pending record under its current name and closes the entry.
+void SubmitPending();
+// Closes the entry without saving.
+void SkipPending();
+
+} // namespace Leaderboard
