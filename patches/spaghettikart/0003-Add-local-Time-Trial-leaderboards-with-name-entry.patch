diff --git a/src/port/leaderboard/Leaderboard.cpp b/src/port/leaderboard/Leaderboard.cpp
new file mode 100644
index 0000000..c00b60d
--- /dev/null
+++ b/src/port/leaderboard/Leaderboard.cpp
@@ -0,0 +1,186 @@
+#include "Leaderboard.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <nlohmann/json.hpp>
+
+namespace Leaderboard {
+
+using json = nlohmann::json;
+
+namespace {
+constexpr int kFileVersion = 1;
+}
+
+bool Store::Load(const std::string& path) {
+    mBoards.clear();
+    std::ifstream in(path);
+    if (!in.is_open()) {
+        return false;
+    }
+    json j = json::parse(in, nullptr, false);
+    if (j.is_discarded() || !j.is_object() || !j.contains("tracks") || !j["tracks"].is_object()) {
+        return false;
+    }
+    for (auto& [track, b] : j["tracks"].items()) {
+        if (!b.is_object()) {
+            continue;
+        }
+        Board board;
+        board.trackName = b.value("name", track);
+        if (b.contains("entries") && b["entries"].is_array()) {
+            for (auto& e : b["entries"]) {
+                if (!e.is_object()) {
+                    continue;
+                }
+                Entry entry;
+                entry.name = CleanName(e.value("name", std::string()));
+                entry.timeCs = e.value("time_cs", 0u);
+                entry.character = std::clamp(e.value("character", 0), 0, 7);
+                entry.date = e.value("date", std::string());
+                if (e.contains("laps_cs") && e["laps_cs"].is_array()) {
+                    for (size_t i = 0; i < 3 && i < e["laps_cs"].size(); i++) {
+                        if (e["laps_cs"][i].is_number_unsigned()) {
+                            entry.lapsCs[i] = e["laps_cs"][i].get<uint32_t>();
+                        }
+                    }
+                }
+                if (entry.timeCs > 0) {
+                    board.entries.push_back(entry);
+                }
+            }
+        }
+        std::stable_sort(board.entries.begin(), board.entries.end(),
+                         [](const Entry& a, const Entry& b) { return a.timeCs < b.timeCs; });
+        if (board.entries.size() > kMaxEntries) {
+            board.entries.resize(kMaxEntries);
+        }
+        if (!board.entries.empty()) {
+            mBoards[track] = std::move(board);
+        }
+    }
+    return true;
+}
+
+bool Store::Save(const std::string& path) const {
+    json j;
+    j["version"] = kFileVersion;
+    j["tracks"] = json::object();
+    for (const auto& [track, board] : mBoards) {
+        json b;
+        b["name"] = board.trackName;
+        b["entries"] = json::array();
+        for (const auto& e : board.entries) {
+            b["entries"].push_back({ { "name", e.name },
+                                     { "time_cs", e.timeCs },
+                                     { "laps_cs", { e.lapsCs[0], e.lapsCs[1], e.lapsCs[2] } },
+                                     { "character", e.character },
+                                     { "date", e.date } });
+        }
+        j["tracks"][track] = b;
+    }
+
+    std::string tmp = path + ".tmp";
+    {
+        std::ofstream out(tmp, std::ios::trunc);
+        if (!out.is_open()) {
+            return false;
+        }
+        out << j.dump(2);
+        if (!out.good()) {
+            return false;
+        }
+    }
+    std::error_code ec;
+    std::filesystem::rename(tmp, path, ec);
+    if (ec) {
+        // Some filesystems refuse to rename over an existing file.
+        std::filesystem::remove(path, ec);
+        std::filesystem::rename(tmp, path, ec);
+    }
+    return !ec;
+}
+
+size_t Store::RankFor(const std::string& track, uint32_t timeCs) const {
+    if (timeCs == 0) {
+        return 0;
+    }
+    auto it = mBoards.find(track);
+    if (it == mBoards.end()) {
+        return 1;
+    }
+    const auto& entries = it->second.entries;
+    // Ties go after existing equal times.
+    size_t pos = std::upper_bound(entries.begin(), entries.end(), timeCs,
+                                  [](uint32_t t, const Entry& e) { return t < e.timeCs; }) -
+                 entries.begin();
+    return pos < kMaxEntries ? pos + 1 : 0;
+}
+
+size_t Store::Insert(const std::string& track, const std::string& trackName, Entry entry) {
+    size_t rank = RankFor(track, entry.timeCs);
+    if (rank == 0) {
+        return 0;
+    }
+    entry.name = CleanName(entry.name);
+    entry.character = std::clamp(entry.character, 0, 7);
+    Board& board = mBoards[track];
+    if (!trackName.empty()) {
+        board.trackName = trackName;
+    } else if (board.trackName.empty()) {
+        board.trackName = track;
+    }
+    board.entries.insert(board.entries.begin() + (rank - 1), entry);
+    if (board.entries.size() > kMaxEntries) {
+        board.entries.resize(kMaxEntries);
+    }
+    return rank;
+}
+
+const Board* Store::Get(const std::string& track) const {
+    auto it = mBoards.find(track);
+    return it == mBoards.end() ? nullptr : &it->second;
+}
+
+std::vector<std::string> Store::Tracks() const {
+    std::vector<std::string> out;
+    for (const auto& [track, board] : mBoards) {
+        if (!board.entries.empty()) {
+            out.push_back(track);
+        }
+    }
+    return out;
+}
+
+void Store::Clear(const std::string& track) {
+    mBoards.erase(track);
+}
+
+std::string FormatTime(uint32_t timeCs) {
+    uint32_t minutes = timeCs / 6000;
+    uint32_t seconds = (timeCs / 100) % 60;
+    uint32_t hundredths = timeCs % 100;
+    char buf[32];
+    snprintf(buf, sizeof(buf), "%u'%02u\"%02u", minutes, seconds, hundredths);
+    return buf;
+}
+
+std::string CleanName(const std::string& name) {
+    std::string out;
+    for (char c : name) {
+        if (c >= 32 && c < 127) {
+            out.push_back(c);
+        }
+    }
+    size_t first = out.find_first_not_of(' ');
+    size_t last = out.find_last_not_of(' ');
+    out = first == std::string::npos ? std::string() : out.substr(first, last - first + 1);
+    if (out.size() > kMaxNameLength) {
+        out.resize(kMaxNameLength);
+    }
+    return out.empty() ? "PLAYER" : out;
+}
+
+} // namespace Leaderboard
diff --git a/src/port/leaderboard/Leaderboard.h b/src/port/leaderboard/Leaderboard.h
new file mode 100644
index 0000000..9663085
--- /dev/null
+++ b/src/port/leaderboard/Leaderboard.h
@@ -0,0 +1,54 @@
+#pragma once
+
+// Local time-trial leaderboards: the best times per track, kept in a JSON file
+// next to the game. No game code here, so it can be unit tested on its own.
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace Leaderboard {
+
+constexpr size_t kMaxEntries = 10;  // per track
+constexpr size_t kMaxNameLength = 12;
+
+struct Entry {
+    std::string name;
+    uint32_t timeCs = 0;          // total race time, hundredths of a second
+    uint32_t lapsCs[3] = { 0, 0, 0 };
+    int character = 0;            // 0..7 (Mario..Bowser)
+    std::string date;             // YYYY-MM-DD
+};
+
+struct Board {
+    std::string trackName;        // display name, for tracks no longer installed
+    std::vector<Entry> entries;   // fastest first
+};
+
+class Store {
+  public:
+    // Loads `path` if it exists. A missing or unreadable file gives an empty store.
+    bool Load(const std::string& path);
+    // Writes atomically (temp file + rename). Returns false on failure.
+    bool Save(const std::string& path) const;
+
+    // 1-based rank `timeCs` would get on `track`, or 0 if it wouldn't make the board.
+    size_t RankFor(const std::string& track, uint32_t timeCs) const;
+    // Adds an entry (if it qualifies) and returns its 1-based rank, or 0.
+    size_t Insert(const std::string& track, const std::string& trackName, Entry entry);
+
+    const Board* Get(const std::string& track) const;
+    std::vector<std::string> Tracks() const; // tracks with at least one entry
+    void Clear(const std::string& track);
+
+  private:
+    std::map<std::string, Board> mBoards; // key: track resource name, e.g. "mk:mario_raceway"
+};
+
+// "1'23\"45" style, as the game shows times.
+std::string FormatTime(uint32_t timeCs);
+// Trims, drops control characters, limits to kMaxNameLength. Empty -> "PLAYER".
+std::string CleanName(const std::string& name);
+
+} // namespace Leaderboard
diff --git a/src/port/leaderboard/LeaderboardGame.cpp b/src/port/leaderboard/LeaderboardGame.cpp
new file mode 100644
index 0000000..02bd3db
--- /dev/null
+++ b/src/port/leaderboard/LeaderboardGame.cpp
@@ -0,0 +1,283 @@
+#include "LeaderboardGame.h"
+#include "leaderboard_game.h"
+
+#include <cstring>
+#include <ctime>
+#include <memory>
+
+#include <libultraship/libultraship.h>
+#include "ship/Context.h"
+#include "port/Game.h"
+#include "engine/World.h"
+#include "port/netplay/Netplay.h"
+
+extern "C" {
+#include "main.h"
+#include "code_80057C60.h"
+#include "code_800029B0.h"
+#include <defines.h>
+}
+
+namespace GameUI {
+void ShowLeaderboardEntryWindow(bool show);
+}
+
+namespace Leaderboard {
+
+const char* const kCharacterNames[8] = { "Mario", "Luigi", "Yoshi", "Toad", "Donkey Kong", "Wario", "Peach", "Bowser" };
+
+namespace {
+
+std::unique_ptr<Store> sStore;
+PendingRecord sPending;
+bool sArmed = false;      // a time trial finished; waiting for the final time
+bool sWaitRelease = false; // entry closed; keep the pad from the game until released
+
+// Characters the gamepad cycles through.
+const char kPadCharset[] = " ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-.!";
+
+struct PadState {
+    uint16_t buttons = 0;
+    int8_t dirY = 0; // -1, 0, 1
+    int8_t dirX = 0;
+    int repeatTimer = 0;
+};
+PadState sPad;
+
+std::string FilePath() {
+    return Ship::Context::GetPathRelativeToAppDirectory("leaderboards.json");
+}
+
+std::string Today() {
+    std::time_t now = std::time(nullptr);
+    std::tm tm{};
+#ifdef _WIN32
+    localtime_s(&tm, &now);
+#else
+    localtime_r(&now, &tm);
+#endif
+    char buf[16];
+    std::strftime(buf, sizeof(buf), "%Y-%m-%d", &tm);
+    return buf;
+}
+
+int CharsetIndex(char c) {
+    const char* p = std::strchr(kPadCharset, c >= 'a' && c <= 'z' ? c - 32 : c);
+    return (p != nullptr && c != '\0') ? (int) (p - kPadCharset) : 0;
+}
+
+void SetNameChar(int pos, char c) {
+    size_t len = std::strlen(sPending.name);
+    while ((int) len < pos) { // pad with spaces up to the cursor
+        sPending.name[len++] = ' ';
+    }
+    sPending.name[pos] = c;
+    if ((size_t) pos >= len) {
+        sPending.name[pos + 1] = '\0';
+    }
+    // Drop trailing spaces so the name stays tidy.
+    len = std::strlen(sPending.name);
+    while (len > 0 && sPending.name[len - 1] == ' ' && (int) len - 1 != pos) {
+        sPending.name[--len] = '\0';
+    }
+}
+
+void StartEntry(const std::string& track, const Entry& entry, size_t rank) {
+    sPending = PendingRecord{};
+    sPending.active = true;
+    sPending.track = track;
+    sPending.trackName = TrackDisplayName(track);
+    sPending.entry = entry;
+    sPending.rank = rank;
+    std::string last = CVarGetString("gLeaderboard.LastName", "");
+    std::strncpy(sPending.name, last.c_str(), kMaxNameLength);
+    sPending.name[kMaxNameLength] = '\0';
+    sPending.cursor = 0;
+    sPad = PadState{};
+    GameUI::ShowLeaderboardEntryWindow(true);
+}
+
+void CloseEntry() {
+    sPending.active = false;
+    sWaitRelease = true;
+    GameUI::ShowLeaderboardEntryWindow(false);
+}
+
+} // namespace
+
+Store& GetStore() {
+    if (!sStore) {
+        sStore = std::make_unique<Store>();
+        sStore->Load(FilePath());
+    }
+    return *sStore;
+}
+
+void SaveStore() {
+    if (!GetStore().Save(FilePath())) {
+        SPDLOG_ERROR("[Leaderboard] Could not write {}", FilePath());
+    }
+}
+
+std::string TrackDisplayName(const std::string& track) {
+    const TrackInfo* info = gTrackRegistry.GetInfo(track);
+    if (info != nullptr && !info->Name.empty()) {
+        return info->Name;
+    }
+    const Board* board = GetStore().Get(track);
+    return (board != nullptr && !board->trackName.empty()) ? board->trackName : track;
+}
+
+std::string CurrentTrack() {
+    Track* track = GetWorld() ? GetWorld()->GetTrack() : nullptr;
+    return track != nullptr ? track->ResourceName : std::string();
+}
+
+PendingRecord& Pending() {
+    return sPending;
+}
+
+void SubmitPending() {
+    if (!sPending.active) {
+        return;
+    }
+    Entry entry = sPending.entry;
+    entry.name = CleanName(sPending.name);
+    sPending.rank = GetStore().Insert(sPending.track, sPending.trackName, entry);
+    SaveStore();
+    CVarSetString("gLeaderboard.LastName", entry.name.c_str());
+    CVarSave();
+    CloseEntry();
+}
+
+void SkipPending() {
+    if (sPending.active) {
+        CloseEntry();
+    }
+}
+
+} // namespace Leaderboard
+
+using namespace Leaderboard;
+
+extern "C" void leaderboard_on_time_trial_finished(void) {
+    if (Netplay_IsInGame()) {
+        return; // name entry would hold up the other PCs
+    }
+    sArmed = true;
+}
+
+extern "C" void leaderboard_tick(void) {
+    if (gGamestate != RACING || gModeSelection != TIME_TRIALS) {
+        sArmed = false;
+        if (sPending.active) {
+            SkipPending(); // left the race (e.g. reset) with the entry open
+        }
+        return;
+    }
+    if (!sArmed) {
+        return;
+    }
+    // The finish time and lap splits are filled in once the HUD sees the last lap.
+    const hud_player& hud = playerHUD[PLAYER_ONE];
+    if (!hud.raceCompleteBool || hud.someTimer == 0) {
+        return;
+    }
+    sArmed = false;
+    if (CVarGetInteger("gLeaderboard.Disabled", 0)) {
+        return;
+    }
+    std::string track = CurrentTrack();
+    if (track.empty()) {
+        return;
+    }
+    Entry entry;
+    entry.timeCs = hud.someTimer;
+    for (int i = 0; i < 3; i++) {
+        entry.lapsCs[i] = hud.lapDurations[i];
+    }
+    entry.character = gPlayers[0].characterId & 7;
+    entry.date = Today();
+    size_t rank = GetStore().RankFor(track, entry.timeCs);
+    if (rank > 0) {
+        StartEntry(track, entry, rank);
+    }
+}
+
+extern "C" void leaderboard_filter_pads(OSContPad* pads) {
+    if (!sPending.active && !sWaitRelease) {
+        return;
+    }
+    const OSContPad pad = pads[0];
+    for (int i = 0; i < MAXCONTROLLERS; i++) {
+        pads[i].button = 0;
+        pads[i].stick_x = pads[i].stick_y = 0;
+        pads[i].right_stick_x = pads[i].right_stick_y = 0;
+    }
+
+    uint16_t held = (uint16_t) pad.button;
+    int8_t dirY = (held & U_JPAD) || pad.stick_y > 50 ? 1 : ((held & D_JPAD) || pad.stick_y < -50 ? -1 : 0);
+    int8_t dirX = (held & R_JPAD) || pad.stick_x > 50 ? 1 : ((held & L_JPAD) || pad.stick_x < -50 ? -1 : 0);
+
+    if (sWaitRelease) {
+        // Don't let the button that closed the entry reach the results menu.
+        if (held == 0 && dirX == 0 && dirY == 0) {
+            sWaitRelease = false;
+        }
+        sPad.buttons = held;
+        return;
+    }
+
+    uint16_t pressed = held & ~sPad.buttons;
+    bool newDir = dirY != sPad.dirY || dirX != sPad.dirX;
+    if (newDir) {
+        sPad.repeatTimer = 18; // first repeat after ~0.3 s
+    } else if ((dirX != 0 || dirY != 0) && --sPad.repeatTimer <= 0) {
+        sPad.repeatTimer = 4;
+        newDir = true;
+    }
+    sPad.buttons = held;
+    sPad.dirX = dirX;
+    sPad.dirY = dirY;
+
+    PendingRecord& p = sPending;
+    const int maxPos = (int) kMaxNameLength - 1;
+    bool edited = false;
+
+    if (newDir && dirY != 0) {
+        int len = (int) std::strlen(p.name);
+        char cur = p.cursor < len ? p.name[p.cursor] : ' ';
+        int n = (int) sizeof(kPadCharset) - 1;
+        int idx = (CharsetIndex(cur) + (dirY > 0 ? 1 : n - 1)) % n;
+        SetNameChar(p.cursor, kPadCharset[idx]);
+        edited = true;
+    }
+    if ((newDir && dirX > 0) || (pressed & A_BUTTON)) {
+        if ((pressed & A_BUTTON) && p.cursor >= maxPos) {
+            SubmitPending();
+            return;
+        }
+        if (p.cursor < maxPos) {
+            if (p.cursor >= (int) std::strlen(p.name)) {
+                SetNameChar(p.cursor, ' ');
+            }
+            p.cursor++;
+        }
+        edited = true;
+    }
+    if ((newDir && dirX < 0) || (pressed & B_BUTTON)) {
+        if (p.cursor > 0) {
+            p.cursor--;
+        }
+        edited = true;
+    }
+    if (pressed & START_BUTTON) {
+        SubmitPending();
+        return;
+    }
+    if (pressed & Z_TRIG) {
+        SkipPending();
+        return;
+    }
+    p.padEdited = p.padEdited || edited;
+}
