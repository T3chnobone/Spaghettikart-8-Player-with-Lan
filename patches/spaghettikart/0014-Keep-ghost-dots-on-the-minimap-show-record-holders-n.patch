+// The game's own record lists (results screen and DATA screen) show the
+// driver; show who set the time instead when a leaderboard entry matches.
+extern "C" const char* leaderboard_record_name(u32 timeCs, s32 character, bool lap, bool dataScreen) {
+    static char sName[kMaxNameLength + 1];
+    std::string track = dataScreen ? kDataTracks[std::clamp<int>(gTimeTrialDataCourseIndex, 0, 15)] : CurrentTrack();
+    const Board* board = track.empty() ? nullptr : GetStore().Get(track);
+    if (board == nullptr || timeCs == 0) {
+        return nullptr;
+    }
+    for (const Entry& e : board->entries) {
+        if ((e.character & 7) != (character & 7)) {
+            continue;
+        }
+        bool match = !lap ? e.timeCs == timeCs
+                          : (e.lapsCs[0] == timeCs || e.lapsCs[1] == timeCs || e.lapsCs[2] == timeCs);
+        if (match) {
+            std::snprintf(sName, sizeof(sName), "%s", GameDraw::Printable(e.name).c_str());
+            return sName;
+        }
+    }
+    return nullptr;
+}
+
 using namespace GameDraw;
 
 // Time Trial record: name entry, drawn over the race.
